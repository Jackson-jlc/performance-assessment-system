/* ============================ 一井一策定额补充 ============================ */
const OWP_FIELDS=[['mifei','米费',6],['mat50','材料50型',2],['mat70','材料70型',2],['energy','能耗',2],
  ['lube','润滑油',4],['repair','项修',4],['prodwater','生产水',4],['sewage','生活污水',4],
  ['dayfoot','日进尺',1],['gm_avg','毛益率',4]];

function owpGroups(){
  const g={};
  WELLS.forEach(r=>{
    if(!r.w.oneWellOnePolicy) return;
    const k=r.w.wellType+'|'+r.w.block+'|'+r.w.phase;
    (g[k]=g[k]||{wellType:r.w.wellType,block:r.w.block,phase:r.w.phase,wells:[]}).wells.push(r);
  });
  return Object.values(g).map(grp=>{
    const cur=Q.blocks.find(b=>b.wellType===grp.wellType&&b.block===grp.block&&b.phase===Number(grp.phase));
    grp.cur=cur||null;
    grp.median={};
    OWP_FIELDS.forEach(([fk])=>{
      const vals=grp.wells.map(r=>+((r.w.custom||{})[fk])||0).filter(v=>v>0);
      if(vals.length) grp.median[fk]=median(vals);
    });
    grp.ready = grp.wells.length>=2;
    return grp;
  }).sort((a,b)=> b.wells.length-a.wells.length);
}

function renderOneWellOnePolicy(){
  const T=$('#owpTbl'); if(!T) return;
  const groups=owpGroups();
  if(!groups.length){
    T.innerHTML='<tbody><tr><td class="dim" style="font-family:var(--sans)">暂无一井一策样本井。在「单井考核」勾选「一井一策」并录入自定义定额、提交入库后，样本将汇总到此处。</td></tr></tbody>';
    return;
  }
  T.innerHTML='<thead><tr><th>井型 · 区块 · 开次</th><th>样本井</th>'+
    OWP_FIELDS.map(([,l])=>'<th>'+l+'</th>').join('')+'<th>定额库现状</th><th>操作</th></tr></thead><tbody>'+
    groups.map((grp,gi)=>{
      const status = !grp.cur ? '<span class="pill bad">未入库</span>'
        : (OWP_FIELDS.every(([fk])=>grp.cur[fk]!=null) ? '<span class="pill ai">已完整</span>' : '<span class="pill man">部分字段缺失</span>');
      return '<tr><td>'+grp.wellType+' · '+grp.block+' · '+grp.phase+'开</td>'+
        '<td style="text-align:left">'+grp.wells.map(r=>r.w.wellNo||'未命名').join('、')+' <span class="sub">('+grp.wells.length+' 口)</span></td>'+
        OWP_FIELDS.map(([fk,,dec])=>{
          const v=grp.median[fk];
          if(v==null) return '<td class="dim">—</td>';
          const already = grp.cur && grp.cur[fk]!=null;
          return '<td'+(already?' class="dim"':'')+'>'+(fk==='gm_avg'?pct(v,dec):v.toFixed(dec))+(already?' <span class="sub">已有</span>':'')+'</td>';
        }).join('')+
        '<td style="text-align:left">'+status+'</td>'+
        '<td><button class="btn ghost mini" data-owp="'+gi+'" '+(grp.ready?'':'disabled')+'>'+
          (grp.ready?'补充入库':'样本不足(＜2口)')+'</button></td></tr>';
    }).join('')+'</tbody>';

  T.querySelectorAll('[data-owp]').forEach(btn=>{
    btn.onclick=()=>{
      const grp=groups[+btn.dataset.owp];
      let cur=Q.blocks.find(b=>b.wellType===grp.wellType&&b.block===grp.block&&b.phase===Number(grp.phase));
      if(!cur){ cur={wellType:grp.wellType,block:grp.block,phase:Number(grp.phase)}; Q.blocks.push(cur); }
      let filled=0;
      OWP_FIELDS.forEach(([fk])=>{
        if(fk==='gm_avg') return;
        if(cur[fk]==null && grp.median[fk]!=null){ cur[fk]=Math.round(grp.median[fk]*1e6)/1e6; filled++; }
      });
      if(cur.gm_avg==null && grp.median.gm_avg!=null){
        cur.gm_avg=Math.round(grp.median.gm_avg*1e6)/1e6;
        cur.gm_110=Math.round(cur.gm_avg*1.1*1e6)/1e6;
        cur.gm_120=Math.round(cur.gm_avg*1.2*1e6)/1e6;
        filled++;
      }
      const msg=filled?('已将 '+grp.wellType+' · '+grp.block+' · '+grp.phase+'开 的 '+filled+' 个字段补入定额库（中位数，样本 '+grp.wells.length+' 口）。'):
        '该组合定额库字段均已存在，未作覆盖。';
      const om=$('#owpMsg'); if(om){ om.textContent=msg; om.className='sub '+(filled?'pos':''); setTimeout(()=>{ if(om.textContent===msg) om.textContent=''; },6000); }
      if(filled) saveQuota();
      renderQuota(); renderResults();
    };
  });
}

/* ============================ 滚动定额 ============================ */
const MAT_RATIO = 1.133333;
/* 月份轴：最近 24 个自然月 ∪ 样本井实际完成月份（已审核井入库月份），升序 */
const MONTHS=(()=>{
  const set=new Set(), now=new Date();
  for(let i=23;i>=0;i--){ const d=new Date(now.getFullYear(), now.getMonth()-i, 1);
    set.add(d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')); }
  (WELLS||[]).forEach(r=>{ if(r.status==='approved' && r.at){ const d=new Date(r.at);
    set.add(d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')); } });
  return [...set].sort();
})();
const median=a=>{const s=[...a].sort((x,y)=>x-y),n=s.length;return n?(n%2?s[(n-1)/2]:(s[n/2-1]+s[n/2])/2):null};
const clamp=(v,lo,hi)=>Math.min(hi,Math.max(lo,v));

const CFG={win:24,minN:3,alpha:0.4,cap:0.10,adv:0.99,beta:0.5};
const RULE={
  acc  :{on:true,v:0.05, l:'有责事故复杂时效占比 ＞',    u:'%',s:1,   why:'事故井的成本与周期不代表正常施工水平'},
  wait :{on:true,v:0.20, l:'甲方原因等停时效占比 ＞',    u:'%',s:1,   why:'长时间等停会拉高单位进尺能耗与人工'},
  foot :{on:true,v:800,  l:'单井考核进尺 ＜',            u:'m',s:100, why:'样本过小时单位进尺指标方差极大'},
  side :{on:true,       l:'侧钻报废井',                              why:'报废段成本无法与正常进尺对应'},
  special:{on:true,     l:'特殊井（一井一预算）',                      why:'地热井、分支水平井一井一预算；空气储能项目执行2025年办法单井预算，均不套用区块定额'},
  mad  :{on:true,v:3.5,  l:'稳健离群 |x−中位数|/MAD ＞', u:'',s:0.5,  why:'中位数+MAD 比均值±3σ 更耐小样本污染；组内样本不足 6 口时不启用'}
};
const RULE_ORDER=['acc','wait','foot','side','special','mad'];

/* 样本井池：完成井考核库中已审核（approved）井自动导入，作为滚动定额入库样本，
   参与定额迭代更新。成本字段按实际发生额/进尺折算单位值（元/米），无实际发生的
   字段记 null 不参与测算；毛益率、事故、等停、侧钻、一井一策按完成井参数映射。 */
let WELL_POOL=[];
function buildWellPool(){
  WELL_POOL=(WELLS||[]).filter(r=>r.status==='approved').map(r=>{
    const w=r&&r.w; if(!w || !(+w.footage>0) || !(+w.cycleDays>0)) return null;
    const footage=+w.footage, days=+w.cycleDays;
    const R=rigOf(w.team)||{rigType:'',kType:1,kRepair:1};
    const energy=(+w.elecKwh||0)*PRICE.elec + (+w.dieselTon||0)*E2O_DIESEL_PRICE;
    return {
      id:r.id,
      month:r.at?String(stamp(r.at)).slice(0,7):'',
      team:w.team, big70:/70/.test(R.rigType),
      wellType:w.wellType, block:w.block, phase:+w.phase||0,
      well:String(w.wellNo||'未命名'),
      days, dayfoot:Math.round(footage/days*100)/100, footage,
      mat:(+w.matAct>0)?Math.round((+w.matAct)/footage*1e6)/1e6:null,
      energy:(energy>0)?Math.round(energy/footage*1e6)/1e6:null,
      lube:(+w.oilTon>0)?Math.round((+w.oilTon)*PRICE.oil/footage*1e6)/1e6:null,
      repair:(+w.repairAct>0)?Math.round((+w.repairAct)/footage*1e6)/1e6:null,
      prodwater:(+w.prodWaterAct>0)?Math.round((+w.prodWaterAct)/footage*1e6)/1e6:null,
      sewage:(+w.sewageM3>0)?Math.round((+w.sewageM3)*PRICE.sewage/footage*1e6)/1e6:null,
      gm:(+w.grossMargin>0)?(+w.grossMargin)/100:null,
      accPct:(w.hasAccident)?0.06:0, responsible:!!w.hasAccident,
      waitPct:(+w.waitDays>0)?(+w.waitDays)/days:0,
      sidetrack:(+w.sidetrack>0), special:w.oneWellOnePolicy?'一井一策':null
    };
  }).filter(Boolean);
  WELL_POOL.sort((a,b)=>a.month<b.month?1:-1);
}

const GK=w=>w.wellType+'|'+w.block+'|'+w.phase;
function norm(w,mk){
  if(mk==='mat')    return w.mat/(w.big70?MAT_RATIO:1);
  if(mk==='lube')   return w.lube==null?null:w.lube/rigOf(w.team).kType;
  if(mk==='repair') return w.repair==null?null:w.repair/rigOf(w.team).kRepair;
  return w[mk];
}
function hardReasons(w){
  const r=[];
  if(RULE.acc.on && w.responsible && w.accPct>RULE.acc.v) r.push('有责事故复杂 '+pct(w.accPct,1));
  if(RULE.wait.on && w.waitPct>RULE.wait.v) r.push('等停时效 '+pct(w.waitPct,1));
  if(RULE.side.on && w.sidetrack) r.push('侧钻报废井');
  if(RULE.special.on && w.special) r.push(w.special+'·一井一预算');
  if(RULE.foot.on && w.footage<RULE.foot.v) r.push('样本进尺仅 '+fmt(w.footage)+' m');
  return r;
}
const ROLL_METRICS=['mat','energy','lube','repair','prodwater','sewage','dayfoot'];
const FIELD_OF={mat:'mat50',energy:'energy',lube:'lube',repair:'repair',prodwater:'prodwater',sewage:'sewage',dayfoot:'dayfoot',mifei:'mifei',gm_avg:'gm_avg'};
const M_LABEL={mifei:'米费',mat:'一般材料',energy:'能耗',lube:'润滑油',repair:'项修',prodwater:'生产水',sewage:'生活污水',dayfoot:'日进尺',gm_avg:'毛益率'};

let ROLL_MONTH=MONTHS[MONTHS.length-1], PROPS=[], WINWELLS=[], APPLIED=false, PREV_OPS=null, PREV_VERSION=null;

function rollup(){
  const end=MONTHS.indexOf(ROLL_MONTH);
  const win=MONTHS.slice(Math.max(0,end-CFG.win+1),end+1);
  const inWin=WELL_POOL.filter(w=>win.indexOf(w.month)>=0);
  inWin.forEach(w=>{ w._hard=hardReasons(w); w._mad=[]; });
  const groups={};
  inWin.forEach(w=>{ (groups[GK(w)]=groups[GK(w)]||[]).push(w); });

  Object.values(groups).forEach(g=>{
    const pass=g.filter(w=>!w._hard.length);
    if(!RULE.mad.on || pass.length<6) return;
    ROLL_METRICS.forEach(mk=>{
      const vals=pass.map(w=>norm(w,mk)).filter(v=>v!=null);
      if(vals.length<6) return;
      const m=median(vals), mad=median(vals.map(v=>Math.abs(v-m)));
      if(!mad) return;
      pass.forEach(w=>{ const v=norm(w,mk);
        if(v!=null && Math.abs(v-m)/(1.4826*mad)>RULE.mad.v) w._mad.push(M_LABEL[mk]); });
    });
  });
  inWin.forEach(w=>{ w._ok = !w._hard.length && !w._mad.length; });
  WINWELLS=inWin;

  PROPS=Object.keys(groups).map(k=>{
    const g=groups[k], ok=g.filter(w=>w._ok), a=k.split('|');
    const cur=Q.blocks.find(x=>x.wellType===a[0]&&x.block===a[1]&&x.phase===+a[2])||{};
    const rec={key:k,wellType:a[0],block:a[1],phase:+a[2],n:ok.length,ex:g.length-ok.length,items:{},status:'可更新',capped:0};
    if(ok.length<CFG.minN){ rec.status='样本不足'; return rec; }
    const put=(mk,raw,oldV)=>{
      if(oldV==null||!isFinite(raw)) return;
      const lo=oldV-Math.abs(oldV)*CFG.cap, hi=oldV+Math.abs(oldV)*CFG.cap;
      let neo=CFG.alpha*raw+(1-CFG.alpha)*oldV;
      const cap=neo<lo||neo>hi; if(cap) rec.capped++;
      neo=clamp(neo,lo,hi);
      rec.items[mk]={old:oldV,neo,d:oldV?neo/oldV-1:null,cap};
    };
    ['mat','energy','lube','repair','prodwater','sewage'].forEach(mk=>{
      const vals=ok.map(w=>norm(w,mk)).filter(v=>v!=null);
      if(vals.length<CFG.minN) return;
      put(mk, median(vals)*CFG.adv, cur[FIELD_OF[mk]]);
    });
    const dfRaw=median(ok.map(w=>w.dayfoot));
    put('dayfoot', dfRaw, cur.dayfoot);
    if(cur.mifei && rec.items.dayfoot){
      const r=cur.dayfoot/rec.items.dayfoot.neo;
      put('mifei', cur.mifei*Math.pow(r,CFG.beta), cur.mifei);
    }
    const gmVals=ok.map(w=>w.gm).filter(v=>v!=null);
    if(gmVals.length>=CFG.minN && cur.gm_avg!=null) put('gm_avg', median(gmVals), cur.gm_avg);
    return rec;
  }).sort((a,b)=>b.n-a.n || a.block.localeCompare(b.block,'zh'));
}

function renderRollCfg(){
  const rows=[
    ['win','滚动窗口（月）',1,'12 / 24 / 36 月；窗口越短越贴近当前水平，越长越稳'],
    ['minN','最小样本井数',1,'不足则本期不更新，沿用上期定额'],
    ['alpha','平滑系数 α',0.05,'新定额 = α×本期滚动值 +（1−α）×上期定额'],
    ['cap','单期变动上限',0.01,'防止定额跳变造成队伍收入大幅波动'],
    ['adv','先进性系数',0.005,'＜1 表示在滚动均值上再压一档，体现降本导向'],
    ['beta','提速让利系数 β',0.05,'米费随日进尺反向调整的力度，0 = 提速收益全留给队伍，1 = 全部收回']
  ];
  $('#rollCfg').innerHTML='';
  rows.forEach(([k,l,st,why])=>{
    const d=el('div','fld'); d.dataset.src='sys';
    d.innerHTML=`<label>${l}<span class="dim num">${k==='cap'||k==='alpha'||k==='adv'||k==='beta'?(k==='cap'?pct(CFG[k],0):CFG[k].toFixed(2)):CFG[k]}</span></label>`;
    const i=el('input'); i.type='number'; i.step=st; i.value=CFG[k];
    i.addEventListener('input',e=>{ CFG[k]=parseFloat(e.target.value)||0; renderRoll(); });
    d.appendChild(i); d.appendChild(el('div','sub',why));
    $('#rollCfg').appendChild(d);
  });
}
function renderRollRules(){
  const h=$('#rollRules'); h.innerHTML='';
  RULE_ORDER.forEach(k=>{
    const r=RULE[k], d=el('div','fld'); d.dataset.src=r.on?'sys':'man';
    const box=el('div','chk');
    box.innerHTML=`<input type="checkbox" ${r.on?'checked':''}><span>${r.l}</span>`;
    box.querySelector('input').addEventListener('change',e=>{ r.on=e.target.checked; renderRoll(); });
    d.appendChild(box);
    if(r.v!=null){
      const i=el('input'); i.type='number'; i.step=r.s;
      i.value = r.u==='%' ? (r.v*100).toFixed(0) : r.v;
      i.addEventListener('input',e=>{ const v=parseFloat(e.target.value)||0; r.v = r.u==='%'? v/100 : v; renderRoll(); });
      d.appendChild(i);
    }
    d.appendChild(el('div','sub',r.why));
    h.appendChild(d);
  });
}

function renderRoll(){
  buildWellPool();
  if(MONTHS.indexOf(ROLL_MONTH)<0) ROLL_MONTH=MONTHS[MONTHS.length-1];
  if(!WELL_POOL.length){
    const note='尚无已审核的完成井样本。<b>操作路径：单井考核 → 完成井入库（待审核）→ 审核通过</b>后，将自动作为滚动定额样本井参与迭代更新。';
    $('#rollKpi').innerHTML='<div class="note" style="margin:0">'+note+'</div>';
    const lb=$('#rollMonthLabel'); if(lb) lb.textContent='—';
    ['intakeTbl','rollTbl','specTbl'].forEach(id=>{ const t=$('#'+id); if(t) t.innerHTML='<tbody><tr><td class="dim" style="text-align:center">暂无样本井</td></tr></tbody>'; });
    const rn=$('#ratchetNote'); if(rn) rn.innerHTML='等待样本入库后展示本期调整建议。';
    const ab=$('#rollApply'); if(ab) ab.disabled=true;
    const rb=$('#rollReset'); if(rb) rb.disabled=true;
    return;
  }
  rollup();
  const cur=WELL_POOL.filter(w=>w.month===ROLL_MONTH);
  const kept=cur.filter(w=>w._ok).length;
  const upd=PROPS.filter(r=>r.status==='可更新');
  const allD=[]; upd.forEach(r=>Object.keys(r.items).forEach(mk=>{ if(mk!=='dayfoot'&&mk!=='gm_avg'&&r.items[mk].d!=null) allD.push(r.items[mk].d); }));
  const avgD=allD.length?allD.reduce((a,b)=>a+b,0)/allD.length:0;

  $('#rollKpi').innerHTML=[
    ['本月完成井', cur.length+' 口', ROLL_MONTH+' · 全部进入考核兑现'],
    ['入库样本井', kept+' 口', '剔除 '+(cur.length-kept)+' 口异常井，入库率 '+pct(cur.length?kept/cur.length:0,0)],
    ['滚动窗口样本', WINWELLS.filter(w=>w._ok).length+' / '+WINWELLS.length, '近 '+CFG.win+' 个月，'+PROPS.length+' 个区块组合'],
    ['可更新组合', upd.length+' 组', PROPS.length-upd.length+' 组样本不足，沿用上期']
  ].map(([k,v,d])=>`<div class="kpi"><div class="k">${k}</div><div class="v">${v}</div><div class="d">${d}</div></div>`).join('');

  $('#rollMonthLabel').textContent=ROLL_MONTH+' · 共 '+cur.length+' 口';
  $('#intakeTbl').innerHTML=`<thead><tr><th>井号</th><th>队号</th><th>区块 / 开次</th><th>进尺</th><th>日进尺</th><th>材料 元/米</th><th>状态</th></tr></thead><tbody>`+
    cur.map(w=>`<tr><td>${w.well}</td><td>${w.team}</td><td>${w.wellType} · ${w.block} ${w.phase}开</td>
      <td>${fmt(w.footage)}</td><td>${w.dayfoot.toFixed(1)}</td><td>${(norm(w,'mat')||0).toFixed(2)}</td>
      <td style="text-align:left">${w._ok?'<span class="pill ai">入库</span>':
        '<span class="pill bad">剔除</span> <span class="sub">'+[...w._hard,...w._mad.map(m=>m+'离群')].join('；')+'</span>'}</td></tr>`).join('')+
    `<tr class="total"><td>入库 ${kept} / ${cur.length}</td><td colspan="6" style="text-align:left" class="sub">剔除井仍正常兑现单井考核，只是不参与定额测算</td></tr></tbody>`;

  const cols=['mifei','mat','energy','lube','repair','dayfoot','gm_avg'];
  $('#rollTbl').innerHTML=`<thead><tr><th>井型 · 区块 · 开次</th><th>样本</th>`+
    cols.map(c=>`<th>${M_LABEL[c]}</th>`).join('')+`<th>状态</th></tr></thead><tbody>`+
    PROPS.map(r=>`<tr><td>${r.wellType} · ${r.block} · ${r.phase}开</td>
      <td>${r.n}<span class="sub"> / ${r.n+r.ex}</span></td>`+
      cols.map(c=>{ const it=r.items[c];
        if(!it) return '<td class="dim">—</td>';
        if(c==='gm_avg'){ const pp=(it.neo-it.old)*100;
          return `<td><span class="${pp>0.005?'pos':(pp<-0.005?'neg':'dim')}">${pp>0?'+':''}${pp.toFixed(2)}pp</span>${it.cap?'<span class="sub"> 触顶</span>':''}</td>`; }
        const cls=it.d>0.0005?'pos':(it.d<-0.0005?'neg':'dim');
        return `<td><span class="${cls}">${it.d>0?'+':''}${(it.d*100).toFixed(1)}%</span>${it.cap?'<span class="sub"> 触顶</span>':''}</td>`;
      }).join('')+
      `<td style="text-align:left">${r.status==='可更新'?'<span class="pill ai">可更新</span>':'<span class="pill man">样本不足</span>'}</td></tr>`).join('')+
    `<tr class="total"><td>合计</td><td>${upd.length} 组可更新</td><td colspan="${cols.length+1}" style="text-align:left">
      成本类定额平均变动 <span class="${avgD<0?'neg':'pos'}">${avgD>0?'+':''}${(avgD*100).toFixed(2)}%</span>
      · 触及单期变动上限 ${PROPS.reduce((s,r)=>s+r.capped,0)} 项${APPLIED?' · <span class="pill ai">已应用，定额库版本 '+(Q.version||'')+'</span>':''}</td></tr></tbody>`;

  $('#ratchetNote').innerHTML=`本期成本类定额平均${avgD<0?'收紧':'放宽'} ${Math.abs(avgD*100).toFixed(2)}%。
    缓释阀：单期上限 ${pct(CFG.cap,0)} · 平滑系数 α=${CFG.alpha.toFixed(2)} · 提速让利 β=${CFG.beta.toFixed(2)} · 先进性系数 ${CFG.adv.toFixed(3)}（经营考核委员会审定）。`;

  $('#specTbl').innerHTML=`<thead><tr><th>井型 · 区块 · 开次</th><th>毛益率平均</th><th>110% 指标</th><th>120% 指标</th><th>平均日进尺</th><th>样本</th></tr></thead><tbody>`+
    PROPS.filter(r=>r.items.gm_avg||r.items.dayfoot).slice(0,14).map(r=>{
      const g=r.items.gm_avg, d=r.items.dayfoot;
      const n110=g?g.neo+Math.abs(g.neo)*0.1:null, n120=g?g.neo+Math.abs(g.neo)*0.2:null;
      return `<tr><td>${r.wellType} · ${r.block} · ${r.phase}开</td>
        <td>${g?pct(g.old,2)+' → '+pct(g.neo,2):'—'}</td>
        <td>${n110!=null?pct(n110,2):'—'}</td><td>${n120!=null?pct(n120,2):'—'}</td>
        <td>${d?d.old.toFixed(1)+' → '+d.neo.toFixed(1):'—'}</td><td class="dim">${r.n}</td></tr>`;
    }).join('')+
    (()=>{ const okW=WINWELLS, tot=okW.reduce((s,w)=>s+w.days,0), acc=okW.reduce((s,w)=>s+w.days*w.accPct,0);
      const rate=tot?acc/tot:0;
      return `<tr class="total"><td>大港油区事故复杂率</td><td colspan="4" style="text-align:left">
        窗口实际 <span class="${rate<0.022?'pos':'neg'}">${pct(rate,2)}</span> · 附件1-17 目标 ＜2.2%
        ${rate<0.022?'（达标，按实有钻机数×利用率×20000 元核增指标）':'（未达标，本季不予核增）'}</td><td></td></tr>`; })()+
    `</tbody>`;
}

$('#rollApply').onclick=()=>{
  ensureQuotaVersion();
  const ops=[], newDs=[], prevVersion=Q.version;
  PROPS.forEach(r=>{
    if(r.status!=='可更新') return;
    const cur=Q.blocks.find(x=>x.wellType===r.wellType&&x.block===r.block&&x.phase===r.phase);
    if(!cur) return;
    if(!cur._d) newDs.push(cur);
    cur._d=cur._d||{};
    Object.keys(r.items).forEach(mk=>{
      const it=r.items[mk]; if(it.old==null) return;
      const f=FIELD_OF[mk];
      ops.push({cur, field:f, old:cur[f], hadDelta:Object.prototype.hasOwnProperty.call(cur._d,f), oldDelta:cur._d[f]});
      cur[f]=Math.round(it.neo*1e6)/1e6;
      cur._d[f]=it.d;
      if(mk==='mat'&&cur.mat70!=null){
        ops.push({cur, field:'mat70', old:cur.mat70, hadDelta:Object.prototype.hasOwnProperty.call(cur._d,'mat70'), oldDelta:cur._d.mat70});
        cur.mat70=Math.round(it.neo*MAT_RATIO*1e6)/1e6; cur._d.mat70=it.d;
      }
      if(mk==='gm_avg'){
        ops.push({cur, field:'gm_110', old:cur.gm_110}, {cur, field:'gm_120', old:cur.gm_120});
        cur.gm_110=it.neo+Math.abs(it.neo)*0.1; cur.gm_120=it.neo+Math.abs(it.neo)*0.2;
      }
    });
  });
  if(ops.length){ PREV_OPS={ops,newDs,version:prevVersion,verSnap:nextQuotaVersion()}; $('#rollReset').disabled=false; }
  APPLIED=true;
  if(ops.length){
    Q.version=nextQuotaVersion();
    Q.versions.push({ver:Q.version, at:Date.now(), note:ROLL_MONTH+' 滚动定额应用', blocks:JSON.parse(JSON.stringify(Q.blocks))});
  }
  saveQuota();
  renderRoll(); renderQuota(); renderResults(); renderWellStore();
};
$('#rollReset').onclick=()=>{
  if(!PREV_OPS) return;
  PREV_OPS.ops.slice().reverse().forEach(op=>{
    if(op.old==null) delete op.cur[op.field]; else op.cur[op.field]=op.old;
    if('hadDelta' in op){ if(op.hadDelta) op.cur._d[op.field]=op.oldDelta; else delete op.cur._d[op.field]; }
  });
  PREV_OPS.newDs.forEach(cur=>{ if(cur._d && Object.keys(cur._d).length===0) delete cur._d; });
  if(PREV_OPS.verSnap && Q.versions.length && Q.versions[Q.versions.length-1].ver===PREV_OPS.verSnap) Q.versions.pop();
  Q.version=PREV_OPS.version; APPLIED=PREV_OPS.version!=null;
  PREV_OPS=null;
  $('#rollReset').disabled=true;
  saveQuota();
  renderRoll(); renderQuota(); renderResults(); renderWellStore();
};
$('#rollReset').disabled=true;
$('#rollReset').title='撤销最近一次「应用到定额库」改动过的字段，恢复到应用前的值（逐字段撤销，不影响一井一策等其它来源新增的区块）';

/* ============================ 路由与启动 ============================ */
function go(id){
  document.querySelectorAll('.page').forEach(p=>p.classList.toggle('on', p.id==='p-'+id));
  document.querySelectorAll('.navbtn').forEach(b=>b.setAttribute('aria-current', b.dataset.go===id));
  document.querySelector('main').classList.toggle('full', id==='well');
  if(id==='pre') renderPre();
  if(id==='quota') renderQuota();
  if(id==='roll') renderRoll();
  if(id==='team') renderTeam();
  window.scrollTo({top:0,behavior:'instant'});
}
document.querySelectorAll('.navbtn').forEach(b=>b.onclick=()=>go(b.dataset.go));


function render(){ renderForm(); renderResults(); }


/* 趋势图 / 汇总口径 / 填报页签 */
function renderTabs(){
  const fs=$('#formSeg');
  [...fs.children].forEach(x=>x.setAttribute('aria-pressed', x.dataset.tab===formTab));
}
(function(){
  const ts=$('#trendSeg');
  [['foot','进尺'],['rev','市场创收'],['gm','贡献毛益额']].forEach(([v,l])=>{
    const b=el('button',null,l); b.type='button';
    b.onclick=()=>{ trendMetric=v; [...ts.children].forEach(x=>x.setAttribute('aria-pressed', x===b)); renderTrend(agg()); };
    ts.appendChild(b);
  });
  ts.firstChild.setAttribute('aria-pressed','true');
  $('#trendView').onclick=()=>{ trendTable=!trendTable; $('#trendView').textContent=trendTable?'图表':'表格'; renderTrend(agg()); };

  const mms=$('#mktMonth');
  MONTH_LBL.forEach((l,i)=>{ const o=el('option',null,l); o.value=i+1; mms.appendChild(o); });
  mms.value=mktMonth;
  mms.addEventListener('change',e=>{ mktMonth=+e.target.value; renderMarket(agg()); });
  const ss=$('#scopeSeg');
  [['year','年度口径'],['prog','进度口径'],['month','月度口径']].forEach(([v,l])=>{
    const b=el('button',null,l); b.type='button'; b.setAttribute('aria-pressed', mktScope===v);
    b.onclick=()=>{ mktScope=v; [...ss.children].forEach(x=>x.setAttribute('aria-pressed', x===b)); renderMarket(agg()); };
    ss.appendChild(b);
  });

  const fs=$('#formSeg');
  TABS.forEach(t=>{
    const b=el('button',null,t.n); b.type='button'; b.dataset.tab=t.k;
    b.onclick=()=>{ formTab=t.k; renderTabs(); renderReport(agg()); };
    fs.appendChild(b);
  });
  const ms=$('#formMonth');
  MONTH_LBL.forEach((l,i)=>{ const o=el('option',null,l); o.value=i+1; ms.appendChild(o); });
  ms.value=formMonth;
  ms.addEventListener('change',e=>{ formMonth=+e.target.value; renderReport(agg()); });
  $('#formReset').onclick=()=>{ DS=blankDS(); saveDS(); refreshAll(); renderTabs(); };
  renderTabs();
})();
$('#teamBase').addEventListener('input',renderTeam);
$('#qSearch').addEventListener('input',renderQuota);

