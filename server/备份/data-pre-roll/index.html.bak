  road:'<path d="M2.9 6.2h4.2M11 6.2h6.1M2.9 13.8h8.2M15 13.8h2.1"/><circle cx="9.05" cy="6.2" r="1.95"/><circle cx="12.95" cy="13.8" r="1.95"/>',
