<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>html{color-scheme:light dark}body{margin:0}img{max-width:100%}[hidden]{display:none!important}</style>
<title>钻井经营考核工作台</title>
<style>
:root{
  color-scheme:light;
  --ground:#F5F5F7; --surface:#FFFFFF; --surface-2:#F0F0F3; --surface-3:#E6E6EB;
  --fill:rgba(120,120,128,.12); --fill-2:rgba(120,120,128,.20);
  --ink:#1D1D1F; --ink-2:#3C3C43; --muted:#6E6E73;
  --line:#D8D8DE; --line-2:#EAEAEF;
  --accent:#0071E3; --accent-ink:#0062C4; --accent-soft:#E8F1FD; --on-accent:#FFFFFF;
  --signal:#A15A00; --signal-soft:#FFF3E2;
  --pos:#1B7F3B; --pos-soft:#E6F6EA; --neg:#C9271C; --neg-soft:#FDECEA;
  --c1:#0071E3; --c2:#E08600; --c3:#9B4DCA;
  --material:rgba(255,255,255,.72); --seg-thumb:#FFFFFF;
  --border-hover:rgba(0,113,227,.34); --shadow-hover:0 2px 10px rgba(0,0,0,.05),0 26px 48px -18px rgba(17,17,20,.24);
  --focus:rgba(0,113,227,.32);
  --shadow:0 1px 2px rgba(0,0,0,.04), 0 8px 24px -10px rgba(0,0,0,.12);
  --shadow-sm:0 1px 2px rgba(0,0,0,.06);
  --r:10px; --r-card:14px; --r-sm:7px;
  --ease:cubic-bezier(.32,.72,0,1);
  --sans:-apple-system,BlinkMacSystemFont,"SF Pro Text","SF Pro Display","Helvetica Neue","PingFang SC","Hiragino Sans GB","Microsoft YaHei",system-ui,sans-serif;
  --mono:ui-monospace,"SF Mono",SFMono-Regular,Menlo,"PingFang SC",Consolas,monospace;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    color-scheme:dark;
    --ground:#000000; --surface:#1C1C1E; --surface-2:#2C2C2E; --surface-3:#3A3A3C;
    --fill:rgba(120,120,128,.24); --fill-2:rgba(120,120,128,.36);
    --ink:#F5F5F7; --ink-2:#D1D1D6; --muted:#8E8E93;
    --line:#38383A; --line-2:#2C2C2E;
    --accent:#0A84FF; --accent-ink:#5AB0FF; --accent-soft:#0B2A4A; --on-accent:#FFFFFF;
    --signal:#FF9F0A; --signal-soft:#3A2A0B;
    --pos:#30D158; --pos-soft:#102E19; --neg:#FF453A; --neg-soft:#3A1614;
    --c1:#0A84FF; --c2:#FF9F0A; --c3:#BF5AF2;
    --material:rgba(28,28,30,.72); --seg-thumb:#636366;
    --border-hover:rgba(10,132,255,.42); --shadow-hover:0 2px 10px rgba(0,0,0,.6),0 30px 56px -18px rgba(0,0,0,.95);
    --focus:rgba(10,132,255,.45);
    --shadow:0 1px 2px rgba(0,0,0,.5), 0 12px 30px -14px rgba(0,0,0,.85);
    --shadow-sm:0 1px 2px rgba(0,0,0,.5);
  }
}
:root[data-theme="dark"]{
  color-scheme:dark;
  --ground:#000000; --surface:#1C1C1E; --surface-2:#2C2C2E; --surface-3:#3A3A3C;
  --fill:rgba(120,120,128,.24); --fill-2:rgba(120,120,128,.36);
  --ink:#F5F5F7; --ink-2:#D1D1D6; --muted:#8E8E93;
  --line:#38383A; --line-2:#2C2C2E;
  --accent:#0A84FF; --accent-ink:#5AB0FF; --accent-soft:#0B2A4A; --on-accent:#FFFFFF;
  --signal:#FF9F0A; --signal-soft:#3A2A0B;
  --pos:#30D158; --pos-soft:#102E19; --neg:#FF453A; --neg-soft:#3A1614;
  --c1:#0A84FF; --c2:#FF9F0A; --c3:#BF5AF2;
  --material:rgba(28,28,30,.72); --seg-thumb:#636366;
  --border-hover:rgba(10,132,255,.42); --shadow-hover:0 2px 10px rgba(0,0,0,.6),0 30px 56px -18px rgba(0,0,0,.95);
  --focus:rgba(10,132,255,.45);
  --shadow:0 1px 2px rgba(0,0,0,.5), 0 12px 30px -14px rgba(0,0,0,.85);
  --shadow-sm:0 1px 2px rgba(0,0,0,.5);
}
*{box-sizing:border-box}
body{background:var(--ground);color:var(--ink);font-family:var(--sans);font-size:13px;line-height:1.55;
  -webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;letter-spacing:-.003em}
h1,h2,h3,h4{font-family:var(--sans);font-weight:600;margin:0;text-wrap:balance;letter-spacing:-.018em}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:none;box-shadow:0 0 0 3.5px var(--focus);border-radius:var(--r-sm)}
::-webkit-scrollbar{width:11px;height:11px}
::-webkit-scrollbar-thumb{background:var(--fill-2);border-radius:99px;border:3px solid transparent;background-clip:content-box}
::-webkit-scrollbar-thumb:hover{background:var(--muted);background-clip:content-box}
::-webkit-scrollbar-track{background:transparent}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}

/* ---------- shell ---------- */
.app{display:grid;grid-template-columns:232px minmax(0,1fr);min-height:100vh;
  transition:grid-template-columns .42s var(--ease)}
.rail{width:232px;background:var(--material);-webkit-backdrop-filter:saturate(180%) blur(22px);backdrop-filter:saturate(180%) blur(22px);
  border-right:1px solid var(--line);position:sticky;top:0;height:100vh;display:flex;flex-direction:column;gap:1px;padding:0 0 14px;
  transition:transform .42s var(--ease),opacity .3s var(--ease)}
.brand{padding:22px 18px 16px;margin-bottom:8px}
.brand .mark{font-size:10.5px;letter-spacing:.02em;color:var(--muted);font-weight:590;
  padding-left:37px;min-height:31px;display:flex;align-items:center}
.brand h1{font-size:17px;line-height:1.3;margin-top:5px;letter-spacing:-.022em}
.brand .sub{color:var(--muted);font-size:11.5px;margin-top:3px}
.navbtn{display:flex;align-items:center;gap:10px;width:calc(100% - 16px);margin:0 8px;background:none;border:0;text-align:left;
  padding:7px 10px;cursor:pointer;color:var(--ink-2);border-radius:var(--r-sm);font-size:13px;font-weight:500;
  transition:background .18s ease,color .18s ease}
.navbtn:hover{background:var(--fill);color:var(--ink)}
.navbtn[aria-current="true"]{background:var(--accent);color:#fff}
.navbtn .n{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;flex:0 0 auto;opacity:.72}
.navbtn[aria-current="true"] .n{opacity:1}
.railfoot{margin-top:auto;padding:14px 18px 0;border-top:1px solid var(--line-2);color:var(--muted);font-size:10.5px;line-height:1.5}
.iconbtn{position:fixed;top:13px;z-index:30;width:31px;height:31px;display:inline-flex;align-items:center;justify-content:center;
  background:var(--material);-webkit-backdrop-filter:saturate(180%) blur(22px);backdrop-filter:saturate(180%) blur(22px);
  border:1px solid var(--line);border-radius:var(--r-sm);color:var(--ink-2);cursor:pointer;padding:0;box-shadow:var(--shadow-sm);
  transition:background .18s ease,color .18s ease,transform .18s var(--ease)}
.iconbtn:hover{color:var(--ink);background:var(--surface)}
.iconbtn:active{transform:scale(.93)}
.iconbtn svg{display:block}
.themebtn{right:15px}
.menubtn{left:15px;top:22px}
.app.nav-hidden{grid-template-columns:0 minmax(0,1fr)}
.app.nav-hidden .rail{transform:translateX(-232px);opacity:0;pointer-events:none}
.app.nav-hidden .phead{padding-left:38px}
main{padding:26px 32px 80px;min-width:0}
.page{display:none}
.page.on{display:block;animation:pageIn .38s var(--ease)}
@keyframes pageIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.phead{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;flex-wrap:wrap;padding:0 20px 16px 0;
  border-bottom:1px solid var(--line-2);margin-bottom:22px}
.phead h2{font-size:26px;letter-spacing:-.024em;line-height:1.2}
.phead p{margin:7px 0 0;color:var(--muted);max-width:64ch;font-size:13px}

/* ---------- primitives ---------- */
.card{background:var(--material);-webkit-backdrop-filter:saturate(180%) blur(20px);backdrop-filter:saturate(180%) blur(20px);
  border:1px solid var(--line-2);border-radius:var(--r-card);box-shadow:var(--shadow);
  transition:transform .26s var(--ease),box-shadow .26s var(--ease),border-color .22s ease}
.card:hover{transform:translateY(-3px);box-shadow:var(--shadow-hover);border-color:var(--border-hover)}
.card>header{padding:13px 16px;border-bottom:1px solid var(--line-2);display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.card>header h3{font-size:14.5px;letter-spacing:-.014em}
.card>.body{padding:16px}
.eyebrow{font-size:11.5px;color:var(--muted);font-weight:500;letter-spacing:0}
.grid{display:grid;gap:16px;grid-template-columns:minmax(0,1fr)}
.num{font-variant-numeric:tabular-nums}
.pos{color:var(--pos)} .neg{color:var(--neg)} .dim{color:var(--muted)}
.pill{display:inline-flex;align-items:center;gap:4px;font-size:10.5px;font-weight:500;padding:2px 7px;border-radius:6px;
  border:1px solid var(--line);color:var(--muted);white-space:nowrap;font-variant-numeric:tabular-nums;letter-spacing:0}
.pill.sys{background:var(--accent-soft);border-color:transparent;color:var(--accent-ink)}
.pill.ai{background:var(--pos-soft);border-color:transparent;color:var(--pos)}
.pill.man{background:var(--signal-soft);border-color:transparent;color:var(--signal)}
.pill.bad{background:var(--neg-soft);border-color:transparent;color:var(--neg)}
.btn{background:var(--accent);color:var(--on-accent);border:0;padding:6px 15px;border-radius:var(--r-sm);cursor:pointer;
  font-size:12.5px;font-weight:500;letter-spacing:-.004em;transition:filter .18s ease,transform .18s var(--ease)}
.btn:hover{filter:brightness(1.07)}
.btn:active{transform:scale(.97)}
.btn:disabled{opacity:.4;cursor:not-allowed;filter:none;transform:none}
.btn.ghost{background:var(--fill);color:var(--accent)}
.btn.ghost:hover{background:var(--fill-2);filter:none}
.btn.mini{padding:3px 10px;font-size:11.5px;border-radius:6px}
.seg{display:inline-flex;background:var(--fill);border:0;border-radius:9px;padding:2px;gap:2px;flex:0 0 auto}
.seg button{background:none;border:0;padding:5px 13px;cursor:pointer;color:var(--ink);font-size:12.5px;font-weight:500;
  white-space:nowrap;border-radius:7px;transition:background .24s var(--ease),box-shadow .24s var(--ease),color .18s ease}
.seg button:hover{color:var(--ink)}
.seg button[aria-pressed="true"]{background:var(--seg-thumb);color:var(--ink);box-shadow:0 1px 3px rgba(0,0,0,.14),0 0 0 .5px rgba(0,0,0,.04)}

/* ---------- form ---------- */
.fld{display:grid;grid-template-columns:1fr;gap:5px;margin-bottom:12px}
.fld label{font-size:11.5px;color:var(--muted);display:flex;align-items:center;justify-content:space-between;gap:6px}
.fld input,.fld select,textarea{width:100%;background:var(--surface-2);border:1px solid transparent;border-radius:var(--r-sm);
  padding:7px 10px;font-size:13px;transition:background .18s ease,border-color .18s ease,box-shadow .18s ease}
.fld input[type=number]{font-variant-numeric:tabular-nums}
.fld input:focus,.fld select:focus,textarea:focus{background:var(--surface);border-color:var(--accent);box-shadow:0 0 0 3.5px var(--focus);outline:none}
.fld[data-src="man"] input,.fld[data-src="man"] select{box-shadow:inset 3px 0 0 var(--signal)}
.fld[data-src="ai"] input,.fld[data-src="ai"] select{box-shadow:inset 3px 0 0 var(--pos)}
.fld[data-src="sys"] input,.fld[data-src="sys"] select{box-shadow:inset 3px 0 0 var(--accent)}
.fld[data-src] input:focus,.fld[data-src] select:focus{box-shadow:0 0 0 3.5px var(--focus)}
.f2{display:grid;grid-template-columns:1fr 1fr;gap:0 12px}
.f3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:0 12px}
.chk{display:flex;align-items:center;gap:9px;font-size:13px;padding:4px 0;color:var(--ink-2)}
.chk input[type=checkbox]{appearance:none;-webkit-appearance:none;width:38px;height:23px;flex:0 0 auto;margin:0;padding:0;border:0;
  border-radius:99px;background:var(--fill-2);position:relative;cursor:pointer;transition:background .26s var(--ease)}
.chk input[type=checkbox]::after{content:"";position:absolute;top:2px;left:2px;width:19px;height:19px;border-radius:50%;
  background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.25);transition:transform .26s var(--ease)}
.chk input[type=checkbox]:checked{background:var(--pos)}
.chk input[type=checkbox]:checked::after{transform:translateX(15px)}
fieldset{border:0;padding:0;margin:0 0 6px}
fieldset legend{font-size:12px;font-weight:590;letter-spacing:-.006em;color:var(--muted);padding:14px 0 9px;
  border-top:1px solid var(--line-2);width:100%;margin-bottom:8px}
fieldset:first-of-type legend{border-top:0;padding-top:0}

/* ---------- tables ---------- */
.scroll{overflow-x:auto}
table{border-collapse:collapse;width:100%;font-size:12.5px}
th{font-size:11.5px;letter-spacing:0;text-transform:none;color:var(--muted);font-weight:500;text-align:right;
  padding:9px 10px;border-bottom:1px solid var(--line);white-space:nowrap}
th:first-child{text-align:left}
td{padding:8px 10px;border-bottom:1px solid var(--line-2);text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
td:first-child{text-align:left}
tbody tr{transition:background .14s ease}
tbody tr:hover{background:var(--fill)}
tr.grp td{background:var(--surface-2);font-weight:590}
tr.total td{border-top:1px solid var(--line);border-bottom:0;font-weight:600;font-size:13px;padding-top:11px}
.sub{color:var(--muted);font-size:11px;font-weight:400;letter-spacing:0}
td select{width:100%;min-width:80px;background:var(--surface-2);border:1px solid transparent;border-radius:6px;padding:4px 7px;font-size:12px}
td select:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--focus);outline:none}
td input{width:100%;min-width:66px;background:transparent;border:1px solid transparent;padding:4px 6px;text-align:right;
  font-variant-numeric:tabular-nums;font-size:12.5px;border-radius:6px;transition:background .16s ease,border-color .16s ease}
td input:hover{background:var(--fill)}
td input:focus{background:var(--surface-2);border-color:var(--accent);box-shadow:0 0 0 3px var(--focus);outline:none}
thead tr:first-child th[colspan]{text-align:center;border-bottom:1px solid var(--line-2);color:var(--ink-2);font-weight:590}
.bar{height:6px;background:var(--fill);border-radius:99px;overflow:hidden;display:flex}
.bar i{display:block;height:100%}

/* ---------- kpi ---------- */
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(168px,1fr));gap:12px}
.kpi{background:var(--material);-webkit-backdrop-filter:saturate(180%) blur(16px);backdrop-filter:saturate(180%) blur(16px);
  border:1px solid var(--line-2);border-radius:var(--r-card);padding:15px 17px;box-shadow:var(--shadow-sm);
  transition:transform .22s var(--ease),box-shadow .22s var(--ease),border-color .2s ease}
.kpi:hover{transform:translateY(-2px);box-shadow:var(--shadow-hover);border-color:var(--border-hover)}
.kpi .k{font-size:11.5px;color:var(--muted);letter-spacing:0}
.kpi .v{font-size:27px;font-weight:600;line-height:1.2;margin-top:5px;font-variant-numeric:tabular-nums;letter-spacing:-.026em}
.kpi .d{font-size:11px;color:var(--muted);margin-top:4px;line-height:1.45}

/* ---------- 表单 ---------- */
textarea{min-height:160px;resize:vertical;font-family:var(--mono);font-size:12px;line-height:1.6}
.conf{display:inline-block;width:36px;height:6px;border-radius:99px;background:var(--fill);vertical-align:middle;overflow:hidden;margin-right:6px}
.conf i{display:block;height:100%;background:var(--pos);border-radius:99px}
.conf.low i{background:var(--signal)}

/* ---------- misc ---------- */
.legend{display:flex;flex-wrap:wrap;gap:16px;margin-bottom:12px}
.legend span{display:inline-flex;align-items:center;gap:7px;font-size:12px;color:var(--ink-2)}
.legend i{width:9px;height:9px;border-radius:3px;display:block}
.chart svg{display:block;width:100%;height:auto}
.chart rect.seg,.chart path.seg{cursor:pointer;transition:opacity .18s ease}
.chart rect.seg:hover,.chart path.seg:hover{opacity:.8}
.tip{position:absolute;pointer-events:none;background:var(--material);-webkit-backdrop-filter:saturate(180%) blur(22px);
  backdrop-filter:saturate(180%) blur(22px);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow);
  padding:9px 11px;font-size:11.5px;z-index:5;min-width:142px}
.tip b{font-variant-numeric:tabular-nums}
.tip .row{display:flex;justify-content:space-between;gap:12px}
.note{background:var(--signal-soft);border:0;padding:11px 14px;border-radius:var(--r);font-size:12px;color:var(--ink-2);line-height:1.55}
.note b{color:var(--signal)}
.note.err{background:var(--neg-soft)}
.note.err b{color:var(--neg)}
.note.ok{background:var(--pos-soft)}
.note.ok b{color:var(--pos)}
.opt{border-top:1px solid var(--line-2);padding:16px 0}
.opt:first-child{border-top:0;padding-top:0}
.opt h4{font-size:14.5px;display:flex;gap:9px;align-items:baseline;letter-spacing:-.014em}
.opt h4 .n{font-size:12px;color:var(--accent);font-weight:590;font-variant-numeric:tabular-nums}
.opt dl{display:grid;grid-template-columns:44px 1fr;gap:5px 12px;margin:9px 0 0}
.opt dt{font-size:11.5px;color:var(--muted);padding-top:1px;font-weight:500}
.opt dd{margin:0;color:var(--ink-2);line-height:1.55}
.split{display:grid;grid-template-columns:minmax(300px,388px) minmax(0,1fr);gap:18px;align-items:start}
#p-well.on{display:flex;flex-direction:column;height:calc(100vh - 52px);min-height:600px}
#p-well .phead{padding-bottom:10px;margin-bottom:12px}
#p-well .phead p{margin-top:4px;font-size:12px}
main.full{padding-bottom:26px}
.wellwrap{display:flex;flex-direction:column;gap:12px;flex:1 1 auto;min-height:0}
.wellsplit{display:grid;grid-template-columns:minmax(320px,392px) minmax(0,1fr);gap:18px;flex:1 1 auto;min-height:0;
  transition:grid-template-columns .42s var(--ease),gap .42s var(--ease)}
.wellsplit>.wellcol{transition:transform .42s var(--ease),opacity .3s var(--ease)}
.wellsplit.hide-form{grid-template-columns:0 minmax(0,1fr);gap:0}
.wellsplit.hide-form>.wellcol:first-child{opacity:0;pointer-events:none;overflow:hidden}
.wellsplit.hide-view{grid-template-columns:minmax(0,1fr) 0;gap:0}
.wellsplit.hide-view>.wellcol:last-child{opacity:0;pointer-events:none;overflow:hidden}
.discs{display:inline-flex;align-items:center;gap:2px;flex:0 0 auto}
#wellActions{display:flex;flex-direction:column;gap:6px;flex:0 0 auto;min-width:112px}
#wellActions .btn{width:100%}
.wellcol{overflow-y:auto;overflow-x:hidden;min-height:0;display:flex;flex-direction:column;gap:16px;padding:2px 8px 10px 2px;overscroll-behavior:contain}
.wellfoot{flex:0 0 auto;display:flex;flex-direction:column;min-height:0;max-height:38vh}
.wellfoot>.body{overflow:auto;min-height:0}
.wellfoot.fold{max-height:none}
.wellfoot.fold>.body{display:none}
.disc{display:inline-flex;align-items:center;gap:5px;background:none;border:0;color:var(--accent);cursor:pointer;font-size:12.5px;font-weight:500;padding:2px 4px;border-radius:6px}
.disc:hover{background:var(--fill)}
.disc svg{transition:transform .28s var(--ease)}
.wellfoot.fold .disc svg{transform:rotate(-90deg)}
.foldbar{overflow:hidden;background:var(--surface-2);-webkit-backdrop-filter:none;backdrop-filter:none;box-shadow:none}
.foldbar:hover{transform:none;box-shadow:none;border-color:var(--line-2)}
.foldhead{display:flex;align-items:center;justify-content:space-between;gap:14px;width:100%;background:none;border:0;
  padding:15px 18px;cursor:pointer;color:var(--ink);text-align:left;transition:background .18s ease}
.foldhead:hover{background:var(--fill)}
.foldhead .fh-l{display:inline-flex;align-items:center;gap:10px;min-width:0}
.foldhead b{font-size:15.5px;font-weight:600;letter-spacing:-.014em}
.foldhead svg{color:var(--accent);flex:0 0 auto;transition:transform .28s var(--ease)}
.foldbar.closed .foldhead svg{transform:rotate(-90deg)}
.foldbar.closed .foldbody{display:none}
.foldbody{padding:16px 18px 18px;border-top:1px solid var(--line-2)}
#p-dash .kpis{gap:14px}
#p-dash .kpi{padding:18px 20px}
#p-dash .kpi .v{font-size:31px}
#p-dash .duo{gap:18px;margin-top:18px}
#p-dash .card>.body{padding:18px}
.infogrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
.infogrid>.card{container-type:inline-size;overflow:hidden}
.infogrid>.card>.body{padding:12px 13px}
.infogrid .k.sub{font-size:clamp(10px,5cqi,12px);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block}
.infogrid .bignum{font-size:clamp(15px,10cqi,22px);white-space:nowrap;line-height:1.18}
.infogrid .kv{font-size:clamp(9.5px,4.6cqi,11.5px);padding:3px 0;gap:5px;flex-wrap:nowrap}
.infogrid .kv>span{white-space:nowrap;line-height:1.35;overflow:hidden;text-overflow:ellipsis}
.infogrid .kv>span:last-child{font-weight:500;flex:0 0 auto;overflow:visible}
.infogrid .sub{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.wellhead{position:sticky;top:0;z-index:4;flex:0 0 auto;border-radius:0;box-shadow:none;border:0;border-bottom:1px solid var(--line-2)}
.wellhead:hover{transform:none;box-shadow:none;border-color:var(--line-2)}
.wellhead .body{border-radius:inherit}
.bignum{font-size:26px;font-weight:600;letter-spacing:-.026em;font-variant-numeric:tabular-nums;line-height:1.15}
.kv{display:flex;justify-content:space-between;gap:10px;padding:3.5px 0;font-size:12px;border-bottom:1px solid var(--line-2)}
.kv:last-child{border-bottom:0}
.kv>span:first-child{color:var(--muted);flex:0 1 auto}
.kv>span:last-child{font-variant-numeric:tabular-nums;text-align:right}
.split.even{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
.duo{display:grid;gap:16px;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);align-items:start;margin-top:18px}
.sticky{position:sticky;top:22px}
@media (max-width:1080px){.split,.split.even,.duo{grid-template-columns:minmax(0,1fr)}.sticky{position:static}
  #p-well.on{display:block;height:auto;min-height:0}.wellwrap{height:auto;min-height:0}.wellsplit{grid-template-columns:minmax(0,1fr)}
  .infogrid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .wellsplit.hide-form{grid-template-columns:minmax(0,1fr)}
  .wellsplit.hide-form>.wellcol:first-child{display:none;transform:none;width:auto}
  .wellsplit.hide-view{grid-template-columns:minmax(0,1fr)}
  .wellsplit.hide-view>.wellcol:last-child{display:none;transform:none;width:auto}
  .wellcol{overflow:visible;padding:0}.wellfoot{max-height:none}}
@media (max-width:820px){
  .app,.app.nav-hidden{grid-template-columns:1fr}
  .rail{width:auto;position:static;height:auto;flex-direction:row;overflow-x:auto;align-items:center;padding:9px;gap:4px;
    border-right:0;border-bottom:1px solid var(--line)}
  .app.nav-hidden .rail{display:none;transform:none}
  .brand,.railfoot{display:none}
  .menubtn{top:13px}
  .phead{padding-right:0}
  .phead h2{font-size:23px}
  .phead>div{flex-wrap:wrap;max-width:100%;min-width:0}
  .seg{max-width:100%;overflow-x:auto}
  .rail>*{flex:0 0 auto}
  .rail{padding-right:52px;padding-left:52px}
  .navbtn{width:auto;margin:0;white-space:nowrap;padding:6px 12px}
  main{padding:18px 15px 64px}
  .f2,.f3{grid-template-columns:1fr}
  .kpis{grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px}
}
</style>

</head>
<body>
<button class="iconbtn menubtn" id="navBtn" type="button"></button>
<button class="iconbtn themebtn" id="themeBtn" type="button"></button>
<div class="app" id="app">
<nav class="rail">
  <div class="brand">
    <div class="mark">BHDC · No.3</div>
    <h1>钻井经营考核<br>工作台</h1>
    <div class="sub">三定额 · 三专项 · 数据溯源</div>
  </div>
  <button class="navbtn" data-go="dash"><span class="n">01</span>经营驾驶舱</button>
  <button class="navbtn" data-go="well"><span class="n">02</span>单井考核</button>
  <button class="navbtn" data-go="pre"><span class="n">03</span>预兑现登记</button>
  <button class="navbtn" data-go="quota"><span class="n">04</span>定额库</button>
  <button class="navbtn" data-go="roll"><span class="n">05</span>滚动定额</button>
  <button class="navbtn" data-go="team"><span class="n">06</span>班子绩效</button>
  <button class="navbtn" data-go="road"><span class="n">07</span>机制优化</button>
  <div class="railfoot">
    依据：2026年经营责任制实施办法 · 附件1 考核标准及相关定额 · 附件2 大港油区单井经营考核办法（试行）· 附件3 钻井队班子绩效考核办法
  </div>
</nav>

<main>

<!-- ============ 01 驾驶舱 ============ -->
<section class="page" id="p-dash">
  <div class="phead">
    <div>
      <h2>经营驾驶舱</h2>
      <p>数据期 <strong>2026 年 8 月</strong> · 公司总体／大港油区／西北／长庆，进尺·创收·贡献毛益额按 30／40／30 加权。</p>
    </div>
  </div>

  <div class="card foldbar closed" id="formCard">
    <button class="foldhead" id="formFold" type="button">
      <span class="fh-l">
        <svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M5.5 8l4.5 4.5L14.5 8"/></svg>
        <b>数据填报</b>
        <span class="sub" id="formFoldSub"></span>
      </span>
      <span class="sub" id="formFoldAct">展开填报</span>
    </button>
    <div class="foldbody">
      <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:14px">
        <div class="seg" id="formSeg"></div>
        <span id="formMonthWrap" style="display:inline-flex;gap:6px;align-items:center">
          <span class="eyebrow">月份</span>
          <select id="formMonth" style="background:var(--surface-2);border:1px solid transparent;border-radius:7px;padding:6px 10px"></select>
        </span>
        <button class="btn ghost" id="formReset">恢复归档值</button>
      </div>
      <div class="scroll"><table id="formTbl"></table></div>
      <div class="scroll" style="margin-top:14px"><div id="formProgress"></div></div>
      <p class="sub" style="margin-top:12px">状态按钮循环切换：草稿 → 已提交 → 已审核</p>
    </div>
  </div>

  <div class="kpis" id="dashKpi" style="margin-top:18px"></div>

  <div class="card" style="margin-top:18px">
    <header><h3>月度完成趋势</h3>
      <div style="display:flex;gap:8px;align-items:center">
        <div class="seg" id="trendSeg"></div>
        <button class="btn ghost" id="trendView">表格</button>
      </div>
    </header>
    <div class="body">
      <div class="legend" id="trendLegend"></div>
      <div class="chart" id="trendWrap" style="position:relative"></div>
      <p class="sub" style="margin:10px 0 0">公司 = 大港油区 + 西北 + 长庆</p>
    </div>
  </div>

  <div class="card" style="margin-top:18px">
    <header><h3>主体单位经营指标与基础月奖切块</h3>
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap"><span class="eyebrow">口径</span><div class="seg" id="scopeSeg"></div><select id="mktMonth" hidden style="background:var(--surface-2);border:1px solid transparent;border-radius:7px;padding:6px 10px"></select></div>
    </header>
    <div class="body">
      <div class="scroll"><table id="mktTbl"></table></div>
      <p class="sub" style="margin:10px 0 0" id="mktNote"></p>
    </div>
  </div>

  <div class="duo">
    <div class="card">
      <header><h3>切块奖金使用与节余</h3><span class="eyebrow">全口径</span></header>
      <div class="body">
        <div class="scroll"><table id="surplusTbl"></table></div>
        <div id="surplusNote" class="sub" style="margin:10px 0 0"></div>
        <p class="sub" style="margin:10px 0 0">含基础月奖、安效奖、定员考核、事故复杂等专项；节余按第十二条纳入公司管理。</p>
      </div>
    </div>
    <div class="card">
      <header><h3>奖金实发构成</h3><span class="eyebrow">年累 · 元</span></header>
      <div class="body"><div class="scroll"><table id="payTbl"></table></div>
        <p class="sub" style="margin:10px 0 0">大港油区安效奖与机关基础月奖本表为 0，需确认是未发放还是未并入本表统计。</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ 02 单井考核 ============ -->
<section class="page" id="p-well">
  <div class="phead">
    <div>
      <h2>单井考核</h2>
    </div>
    <div class="discs">
      <button class="disc" id="formToggle" type="button"></button>
      <button class="disc" id="viewToggle" type="button"></button>
    </div>
  </div>

  <div class="wellwrap">
    <div class="wellsplit">
      <div class="wellcol">
        <div class="card wellhead">
          <div class="body" style="padding:13px 16px">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
              <div>
                <h3 style="font-size:15.5px">单井参数录入表</h3>
                <div class="sub" id="formHeadSub" style="margin-top:2px"></div>
              </div>
              <div id="wellActions"></div>
            </div>
            <div id="wellMsg" style="margin-top:10px"></div>
          </div>
        </div>
        <div class="card"><div class="body" id="wellForm"></div></div>
      </div>

      <div class="wellcol">
        <div class="card wellhead">
          <div class="body" style="display:flex;align-items:center;justify-content:space-between;gap:14px;padding:13px 16px;flex-wrap:wrap">
            <div>
              <h3 style="font-size:15.5px">单井经营考核表</h3>
              <div class="sub" id="wellHeadSub" style="margin-top:2px"></div>
            </div>
            <div style="display:flex;align-items:center;gap:10px">
              <span class="sub" id="exportMsg"></span>
              <button class="btn" id="exportXls" type="button">导出 Excel</button>
            </div>
          </div>
        </div>
        <div class="infogrid">
          <div class="card"><div class="body" id="infoPanel"></div></div>
          <div class="card"><div class="body" id="diffPanel"></div></div>
          <div class="card"><div class="body" id="footPanel"></div></div>
          <div class="card"><div class="body" id="cycPanel"></div></div>
        </div>

        <div class="card">
          <header><h3>三定额情况</h3><span class="eyebrow">工序 · 米费 · 成本</span></header>
          <div class="body"><div class="scroll"><table id="quotaTbl3"></table></div></div>
        </div>

        <div class="card">
          <header><h3>三专项情况</h3><span class="eyebrow">事故复杂 · 钻井提速 · 单井毛益</span></header>
          <div class="body"><div class="scroll"><table id="specTbl3"></table></div></div>
        </div>

        <div class="card">
          <header><h3>本井兑现合计</h3><span class="eyebrow">三定额 + 三专项 − 扣减</span></header>
          <div class="body" id="totalPanel"></div>
        </div>

        <div class="card">
          <header><h3>本井已预兑现</h3>
            <button class="btn ghost mini" id="toPreMod" type="button">去预兑现登记 →</button>
          </header>
          <div class="body" id="prePanel"></div>
        </div>

        <div class="card">
          <header><h3>本井终考核兑现</h3><span class="eyebrow">兑现合计 − 已预兑现</span></header>
          <div class="body" id="finalPanel"></div>
        </div>
      </div>
    </div>

    <div class="card wellfoot">
      <header><h3>完成井考核库</h3>
        <div style="display:flex;align-items:center;gap:12px">
          <span class="eyebrow" id="storeCount"></span>
          <button class="disc" id="storeToggle" type="button"></button>
        </div>
      </header>
      <div class="body">
        <div class="scroll"><table id="wellStoreTbl"></table></div>
        <p class="sub" style="margin:10px 0 0">「入库时兑现」为提交时快照，「现行定额兑现」按当前定额库重算——不一致须经考核办公室确认后重新提交。</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ 03 预兑现登记 ============ -->
<section class="page" id="p-pre">
  <div class="phead">
    <div>
      <h2>预兑现登记</h2>
      <p>按当月实际进尺与已签证工序计提，完井时并入终考核清算。</p>
    </div>
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
      <span class="eyebrow">登记井</span>
      <select id="preWellSel" style="background:var(--surface-2);border:1px solid transparent;border-radius:7px;padding:6px 10px"></select>
      <span class="eyebrow">兑现月份</span>
      <select id="preMonth" style="background:var(--surface-2);border:1px solid transparent;border-radius:7px;padding:6px 10px"></select>
      <button class="btn" id="preAdd" type="button">登记本月预兑现</button>
    </div>
  </div>

  <div id="preMsg"></div>
  <div id="preSettle"></div>

  <div class="card" style="margin-top:16px">
    <header><h3>本井预兑现明细</h3><span class="eyebrow" id="preWellLabel"></span></header>
    <div class="body"><div class="scroll"><table id="preTbl"></table></div></div>
  </div>

  <div class="card" style="margin-top:16px">
    <header><h3>月度应发汇总</h3><span class="eyebrow">按队号 × 月份 · 实际发放口径</span></header>
    <div class="body">
      <div class="scroll"><table id="teamMonthTbl"></table></div>
      <p class="sub" style="margin:9px 0 0">同一支队伍当月多口井合并为一行汇总应发；跨队接替可逐月改「承担队号」，历史月份仍归原队。</p>
    </div>
  </div>

  <div class="card" style="margin-top:16px">
    <header><h3>队伍挂账结转</h3><span class="eyebrow">附件2 七（四）</span></header>
    <div class="body">
      <div class="scroll"><table id="teamSettleTbl"></table></div>
      <p class="sub" style="margin-top:12px">成本节超与三专项须完井后判定，默认不预发。预兑现<b>按预支处理</b>：完井全额扣回，扣不回转队伍挂账。</p>
    </div>
  </div>
</section>

<!-- ============ 04 定额库 ============ -->
<section class="page" id="p-quota">
  <div class="phead">
    <div>
      <h2>定额库</h2>
      <p>附件1 全量定额标准，按「井型—区块—开次」索引。</p>
    </div>
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
      <span class="pill ai" id="quotaVer" style="white-space:nowrap"></span>
      <button class="btn ghost" id="quotaSaveVer" type="button" title="把当前定额快照保存为新版本（版本号自动递增）">保存版本</button>
      <select id="quotaVerSel" title="历史版本（恢复后覆盖当前定额）" style="background:var(--surface-2);border:1px solid var(--line);border-radius:2px;padding:5px 9px;max-width:220px"></select>
      <button class="btn ghost" id="quotaLoadVer" type="button" disabled>恢复所选</button>
      <input type="search" id="qSearch" placeholder="搜索区块 / 井型…" style="background:var(--surface-2);border:1px solid var(--line);border-radius:2px;padding:5px 9px;width:180px">
      <div class="seg" id="qSeg"></div>
    </div>
  </div>
  <div class="duo" style="margin-top:14px">
    <div class="card"><div class="body"><div class="scroll"><table id="quotaTbl"></table></div></div></div>
    <div class="card">
      <header><h3>定额缺口告警</h3><span class="eyebrow">附件1</span></header>
      <div class="body">
        <p class="sub" style="margin:0 0 8px">下列组合定额为空，须按「条件相近、相邻区块」临时套用并留痕。</p>
        <div class="scroll"><table id="gapTbl"></table></div>
      </div>
    </div>
  </div>

  <div class="card" style="margin-top:14px">
    <header><h3>一井一策定额补充</h3>
      <div style="display:flex;align-items:center;gap:10px">
        <span class="sub" id="owpMsg"></span>
        <span class="eyebrow">同区块 ≥2 口井 · 中位数补入</span>
      </div>
    </header>
    <div class="body">
      <p class="sub" style="margin:0 0 8px">按「井型—区块—开次」分组，样本满 2 口取中位数生成建议；已有附件1定额不被覆盖。</p>
      <div class="scroll"><table id="owpTbl"></table></div>
    </div>
  </div>
</section>

<!-- ============ 05 滚动定额 ============ -->
<section class="page" id="p-roll">
  <div class="phead">
    <div>
      <h2>滚动定额</h2>
      <p>每月完成井自动入库，剔除异常样本后滚动重算区块定额与专项指标。</p>
    </div>
    <div style="display:flex;gap:8px;align-items:center">
      <span class="eyebrow">考核月</span>
      <select id="rollMonth" style="background:var(--surface-2);border:1px solid var(--line);border-radius:2px;padding:5px 9px"></select>
    </div>
  </div>

  <div class="kpis" id="rollKpi"></div>

  <div class="split" style="margin-top:16px">
    <div class="grid sticky">
      <div class="card">
        <header><h3>滚动参数</h3><span class="eyebrow">考核办公室配置</span></header>
        <div class="body" id="rollCfg"></div>
      </div>
      <div class="card">
        <header><h3>异常井剔除规则</h3><span class="eyebrow">入库前置校验</span></header>
        <div class="body" id="rollRules"></div>
      </div>
    </div>

    <div class="grid">
      <div class="card">
        <header><h3>本月入库井</h3><span class="eyebrow" id="rollMonthLabel"></span></header>
        <div class="body"><div class="scroll"><table id="intakeTbl"></table></div>
          <p class="sub" style="margin:9px 0 0">被剔除的井仍正常兑现，只是不参与定额测算。</p>
        </div>
      </div>
      <div class="card">
        <header><h3>定额调整建议单</h3>
          <div style="display:flex;gap:6px">
            <button class="btn ghost" id="rollReset">恢复上版定额</button>
            <button class="btn" id="rollApply">应用到定额库</button>
          </div>
        </header>
        <div class="body">
          <div class="scroll"><table id="rollTbl"></table></div>
          <p class="sub" style="margin:9px 0 0">变动率按钻井队视角着色：<span class="neg">红＝定额收紧</span>（更难拿到成本绩效）、<span class="pos">绿＝定额放宽</span>。毛益率为指标非定额，按百分点（pp）显示。「触顶」表示测算值超出单期变动上限，已被截断。</p>
          <div class="note" style="margin-top:11px" id="ratchetNote"></div>
        </div>
      </div>
      <div class="card">
        <header><h3>专项指标同步</h3><span class="eyebrow">毛益率 · 日进尺 · 事故复杂率</span></header>
        <div class="body"><div class="scroll"><table id="specTbl"></table></div></div>
      </div>
    </div>
  </div>
</section>

<!-- ============ 05 班子绩效 ============ -->
<section class="page" id="p-team">
  <div class="phead">
    <div>
      <h2>钻井队班子绩效</h2>
      <p>经营 85 分 + 党建 15 分；排名第一为基数差额发放，末位为基数 50%，按有效钻机利用率与岗位系数分解到人。</p>
    </div>
    <div class="fld" style="margin:0"><label>队长兑现基数（元）</label><input type="number" id="teamBase" value="120000" step="1000" style="width:140px"></div>
  </div>
  <div class="card"><div class="body"><div class="scroll"><table id="teamTbl"></table></div>
    <p class="sub" style="margin:10px 0 0">岗位系数：队长 100% · 书记/第一技术员 80% · 第二技术员 60% · 副队长 50% · 其他技术员 30% · 新聘任不满一年 20% · 大班与电气师按队长的 15~30% 由装备管理部核定。</p>
  </div></div>
  <div class="card" style="margin-top:14px">
    <header><h3>岗位分解</h3><span class="eyebrow">按当前排名第一队测算</span></header>
    <div class="body"><div class="scroll"><table id="postTbl"></table></div></div>
  </div>
</section>

<!-- ============ 06 机制优化 ============ -->
<section class="page" id="p-road">
  <div class="phead">
    <div>
      <h2>机制优化建议</h2>
      <p>沿用「三定额 + 三专项」主干不变，针对现行办法在数据可信度、口径一致性与兑现时效上的六个薄弱点提出系统化改造方向。</p>
    </div>
  </div>
  <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(330px,1fr))" id="roadGrid"></div>
</section>

</main>
</div>

<script>
const Q = {"blocks":[{"wellType":"定向井","block":"唐家河","phase":2,"mifei":0.35,"mat50":13.06,"mat70":14.81,"energy":53.77,"lube":4.3,"repair":2.05,"prodwater":4.03,"sewage":2.05,"dayfoot":162.661224},{"wellType":"定向井","block":"孔店","phase":2,"mifei":0.51,"mat50":19.01,"mat70":21.55,"energy":34.48,"lube":6.26,"repair":2.98,"sewage":2.98,"dayfoot":111.772819},{"wellType":"定向井","block":"扣村","phase":2,"mifei":0.28,"mat50":10.23,"mat70":11.6,"energy":50.17,"lube":3.37,"repair":1.61,"sewage":1.61,"dayfoot":207.666667},{"wellType":"定向井","block":"新华","phase":2,"mifei":0.42,"mat50":15.54,"mat70":17.61,"energy":108.49,"lube":5.12,"repair":2.44,"sewage":2.44,"dayfoot":136.773898},{"wellType":"定向井","block":"板桥（≥3500米）","phase":2,"mifei":0.48,"mat50":17.76,"mat70":20.13,"energy":86.94,"lube":5.85,"repair":2.79,"prodwater":4.6,"sewage":2.79,"dayfoot":119.660584,"gm_avg":0.08277,"gm_110":0.091047,"gm_120":0.099324},{"wellType":"定向井","block":"板桥（＜2500米）","phase":2,"mifei":0.36,"mat50":13.43,"mat70":15.22,"energy":73.48,"lube":4.42,"repair":2.11,"sewage":2.11,"dayfoot":158.28},{"wellType":"定向井","block":"板桥（＜3500米）","phase":2,"mifei":0.35,"mat50":13.06,"mat70":14.8,"energy":70.23,"lube":4.3,"repair":2.05,"prodwater":4.06,"sewage":2.05,"dayfoot":162.770428,"gm_avg":0.025738,"gm_110":0.028312,"gm_120":0.030885},{"wellType":"定向井","block":"枣园","phase":2,"mifei":0.38,"mat50":14.24,"mat70":16.14,"energy":83.74,"lube":4.69,"repair":2.23,"sewage":2.23,"dayfoot":149.197183,"gm_avg":0.09268,"gm_110":0.101948,"gm_120":0.111216},{"wellType":"定向井","block":"港东","phase":2,"mifei":0.3,"mat50":11.14,"mat70":12.63,"energy":46.2,"lube":3.67,"repair":1.75,"prodwater":3.97,"sewage":1.75,"dayfoot":190.756477},{"wellType":"定向井","block":"港中","phase":2,"mifei":0.39,"mat50":14.3,"mat70":16.21,"energy":63.77,"lube":4.71,"repair":2.24,"prodwater":3.58,"sewage":2.24,"dayfoot":148.567568},{"wellType":"定向井","block":"港西","phase":2,"mifei":0.44,"mat50":16.29,"mat70":18.46,"energy":65.01,"lube":5.37,"repair":2.56,"prodwater":4.4,"sewage":2.56,"dayfoot":130.462366,"gm_avg":0.105415,"gm_110":0.115956,"gm_120":0.126498},{"wellType":"定向井","block":"王官屯","phase":2,"mifei":0.51,"mat50":18.92,"mat70":21.44,"energy":74.17,"lube":6.23,"repair":2.97,"sewage":2.97,"dayfoot":112.336134,"gm_avg":0.160395,"gm_110":0.176434,"gm_120":0.192474},{"wellType":"定向井","block":"王徐庄","phase":2,"mifei":0.37,"mat50":13.78,"mat70":15.61,"energy":79.33,"lube":4.54,"repair":2.16,"sewage":2.16,"dayfoot":154.25},{"wellType":"定向井","block":"羊三木","phase":2,"mifei":0.43,"mat50":16.08,"mat70":18.23,"energy":82.65,"lube":5.3,"repair":2.52,"sewage":2.52,"dayfoot":132.142857},{"wellType":"定向井","block":"羊二庄","phase":2,"mifei":0.29,"mat50":10.62,"mat70":12.04,"energy":49.91,"lube":3.5,"repair":1.67,"sewage":1.67,"dayfoot":200.090909},{"wellType":"水平井","block":"埕海","phase":2,"mifei":0.46,"mat50":17.21,"mat70":19.51,"energy":125.79,"lube":5.67,"repair":2.7,"sewage":2.7,"dayfoot":123.443255},{"wellType":"水平井","block":"大港页岩油","phase":2,"mifei":0.31,"mat50":11.5,"mat70":13.03,"energy":100.29,"lube":3.79,"repair":1.8,"sewage":1.8,"dayfoot":184.771234,"gm_avg":-0.063116,"gm_110":-0.056804,"gm_120":-0.050493},{"wellType":"水平井","block":"板桥","phase":2,"mifei":0.36,"mat50":13.33,"mat70":15.11,"energy":64.66,"lube":4.39,"repair":2.09,"prodwater":4.05,"sewage":2.09,"dayfoot":159.426552,"gm_avg":0.167215,"gm_110":0.183937,"gm_120":0.200658},{"wellType":"水平井","block":"枣园","phase":2,"mifei":0.59,"mat50":22.08,"mat70":25.02,"energy":88.24,"lube":7.27,"repair":3.46,"sewage":3.46,"dayfoot":96.240602},{"wellType":"定向井","block":"唐东（开发井）","phase":3,"mifei":0.36,"mat50":12.51,"mat70":14.18,"energy":110.08,"lube":4.38,"repair":2.09,"prodwater":3.76,"sewage":2.09,"dayfoot":159.830245,"gm_avg":0.237198,"gm_110":0.260918,"gm_120":0.284638},{"wellType":"定向井","block":"唐东（探评井）","phase":3,"mifei":0.43,"mat50":15.19,"mat70":17.21,"energy":138.54,"lube":5.32,"repair":2.53,"prodwater":5.93,"sewage":2.53,"dayfoot":131.690109,"gm_avg":0.06267,"gm_110":0.068936,"gm_120":0.075203},{"wellType":"定向井","block":"埕海（≥4000米）","phase":3,"mifei":0.38,"mat50":13.33,"mat70":15.11,"energy":114.65,"lube":4.67,"repair":2.22,"sewage":2.22,"dayfoot":150.021132,"gm_avg":0.422566,"gm_110":0.464822,"gm_120":0.507079},{"wellType":"定向井","block":"埕海（＜4000米）","phase":3,"mifei":0.32,"mat50":11.31,"mat70":12.82,"energy":103.71,"lube":3.96,"repair":1.88,"sewage":1.88,"dayfoot":176.861718,"gm_avg":0.33304,"gm_110":0.366344,"gm_120":0.399647},{"wellType":"定向井","block":"大港页岩油","phase":3,"mifei":0.6,"mat50":20.9,"mat70":23.69,"energy":145.98,"lube":7.32,"repair":3.48,"sewage":3.48,"dayfoot":95.692308},{"wellType":"定向井","block":"新华","phase":3,"mifei":0.47,"mat50":16.49,"mat70":18.69,"energy":133.6,"lube":5.77,"repair":2.75,"sewage":2.75,"dayfoot":121.289499,"gm_avg":0.190146,"gm_110":0.209161,"gm_120":0.228175},{"wellType":"定向井","block":"板桥","phase":3,"mifei":0.45,"mat50":15.76,"mat70":17.86,"energy":90.52,"lube":5.52,"repair":2.63,"prodwater":4.27,"sewage":2.63,"dayfoot":126.891156,"gm_avg":0.0999,"gm_110":0.10989,"gm_120":0.11988},{"wellType":"定向井","block":"歧口","phase":3,"mifei":0.7,"mat50":24.43,"mat70":27.69,"energy":142.9,"lube":8.55,"repair":4.07,"sewage":4.07,"dayfoot":81.857143},{"wellType":"定向井","block":"港东","phase":3,"mifei":0.77,"mat50":26.84,"mat70":30.42,"energy":43.63,"lube":9.39,"repair":4.47,"sewage":4.47,"dayfoot":74.520265},{"wellType":"水平井","block":"唐东","phase":3,"mifei":0.46,"mat50":15.99,"mat70":18.12,"energy":152.16,"lube":5.6,"repair":2.67,"prodwater":6.27,"sewage":2.67,"dayfoot":125.069578},{"wellType":"水平井","block":"埕海","phase":3,"mifei":0.43,"mat50":15.09,"mat70":17.1,"energy":125.79,"lube":5.28,"repair":2.51,"sewage":2.51,"dayfoot":132.548387},{"wellType":"水平井","block":"大港页岩油","phase":3,"mifei":0.51,"mat50":17.87,"mat70":20.25,"energy":166.11,"lube":6.25,"repair":2.98,"sewage":2.98,"dayfoot":111.915167,"gm_avg":0.00749,"gm_110":0.008239,"gm_120":0.008988},{"wellType":"水平井","block":"板桥","phase":3},{"wellType":"定向井","block":"板桥","phase":4,"mifei":0.6,"mat50":21.11,"mat70":23.92,"energy":137.05,"lube":7.39,"repair":3.52,"prodwater":5.81,"sewage":3.52,"dayfoot":94.743216,"gm_avg":0.300482,"gm_110":0.33053,"gm_120":0.360578}],"process":[{"name":"搬迁拆卸","unit":"元/井次","rate":7245.33,"note":""},{"name":"平移拆卸","unit":"元/井次","rate":1811.33,"note":""},{"name":"搬迁转场(腾井场）","unit":"元/井次","rate":3622.67,"note":""},{"name":"搬安（50型）","unit":"元/井次","rate":16302.0,"note":"冬季上浮20%"},{"name":"搬安（70型）","unit":"元/井次","rate":21736.0,"note":"冬季上浮20%"},{"name":"平移","unit":"元/井次","rate":3622.67,"note":""},{"name":"砌方井","unit":"元/井次","rate":1811.33,"note":""},{"name":"摆基础","unit":"元/井次","rate":1811.33,"note":""},{"name":"配合安装泥浆不落地","unit":"元/井次","rate":1811.33,"note":""},{"name":"顶驱拆装","unit":"元/井次","rate":5434.0,"note":""},{"name":"机械手拆装","unit":"元/井次","rate":5434.0,"note":""},{"name":"冬防保温（自保温）","unit":"元/井次","rate":3622.67,"note":""},{"name":"油基泥浆施工","unit":"元/台月","rate":6000.0,"note":""},{"name":"设备配套","unit":"元/天·人","rate":104.87,"note":"配套15天后按60%标准发放"}],"geomembrane":[{"proc":"搬迁","rig":"50型","rate":11500.5},{"proc":"搬迁","rig":"70型","rate":12546.0},{"proc":"平移","rig":"通用","rate":4182.0}],"rigs":[{"team":"50639","rigType":"50LD","kType":1.023258,"kRepair":1.5},{"team":"50537","rigType":"50J","kType":0.687713,"kRepair":1.35},{"team":"50998","rigType":"50J","kType":0.528737,"kRepair":1.35},{"team":"70520","rigType":"70LD","kType":1.372692,"kRepair":1.5},{"team":"70111","rigType":"70D","kType":0.908971,"kRepair":1.05},{"team":"70152","rigType":"70D","kType":0.835918,"kRepair":1.05},{"team":"70316","rigType":"70D","kType":0.896555,"kRepair":0.42},{"team":"70318","rigType":"70DB","kType":1.084256,"kRepair":0.42},{"team":"70315","rigType":"70DB","kType":0.917161,"kRepair":0.28},{"team":"BH70302","rigType":"70DB","kType":1.013156,"kRepair":0.7}]};
let BACKEND_MODE=false; // 提前声明：saveWells/saveDS 里会引用它，若声明晚于这两个函数首次被同步调用（如启动时自动写入示例井），会因暂时性死区中断整个脚本

/* ============================ 常量 ============================ */
const PRICE = { diesel:7000, oil:20000, elec:1, sewage:100 };     // 量价分离单价
const E2O_KWH = 10000/2.67;                                       // 电代油：柴油按 2.67 吨/万度折合电量（度/吨）
const E2O_DIESEL_PRICE = Math.round(E2O_KWH*PRICE.elec);          // 折合后柴油当量单价 ≈3745 元/吨
const COST_KEYS = ['mat','energy','lube','repair','prodwater','sewage','geo'];
const COST_LABEL = { mat:'一般材料费', energy:'能耗（网电/柴油）', lube:'润滑油', repair:'项修', prodwater:'生产水', sewage:'生活污水拉运', geo:'土工膜' };
const fmt = (n,d=0)=> (n==null||isNaN(n)) ? '—' : Number(n).toLocaleString('zh-CN',{minimumFractionDigits:d,maximumFractionDigits:d});
const pct = (n,d=1)=>{ if(n==null||isNaN(n)) return '—'; const f=Math.pow(10,d); return (Math.round((n*100+Number.EPSILON)*f)/f).toFixed(d)+'%'; };
const $  = s=>document.querySelector(s);
const el = (t,c,h)=>{const e=document.createElement(t); if(c)e.className=c; if(h!=null)e.innerHTML=h; return e;};

/* ============================ 状态 ============================ */
const S = {
  prov:{},                                // 字段来源 {src, conf, evidence}
  w:{
    wellNo:'', team:'70318', wellType:'水平井', block:'大港页岩油', phase:2,
    footage:0, cycleDays:0, crewStd:38, planDays:0, difficulty:1,
    keyExpl:false, horizLen:0, displacement:0, vertDepth:0, techCasing:0,
    dayrate:false, dayrateRatio:100, winter:false, e2o:false, diesel:true,
    testDays:0, coreDays:0, kickDays:0, lossDays:0, sidetrack:0, waitDays:0,
    proc:{}, geoMove:false, geoShift:false,
    matAct:0, elecKwh:0, dieselTon:0, oilTon:0, repairAct:0, prodWaterAct:0, sewageM3:0, geoAct:0, costAdjust:0,
    hasAccident:false, accidentCost:0, grossMargin:0,
    qualityDeduct:0, damageDeduct:0,
    oneWellOnePolicy:false, custom:{}
  }
};
const SRC_LABEL = { sys:'系统直采', ai:'AI解析', man:'人工录入' };
function src(k){ return (S.prov[k]&&S.prov[k].src) || 'man'; }
function setSrc(k,s,conf,ev){ S.prov[k]={src:s,conf:conf,evidence:ev}; }

/* 系统直采字段：来自生产/财务/人资系统，不经人工填报 */
['team','wellType','block','phase','footage','crewStd','planDays','elecKwh','dieselTon','oilTon','cycleDays']
  .forEach(k=>setSrc(k,'sys'));

/* ============================ 定额检索 ============================ */
function findBlock(t,b,p){ return Q.blocks.find(x=>x.wellType===t&&x.block===b&&x.phase===Number(p)) || {}; }
function rigOf(team){ return Q.rigs.find(r=>r.team===team) || {kType:1,kRepair:1,rigType:'—'}; }
function is70(team){ return /^7|^BH7/.test(rigOf(team).rigType) || /70/.test(rigOf(team).rigType); }

/* ============================ 计算引擎 ============================ */
function calc(wIn){
  const w=wIn||S.w;
  const B = w.oneWellOnePolicy ? Object.assign({},w.custom) : findBlock(w.wellType,w.block,w.phase);
  const R=rigOf(w.team);
  const big70 = /70/.test(R.rigType);
  const K = Number(w.difficulty)||1;

  // —— 考核进尺 = 实际进尺 + 折算进尺 ——
  // 折算系数：试油/完井 0.5、取心 1.0、井控 0.7、井漏 0.3
  const testK = 0.5, coreK = 1.0, kickK = 0.7, lossK = 0.3;
  const dayfoot = B.dayfoot || 0;
  const convTest = (+w.testDays||0)*testK*dayfoot;   // 试油折算进尺
  const convCore = (+w.coreDays||0)*coreK*dayfoot;   // 取心折算进尺
  const convKick = (+w.kickDays||0)*kickK*dayfoot;   // 井控折算进尺
  const convLoss = (+w.lossDays||0)*lossK*dayfoot;   // 井漏折算进尺
  const convDays = (+w.testDays||0)*testK + (+w.coreDays||0)*coreK + (+w.kickDays||0)*kickK + (+w.lossDays||0)*lossK;
  const convFoot = convTest + convCore + convKick + convLoss;
  const footEval = (+w.footage||0) + convFoot + (+w.sidetrack||0);

  // —— ① 工序定额 ——
  const procRows=[]; let procSum=0;
  Q.process.forEach((p,i)=>{
    const n = +(w.proc[i]||0); if(!n) return;
    let rate = p.rate, amt, note='';
    if(/搬安/.test(p.name) && w.winter) rate *= 1.2;
    if(p.name==='设备配套' && n > 15*(+w.crewStd||1)){
      const full=15*(+w.crewStd||1);            // 附件1-5：配套15天后按60%标准发放（元/天·人）
      amt = rate*(full + (n-full)*0.6);
      note='配套'+fmt(full,0)+' 人·天后按60%';
    } else {
      amt = rate*n;
    }
    procSum += amt;
    procRows.push({name:p.name, unit:p.unit, base:rate, qty:n, amt, note});
  });

  // —— ② 米费定额 ——
  const dayK = w.dayrate ? (w.dayrateRatio>=100?1.2 : w.dayrateRatio>=97?1.0 : 0.8) : 1;
  const mifei = B.mifei||0;
  const mifeiAmt = footEval * mifei * (+w.crewStd) * K * dayK;

  // —— ③ 成本定额 ——
  // 计取基数与考核进尺同口径——一律用折算后进尺，不得用原始「天数×日进尺」：
  //   实际进尺 + 侧钻 + 井控/井漏折算进尺 —— 各项成本定额全额计提
  //   取心折算进尺 —— 所有成本定额（含网电）按 60% 核算
  //   试油折算进尺 —— 网电按 40%，其它各项成本定额按 20% 核算
  const normalMeters = (+w.footage||0) + (+w.sidetrack||0) + convKick + convLoss;
  const energyMeters = normalMeters + convTest*0.4 + convCore*0.6;   // 网电：试油40% · 取心60%
  const otherMeters  = normalMeters + convTest*0.2 + convCore*0.6;   // 其它成本：试油20% · 取心60%
  const winterEnergyK = (w.winter && w.diesel) ? 1.10 : 1;          // 冬季使用柴油施工上浮10%（网电施工不再上浮）
  const geoRate = (w.geoMove ? (big70?12546:11500.5) : 0) + (w.geoShift ? 4182 : 0);
  const std = {
    mat:       (big70? (B.mat70||0) : (B.mat50||0)) * otherMeters * K,
    energy:    (B.energy||0) * energyMeters * K * winterEnergyK,
    lube:      (B.lube||0) * otherMeters * R.kType * (w.e2o?0.3:1),
    repair:    (B.repair||0) * otherMeters * R.kRepair,
    prodwater: (B.prodwater||0) * otherMeters,
    sewage:    (B.sewage||0) * otherMeters,
    geo:       geoRate
  };
  const act = {
    mat: +w.matAct,
    energy: (+w.elecKwh)*PRICE.elec + (+w.dieselTon)*E2O_DIESEL_PRICE,  // 柴油统一按 2.67吨=1万度 折合电度数（1元/度）
    lube: (+w.oilTon)*PRICE.oil,
    repair: +w.repairAct,
    prodwater: +w.prodWaterAct,
    sewage: (+w.sewageM3)*PRICE.sewage,
    geo: +w.geoAct
  };
  let stdSum=0, actSum=0;
  COST_KEYS.forEach(k=>{ stdSum+=std[k]; actSum+=act[k]; });
  const costAdjust = +w.costAdjust||0;      // 成本实际消耗调整金额（±）
  actSum += costAdjust;
  const saving = stdSum - actSum;
  const costAmt = saving * 0.8;

  // 等停能耗补偿：0.2 吨/天 × 柴油当量单价 × 等停天数（附件1-8 注释），直接给予钻井队
  const dieselPrice = E2O_DIESEL_PRICE;                        // 柴油当量单价（折合电度数），不再区分是否电代油
  const waitComp = 0.2 * dieselPrice * (+w.waitDays||0);

  const quotaSum = procSum + mifeiAmt + costAmt + waitComp;

  // —— 三专项 ——
  const rm = (+w.cycleDays||0)/30;
  let accAmt, accNote;
  if(!w.hasAccident){ accAmt = 20000*rm; accNote='完成井无事故复杂，一次性奖励 20000 元/台月'; }
  else { accAmt = -10000*rm; accNote='发生事故复杂，按 10000 元/台月定额核减'; }

  const spdRate = 30000;
  const actDays=+w.cycleDays||0, planDays=+w.planDays||0;
  const speedMet = planDays>0 ? actDays<=planDays : true;
  const spdAmt = speedMet ? spdRate*rm : -(spdRate/2)*rm;

  const gmRaw=+w.grossMargin||0;
  const gm=gmRaw/100;                                          // 输入为百分比，内部统一小数域
  const gAvg = B.gm_avg!=null ? (w.oneWellOnePolicy? B.gm_avg/100 : B.gm_avg) : null;
  const g110 = B.gm_110!=null ? B.gm_110 : (gAvg!=null? gAvg*1.1 : null);
  const g120 = B.gm_120!=null ? B.gm_120 : (gAvg!=null? gAvg*1.2 : null);
  let gmAmt=0, gmNote='区块无毛益率指标';
  if(gmRaw===0){ gmAmt=0; gmNote='毛益率为 0，待下月考核'; }
  else if(gAvg!=null){
    if(g120!=null && gm>=g120){ gmAmt=20000*rm; gmNote='达区块指标 120%'; }
    else if(g110!=null && gm>=g110){ gmAmt=10000*rm; gmNote='达区块指标 110%'; }
    else if(gm<gAvg){ gmAmt=-10000*rm; gmNote='低于区块平均指标'; }
    else { gmAmt=0; gmNote='达平均未达 110%'; }
  }
  const specSum = accAmt + spdAmt + gmAmt;

  const gross = quotaSum + specSum;
  const dedCap = Math.abs(gross)*0.3;
  const qDed = Math.min(+w.qualityDeduct, dedCap);
  const total = gross - qDed - (+w.damageDeduct);

  return {B,R,big70,K,dayK,convDays,convFoot,convTest,convCore,convKick,convLoss,footEval,procRows,procSum,mifei,mifeiAmt,speedMet,actDays,planDays,
          normalMeters,energyMeters,otherMeters,winterEnergyK,
          std,act,stdSum,actSum,saving,costAmt,quotaSum,
          gmRaw,gm,gAvg,g110,g120,
          dieselPrice,waitComp,costAdjust,
          accAmt,accNote,spdAmt,spdRate,gmAmt,gmNote,specSum,gross,qDed,dedCap,total};
}

/* 难度系数规则建议 */
function diffSuggest(){
  const w=S.w, hits=[];
  if(w.keyExpl) hits.push(['重点探井',0.10]);
  if(+w.horizLen>2000) hits.push([`水平段 ${fmt(w.horizLen)} m ＞ 2000 m`,0.10]);
  if(+w.displacement>2500) hits.push([`位移 ${fmt(w.displacement)} m ＞ 2500 m`,0.08]);
  const ratio = (+w.vertDepth>0) ? (+w.displacement)/(+w.vertDepth) : 0;
  if(ratio>2.0) hits.push([`水垂比 ${ratio.toFixed(2)} ＞ 2.0`,0.08]);
  if(+w.techCasing>3500) hits.push([`技套下深 ${fmt(w.techCasing)} m ＞ 3500 m`,0.08]);
  const k = 1 + hits.reduce((s,h)=>s+h[1],0);
  return {hits, k:Math.round(k*100)/100, ratio};
}

/* ============================ 表单渲染 ============================ */
const F = [
  {leg:'基础信息', rows:[
    [{k:'wellNo',l:'井号',t:'text'},{k:'team',l:'队号',t:'select',opt:Q.rigs.map(r=>r.team)}],
    [{k:'wellType',l:'井型',t:'select',opt:['定向井','水平井','直井']},{k:'block',l:'区块',t:'combo'},{k:'phase',l:'开次',t:'select',opt:[2,3,4]}],
    [{k:'oneWellOnePolicy',l:'一井一策（未涵盖区块）',t:'chk'}]
  ]},
  {leg:'工作量与周期', rows:[
    [{k:'footage',l:'实际进尺（米）',t:'num'},{k:'cycleDays',l:'钻完井周期（天）',t:'num',step:.1}],
    [{k:'crewStd',l:'定员标准（人）',t:'num'},{k:'planDays',l:'策划周期（天）',t:'num',step:.1}],
    [{k:'testDays',l:'试油/完井（天）×0.5',t:'num',step:.1},{k:'coreDays',l:'取心（天）×1.0',t:'num',step:.1}],
    [{k:'kickDays',l:'气水侵溢流（天）×0.7',t:'num',step:.1},{k:'lossDays',l:'井漏/事故复杂（天）×0.3',t:'num',step:.1}],
    [{k:'sidetrack',l:'认可侧钻报废进尺（米）',t:'num'},{k:'difficulty',l:'难度系数',t:'num',step:.01}],
    [{k:'waitDays',l:'等停（天）×0.2吨/天补偿',t:'num',step:.1}]
  ]},
  {leg:'难度判定参数', rows:[
    [{k:'horizLen',l:'水平段长（米）',t:'num'},{k:'displacement',l:'水平位移（米）',t:'num'},{k:'vertDepth',l:'垂深（米）',t:'num'}],
    [{k:'techCasing',l:'技套下深（米）',t:'num'},{k:'keyExpl',l:'重点探井',t:'chk'}]
  ]},
  {leg:'工况开关', rows:[
    [{k:'winter',l:'冬季施工',t:'chk'},{k:'e2o',l:'电代油钻井队',t:'chk'},{k:'diesel',l:'柴油动力',t:'chk'}],
    [{k:'dayrate',l:'日费井',t:'chk'},{k:'dayrateRatio',l:'日费率（%）',t:'num',step:.1}],
    [{k:'geoMove',l:'土工膜·搬迁',t:'chk'},{k:'geoShift',l:'土工膜·平移',t:'chk'}]
  ]},
  {leg:'成本实际消耗', rows:[
    [{k:'matAct',l:'一般材料费（元）',t:'num'},{k:'repairAct',l:'项修费用（元）',t:'num'}],
    [{k:'elecKwh',l:'网电（度）@1元',t:'num'},{k:'dieselTon',l:'柴油（吨）@折合电量',t:'num',step:.01}],
    [{k:'oilTon',l:'机油（吨）@20000元',t:'num',step:.001},{k:'sewageM3',l:'生活污水（方）@100元',t:'num'}],
    [{k:'prodWaterAct',l:'生产水（元）',t:'num'},{k:'geoAct',l:'土工膜实际（元）',t:'num'}],
    [{k:'costAdjust',l:'调整金额（元，+增成本/−冲减）',t:'num'}]
  ]},
  {leg:'专项与扣减', rows:[
    [{k:'hasAccident',l:'发生事故复杂',t:'chk'},{k:'accidentCost',l:'处理费用（元，备查，不参与核算）',t:'num'}],
    [{k:'grossMargin',l:'单井毛益率（%，0=待下月考核）',t:'num',step:.01}],
    [{k:'qualityDeduct',l:'井筒质量扣款（元）',t:'num'},{k:'damageDeduct',l:'工具损毁赔偿（元）',t:'num'}]
  ]}
];

function field(f){
  const k=f.k, v=S.w[k], s=src(k);
  const d=el('div','fld'); d.dataset.src=s;
  const p=S.prov[k];
  const tip = p&&p.evidence ? ` title="依据：${p.evidence.replace(/"/g,'&quot;')}"` : '';
  const conf = p&&p.conf!=null ? ` ${Math.round(p.conf*100)}%` : '';
  d.innerHTML = `<label>${f.l}<span class="pill ${s}"${tip}>${SRC_LABEL[s]}${conf}</span></label>`;
  let inp;
  if(f.t==='chk'){
    inp=el('div','chk'); inp.innerHTML=`<input type="checkbox" id="f_${k}" ${v?'checked':''}><span>${v?'是':'否'}</span>`;
    inp.querySelector('input').addEventListener('change',e=>{ S.w[k]=e.target.checked; setSrc(k,'man'); render(); });
  } else if(f.t==='select'){
    inp=el('select'); inp.id='f_'+k;
    f.opt.forEach(o=>{ const op=el('option',null,o); op.value=o; if(String(o)===String(v))op.selected=true; inp.appendChild(op); });
    inp.addEventListener('change',e=>{ S.w[k]= (k==='phase')?+e.target.value:e.target.value; setSrc(k,'man'); render(); });
  } else if(f.t==='combo'){
    inp=el('input'); inp.id='f_'+k; inp.type='text'; inp.setAttribute('list','blockList'); inp.value=v||'';
    inp.addEventListener('input',e=>{ S.w[k]=e.target.value; setSrc(k,'man'); renderResults(); });
    inp.addEventListener('change',()=>render());
  } else {
    inp=el('input'); inp.id='f_'+k; inp.type = f.t==='num'?'number':'text'; if(f.step)inp.step=f.step;
    inp.value = v===0&&f.t==='num' ? 0 : v;
    inp.addEventListener('input',e=>{ S.w[k]= f.t==='num' ? (parseFloat(e.target.value)||0) : e.target.value; setSrc(k,'man'); renderResults(); });
    inp.addEventListener('change',()=>render());
  }
  d.appendChild(inp);
  return d;
}

function renderForm(){
  const host=$('#wellForm'); host.innerHTML='';
  const dl=el('datalist'); dl.id='blockList';
  [...new Set(Q.blocks.map(b=>b.block))].sort().forEach(b=>{ const o=el('option',null,null); o.value=b; dl.appendChild(o); });
  host.appendChild(dl);
  F.forEach(g=>{
    const fs=el('fieldset'); fs.appendChild(el('legend',null,g.leg));
    g.rows.forEach(r=>{
      const wrap=el('div', r.length===3?'f3':(r.length===2?'f2':''));
      r.forEach(f=>wrap.appendChild(field(f)));
      fs.appendChild(wrap);
    });
    host.appendChild(fs);
  });
  // 一井一策自定义定额
  if(S.w.oneWellOnePolicy){
    if(!S.w.custom) S.w.custom={};
    const cf=el('fieldset'); cf.appendChild(el('legend',null,'一井一策 · 自定义定额（覆盖区块查表）'));
    const wrap2=el('div','f3');
    [['mifei','米费（元/米·人）',6],['mat50','材料·50型（元/米）',2],['mat70','材料·70型（元/米）',2],
     ['energy','能耗（元/米）',2],['lube','润滑油（元/米）',4],['repair','项修（元/米）',4],
     ['prodwater','生产水（元/米）',4],['sewage','生活污水（元/米）',4],['dayfoot','平均日进尺（米/天）',1],
     ['gm_avg','毛益率平均指标（%）',2]].forEach(([fk,fl,dec])=>{
      const d=el('div','fld'); d.dataset.src='man';
      d.innerHTML='<label>'+fl+'</label>';
      const inp=el('input'); inp.type='number'; inp.step=Math.pow(10,-dec); inp.value=S.w.custom[fk]||0;
      inp.addEventListener('input',e=>{ S.w.custom[fk]=parseFloat(e.target.value)||0; renderResults(); });
      d.appendChild(inp); wrap2.appendChild(d);
    });
    cf.appendChild(wrap2);
    cf.appendChild(Object.assign(el('p','sub'),{textContent:'区块无附件1定额或为新开发区块时启用。填写该井的实测/预算定额，完井后由「定额库 › 一井一策定额补充」页汇总同区块 2 口以上样本，形成正式定额补入定额库。'}));
    host.appendChild(cf);
  }

  // 工序
  const fs=el('fieldset'); fs.appendChild(el('legend',null,'工序定额发生次数'));
  const wrap=el('div','f2');
  Q.process.forEach((p,i)=>{
    const d=el('div','fld'); d.dataset.src='man';
    d.innerHTML=`<label>${p.name}<span class="dim num">${fmt(p.rate,0)} ${p.unit.replace('元/','')}</span></label>`;
    const inp=el('input'); inp.id='f_proc'+i; inp.type='number'; inp.step='0.1'; inp.min='0'; inp.value=S.w.proc[i]||0;
    inp.addEventListener('input',e=>{ S.w.proc[i]=parseFloat(e.target.value)||0; renderResults(); });
    d.appendChild(inp); wrap.appendChild(d);
  });
  fs.appendChild(wrap); host.appendChild(fs);
}

/* ============================ 结果渲染 ============================ */
function row(cells, cls){
  return `<tr class="${cls||''}">`+cells.map((c,i)=>`<td${i===0?'':''}>${c}</td>`).join('')+'</tr>';
}
function money(n){ const c = n>0?'pos':(n<0?'neg':'dim'); return `<span class="${c}">${n>0?'+':''}${fmt(n)}</span>`; }

function renderResults(){
  const c=calc(), w=S.w, R=c.R, ds=diffSuggest();
  const actDays=+w.cycleDays||0, planDays=+w.planDays||0;

  const subTxt=(w.wellNo||'未命名井')+' · '+w.team+' · '+w.wellType+' '+w.block+' '+w.phase+'开';
  if($('#wellHeadSub')) $('#wellHeadSub').textContent=subTxt;
  if($('#formHeadSub')) $('#formHeadSub').textContent=subTxt;

  /* ---- 单井基础信息 ---- */
  $('#infoPanel').innerHTML=
    '<div class="k sub">单井基础信息</div>'+
    '<div class="bignum" style="margin-top:4px">'+(w.wellNo||'未命名井')+'</div>'+
    '<div style="margin-top:9px">'+
    [['钻井队 / 钻机', w.team+' · '+R.rigType],
     ['井型 / 区块 / 开次', w.wellType+' · '+w.block+' · '+w.phase+'开'],
     ['定员标准', (w.crewStd||0)+' 人'],
     ['计价方式', w.dayrate?('日费井 · 日费率 '+fmt(w.dayrateRatio,1)+'%'):'进尺井']
    ].map(x=>'<div class="kv"><span>'+x[0]+'</span><span>'+x[1]+'</span></div>').join('')+'</div>';

  /* ---- 难度系数 ---- */
  const same=Math.abs(ds.k-(+w.difficulty))<0.001;
  $('#diffPanel').innerHTML=
    '<div class="k sub">难度系数</div>'+
    '<div style="display:flex;align-items:baseline;gap:10px;margin-top:4px">'+
      '<div class="bignum">'+(+w.difficulty).toFixed(2)+'</div>'+
      '<span class="pill '+(same?'ai':'bad')+'">'+(same?'与规则一致':'建议 '+ds.k.toFixed(2))+'</span>'+
    '</div>'+
    '<div style="margin-top:8px">'+ (ds.hits.length
        ? ds.hits.map(x=>'<div class="kv"><span>'+x[0]+'</span><span class="pos">+'+x[1].toFixed(2)+'</span></div>').join('')
        : '<div class="kv"><span class="dim">未触发加点规则</span><span>1.00</span></div>')+'</div>'+
    (same?'':'<button class="btn ghost mini" id="applyDiff" style="margin-top:9px">采用建议值 '+ds.k.toFixed(2)+'</button>');
  const ad=$('#applyDiff'); if(ad) ad.onclick=()=>{ S.w.difficulty=ds.k; setSrc('difficulty','sys'); render(); };

  /* ---- 考核进尺 ---- */
  $('#footPanel').innerHTML=
    '<div class="k sub">考核进尺</div>'+
    '<div class="bignum" style="margin-top:4px">'+fmt(c.footEval)+' <span style="font-size:14px;font-weight:500;color:var(--muted)">m</span></div>'+
    '<div style="margin-top:9px">'+
    [['实际进尺', fmt(w.footage)+' m'],
     ['其它工序折算', fmt(c.convFoot)+' m'],
     ['认可侧钻报废', fmt(w.sidetrack)+' m'],
     ['折算周期合计', fmt(c.convDays,1)+' 天']
    ].map(x=>'<div class="kv"><span>'+x[0]+'</span><span>'+x[1]+'</span></div>').join('')+'</div>';

  /* ---- 周期情况 ---- */
  const gap=planDays>0 ? actDays-planDays : null;
  const met=planDays>0 ? actDays<=planDays : null;
  $('#cycPanel').innerHTML=
    '<div class="k sub">周期情况（单位：天）</div>'+
    '<div style="display:flex;align-items:baseline;gap:10px;margin-top:4px">'+
      '<div class="bignum">'+fmt(actDays,1)+'</div>'+
      (met===null?'<span class="pill">未填策划周期</span>'
        :'<span class="pill '+(met?'ai':'bad')+'">'+(met?'完成提速目标':'未完成')+'</span>')+
    '</div>'+
    '<div style="margin-top:9px">'+
    [['钻完井周期', fmt(actDays,1)+' 天'],
     ['折合钻机月', fmt(actDays/30,2)+' 台月（周期 ÷ 30）'],
     ['策划周期', planDays>0?fmt(planDays,1)+' 天':'—'],
     ['差值', gap===null?'—':'<span class="'+(gap<=0?'pos':'neg')+'">'+(gap>0?'+':'')+fmt(gap,1)+' 天</span>']
    ].map(x=>'<div class="kv"><span>'+x[0]+'</span><span>'+x[1]+'</span></div>').join('')+'</div>';

  /* ---- 三定额 ---- */
  let h='<thead><tr><th>考核项</th><th>定额基准</th><th>实际</th><th>差异</th><th>兑现（元）</th></tr></thead><tbody>';
  h+=row(['<strong>① 工序定额</strong>','','','','<strong>'+fmt(c.procSum)+'</strong>'],'grp');
  if(!c.procRows.length) h+=row(['<span class="dim">未发生工序</span>','','','','0']);
  c.procRows.forEach(p=>h+=row(['<span class="sub">'+p.name+(p.note?'（'+p.note+'）':'')+'</span>', fmt(p.base), p.qty+' '+p.unit.replace('元/',''), '', fmt(p.amt)]));
  h+=row(['<strong>② 米费定额</strong>','','','','<strong>'+fmt(c.mifeiAmt)+'</strong>'],'grp');
  h+=row(['<span class="sub">米费定额 × 考核进尺 × 定员 × 难度 × 日费系数</span>',
          (c.mifei?c.mifei.toFixed(6):'<span class="neg">无定额</span>'),
          fmt(c.footEval)+' m', w.crewStd+'人 × '+c.K+' × '+c.dayK, fmt(c.mifeiAmt)]);
  h+=row(['<strong>③ 成本定额</strong>', fmt(c.stdSum), fmt(c.actSum), money(c.saving), '<strong>'+fmt(c.costAmt)+'</strong>'],'grp');
  h+=row(['<span class="sub">核算当量米（折算进尺口径）：网电 '+fmt(c.energyMeters)+' m（试油折算×40% 取心折算×60%）· 其它成本 '+fmt(c.otherMeters)+' m（试油折算×20% 取心折算×60%）'+(c.winterEnergyK>1?' · 冬季柴油上浮10%':'')+'</span>','','','','']);
  COST_KEYS.forEach(k=>{ const d=c.std[k]-c.act[k];
    h+=row(['<span class="sub">'+COST_LABEL[k]+'</span>', fmt(c.std[k]), fmt(c.act[k]), money(d), '<span class="dim">'+fmt(d*0.8)+'</span>']); });
  if(c.waitComp>0) h+=row(['<span class="sub">等停能耗补偿（'+fmt(w.waitDays,1)+' 天 × 0.2 吨/天 × '+fmt(c.dieselPrice,0)+' 元/吨）</span>', fmt(c.waitComp), '0', money(c.waitComp), '<span class="dim">'+fmt(c.waitComp)+'</span>']);
  if(c.costAdjust) h+=row(['<span class="sub">实际消耗调整（±）</span>', '', money(c.costAdjust), money(-c.costAdjust), '<span class="dim">'+money(-c.costAdjust*0.8)+'</span>']);
  h+=row(['<strong>三定额小计</strong>','','','','<strong>'+fmt(c.quotaSum)+'</strong>'],'total');
  $('#quotaTbl3').innerHTML=h+'</tbody>';

  /* ---- 三专项 ---- */
  let s='<thead><tr><th>专项</th><th>标准</th><th>实际</th><th>判定</th><th>兑现（元）</th></tr></thead><tbody>';
  s+=row(['<strong>④ 事故复杂专项</strong>', w.hasAccident?'-10,000 元/台月':'+20,000 元/台月',
          w.hasAccident?'发生（备查费用 '+fmt(w.accidentCost)+' 元）':'无', '<span class="sub">'+c.accNote+'</span>', '<strong>'+money(c.accAmt)+'</strong>'],'grp');
  s+=row(['<strong>⑤ 钻井提速专项</strong>', fmt(c.spdRate)+' 元/台月',
          fmt(actDays,1)+' / '+(planDays>0?fmt(planDays,1):'—')+' 天',
          '<span class="sub">'+(c.speedMet?'完成策划目标':'未完成，减半核减')+'</span>', '<strong>'+money(c.spdAmt)+'</strong>'],'grp');
  s+=row(['<strong>⑥ 单井毛益专项</strong>', c.gAvg!=null?pct(c.gAvg,2):'—', c.gmRaw?pct(c.gm,2):'0（待考核）',
          '<span class="sub">'+c.gmNote+'</span>', '<strong>'+money(c.gmAmt)+'</strong>'],'grp');
  s+=row(['<strong>三专项小计</strong>','','','','<strong>'+money(c.specSum)+'</strong>'],'total');
  $('#specTbl3').innerHTML=s+'</tbody>';

  /* ---- 本井兑现合计 ---- */
  const cadre=c.total*0.35, staff=c.total*0.65;
  $('#totalPanel').innerHTML=
    '<div class="bignum" style="font-size:30px">'+fmt(c.total)+' <span style="font-size:14px;font-weight:500;color:var(--muted)">元</span></div>'+
    '<div style="margin-top:10px">'+
    [['三定额小计', fmt(c.quotaSum)],
     ['三专项小计', money(c.specSum)],
     ['井筒质量扣款'+(c.qDed?'（封顶 '+fmt(c.dedCap)+'）':''), c.qDed?money(-c.qDed):'0'],
     ['工具损毁赔偿', (+w.damageDeduct)?money(-w.damageDeduct):'0']
    ].map(x=>'<div class="kv"><span>'+x[0]+'</span><span>'+x[1]+'</span></div>').join('')+'</div>'+
    '<div class="bar" style="margin-top:12px"><i style="width:35%;background:var(--c1)"></i><i style="width:65%;background:var(--c2)"></i></div>'+
    '<div style="display:flex;justify-content:space-between;margin-top:7px;font-size:12px">'+
      '<div><div class="sub">干部（含司钻） 3.5</div><div class="num" style="font-size:15px;font-weight:590">'+fmt(cadre)+' 元</div></div>'+
      '<div style="text-align:right"><div class="sub">职工 6.5</div><div class="num" style="font-size:15px;font-weight:590">'+fmt(staff)+' 元</div></div>'+
    '</div>';

  renderPrePanels(c);
  renderDash();
  if($('#preSettle')) renderPre();
}

/* 右栏底部两块：本井已预兑现 / 本井终考核兑现 */
function renderPrePanels(cIn){
  const c=cIn||calc(), P=preCalc();
  $('#prePanel').innerHTML= P.rows.length
    ? '<div class="bignum">'+fmt(P.paid)+' <span style="font-size:14px;font-weight:500;color:var(--muted)">元</span></div>'+
      '<div style="margin-top:10px">'+
      [['已登记月份', P.rows.length+' 个月（'+P.rows.map(e=>e.m.slice(5)).join('、')+'月）'],
       ['米费绩效累计', fmt(P.rows.reduce((s,e)=>s+e.mifei,0))],
       ['工序绩效累计', fmt(P.rows.reduce((s,e)=>s+(+e.row.proc||0),0))],
       ['累计登记进尺', fmt(P.footSum)+' m'+(P.over>0?' <span class="neg">超实际 '+fmt(P.over)+'</span>':'')]
      ].map(x=>'<div class="kv"><span>'+x[0]+'</span><span>'+x[1]+'</span></div>').join('')+'</div>'
    : '<div class="dim" style="padding:6px 0">本井尚无预兑现记录。到「预兑现登记」模块按月登记后，此处自动汇总并参与终考核清算。</div>';

  const neg=P.rest<0;
  $('#finalPanel').innerHTML=
    '<div class="bignum'+(neg?' neg':'')+'" style="font-size:30px">'+fmt(Math.abs(P.rest))+
      ' <span style="font-size:14px;font-weight:500;color:var(--muted)">元</span></div>'+
    '<div class="pill '+(neg?'bad':'ai')+'" style="margin-top:6px">'+(neg?'完井后挂账':'完井终考核应发')+'</div>'+
    '<div style="margin-top:10px">'+
    [['本井兑现合计', fmt(P.total)],
     ['减：本井已预兑现', fmt(P.paid)],
     ['已登记月份', P.rows.length+' 个月']
    ].map(x=>'<div class="kv"><span>'+x[0]+'</span><span>'+x[1]+'</span></div>').join('')+'</div>'+
    (neg?'<p class="sub" style="margin:9px 0 0">预兑现已超出完井考核额，差额转入本队挂账，从后续井终考核应发中优先抵扣（附件2 七（四））。</p>':'');
}

/* ============================ 单井经营考核表导出（Excel 2003 XML · 零依赖） ============================ */
/* 公示排版：A4 横向 · 黑体标题 · 统一细边框 · 章节底纹 · 金额千分位；预兑现月份明细放附表《预兑现明细》 */
function ymd(){ const d=new Date(), p=n=>String(n).padStart(2,'0');
  return d.getFullYear()+p(d.getMonth()+1)+p(d.getDate()); }
const xe=v=>String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
const xnum=v=>typeof v==='number'&&isFinite(v);
const XB='<Borders><Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1"/><Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1"/><Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1"/><Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1"/></Borders>';
const XLS_STYLES='<Styles>'+
 '<Style ss:ID="Default" ss:Name="Normal"><Alignment ss:Vertical="Center"/><Font ss:FontName="宋体" ss:Size="11" ss:Color="#1D1D1F"/></Style>'+
 '<Style ss:ID="xTitle"><Alignment ss:Horizontal="Center" ss:Vertical="Center"/><Font ss:FontName="黑体" ss:Size="20" ss:Bold="1"/></Style>'+
 '<Style ss:ID="xSub"><Alignment ss:Horizontal="Center" ss:Vertical="Center"/><Font ss:FontName="宋体" ss:Size="10" ss:Color="#6E6E73"/></Style>'+
 '<Style ss:ID="xInfo"><Alignment ss:Horizontal="Center" ss:Vertical="Center"/><Font ss:FontName="宋体" ss:Size="10.5"/></Style>'+
 '<Style ss:ID="xSec"><Alignment ss:Horizontal="Left" ss:Vertical="Center"/>'+XB+'<Font ss:FontName="黑体" ss:Size="11" ss:Bold="1"/><Interior ss:Color="#EEEEF0" ss:Pattern="Solid"/></Style>'+
 '<Style ss:ID="xTh"><Alignment ss:Horizontal="Center" ss:Vertical="Center" ss:WrapText="1"/>'+XB+'<Font ss:FontName="宋体" ss:Size="11" ss:Bold="1"/><Interior ss:Color="#F7F7F8" ss:Pattern="Solid"/></Style>'+
 '<Style ss:ID="xTd"><Alignment ss:Horizontal="Center" ss:Vertical="Center"/>'+XB+'<Font ss:FontName="宋体" ss:Size="11"/></Style>'+
 '<Style ss:ID="xTdL"><Alignment ss:Horizontal="Left" ss:Vertical="Center"/>'+XB+'<Font ss:FontName="宋体" ss:Size="11"/></Style>'+
 '<Style ss:ID="xNum"><Alignment ss:Horizontal="Right" ss:Vertical="Center"/>'+XB+'<Font ss:FontName="宋体" ss:Size="11"/><NumberFormat ss:Format="#,##0.00"/></Style>'+
 '<Style ss:ID="xNum0"><Alignment ss:Horizontal="Right" ss:Vertical="Center"/>'+XB+'<Font ss:FontName="宋体" ss:Size="11"/><NumberFormat ss:Format="#,##0"/></Style>'+
 '<Style ss:ID="xNeg"><Alignment ss:Horizontal="Right" ss:Vertical="Center"/>'+XB+'<Font ss:FontName="宋体" ss:Size="11" ss:Color="#C00000"/><NumberFormat ss:Format="#,##0.00"/></Style>'+
 '<Style ss:ID="xSum"><Alignment ss:Horizontal="Left" ss:Vertical="Center"/>'+XB+'<Font ss:FontName="宋体" ss:Size="11" ss:Bold="1"/><Interior ss:Color="#F2F2F2" ss:Pattern="Solid"/></Style>'+
 '<Style ss:ID="xSumNum"><Alignment ss:Horizontal="Right" ss:Vertical="Center"/>'+XB+'<Font ss:FontName="宋体" ss:Size="11" ss:Bold="1"/><Interior ss:Color="#F2F2F2" ss:Pattern="Solid"/><NumberFormat ss:Format="#,##0.00"/></Style>'+
 '<Style ss:ID="xTot"><Alignment ss:Horizontal="Left" ss:Vertical="Center"/>'+XB+'<Font ss:FontName="黑体" ss:Size="12" ss:Bold="1"/><Interior ss:Color="#E4E4E8" ss:Pattern="Solid"/></Style>'+
 '<Style ss:ID="xTotNum"><Alignment ss:Horizontal="Right" ss:Vertical="Center"/>'+XB+'<Font ss:FontName="黑体" ss:Size="12" ss:Bold="1"/><Interior ss:Color="#E4E4E8" ss:Pattern="Solid"/><NumberFormat ss:Format="#,##0.00"/></Style>'+
 '<Style ss:ID="xTotNeg"><Alignment ss:Horizontal="Right" ss:Vertical="Center"/>'+XB+'<Font ss:FontName="黑体" ss:Size="12" ss:Bold="1" ss:Color="#C00000"/><Interior ss:Color="#E4E4E8" ss:Pattern="Solid"/><NumberFormat ss:Format="#,##0.00"/></Style>'+
 '<Style ss:ID="xNote"><Alignment ss:Horizontal="Left" ss:Vertical="Center" ss:WrapText="1"/><Font ss:FontName="宋体" ss:Size="9" ss:Color="#6E6E73"/></Style>'+
 '<Style ss:ID="xFoot"><Alignment ss:Horizontal="Right" ss:Vertical="Center"/><Font ss:FontName="宋体" ss:Size="11"/></Style>'+
'</Styles>';

/* —— 工作表序列化：cells=[{v,t,s,a}]，t:'n'数字/'s'文本，a=MergeAcross 跨列数 —— */
function xlsSheet(name,cols,rows){
  return '<Worksheet ss:Name="'+xe(name)+'"><Table>'+cols.map(w=>'<Column ss:Width="'+w+'"/>').join('')+
    rows.map(r=>'<Row'+(r.h?' ss:Height="'+r.h+'"':'')+'>'+r.cells.map(cl=>{
      const a=cl.a>0?' ss:MergeAcross="'+cl.a+'"':'';
      if(cl.t==='n') return '<Cell ss:StyleID="'+cl.s+'"'+a+'><Data ss:Type="Number">'+cl.v+'</Data></Cell>';
      return cl.v==='' ? '<Cell ss:StyleID="'+cl.s+'"'+a+'/>' : '<Cell ss:StyleID="'+cl.s+'"'+a+'><Data ss:Type="String">'+xe(cl.v)+'</Data></Cell>';
    }).join('')+'</Row>').join('')+
    '</Table>'+
    '<WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel">'+
    '<PageSetup><Layout x:Orientation="Landscape" x:FitToPage="1"/><PageMargins x:Bottom="1.2" x:Left="0.6" x:Right="0.6" x:Top="1.2"/></PageSetup>'+
    '<FitToPage/><Print><FitHeight>0</FitHeight></Print></WorksheetOptions></Worksheet>';
}
function xc(v,s,a){ if(xnum(v)) return {v:v,t:'n',s:s||'xNum',a:a||0}; return {v:v==null?'':v,t:'s',s:s||'xTd',a:a||0}; }
function xt(v,s,a){ return {v:v==null?'':v,t:'s',s:s||'xTd',a:a||0}; }
function xn(v,s,a){ return xnum(v)?{v:v,t:'n',s:s||'xNum',a:a||0}:{v:v==null?'':v,t:'s',s:s||'xTd',a:a||0}; }
function xm(v,a,s){ if(xnum(v)) return {v:v,t:'n',s:s||(v<0?'xNeg':'xNum'),a:a||0}; return {v:'',t:'s',s:s||'xNum',a:a||0}; }

function buildExportXls(){
  const c=calc(), w=S.w, P=preCalc(), ds=diffSuggest();
  const now=new Date(), nowStr=now.toLocaleString('zh-CN');
  const dateStr=now.getFullYear()+'年'+(now.getMonth()+1)+'月'+now.getDate()+'日';
  const basis='渤海钻探第三钻井公司 2026 年经营责任制实施办法 · 附件2 大港油区单井经营考核办法（试行·2026年8月修订）'+(w.oneWellOnePolicy?' · 一井一策（自定义定额）':'');
  const diffTxt=ds.hits.length?ds.hits.map(h=>h[0]+' +'+h[1]).join('；'):'未触发加点规则';
  const gmStd=c.gAvg!=null?pct(c.gAvg,2):(c.B&&c.B.gm_avg!=null?String(c.B.gm_avg):'');
  const gmAct=c.gmRaw!=null?(c.gmRaw?pct(c.gm,2):'0（待考核）'):((+w.grossMargin||0)+'%');
  const S1=[], row=(h,cells)=>S1.push({h:h||20,cells:cells});

  row(36,[xc('单井经营考核表','xTitle',5)]);
  row(18,[xc(basis,'xSub',5)]);
  row(22,[xc('难度系数 '+Number(+w.difficulty||0).toFixed(2)+'（系统建议 '+Number(ds.k).toFixed(2)+'）　·　导出时间：'+nowStr,'xInfo',5)]);
  row(22,[xc('一、单井基础信息','xSec',5)]);
  row(22,[xc('井号：'+(w.wellNo||''),'xTd',1),xc('钻井队：'+w.team,'xTd',1),xc('钻机型号：'+c.R.rigType,'xTd',1)]);
  row(22,[xc('井型：'+w.wellType,'xTd',1),xc('区块：'+w.block,'xTd',1),xc('开次：'+w.phase+'开','xTd',1)]);
  row(22,[xc('定员标准：'+(+w.crewStd||0)+' 人','xTd',1),xc('计价方式：'+(w.dayrate?'日费井':'进尺井'),'xTd',1),xc('日费率：'+(w.dayrate?(+w.dayrateRatio||0)+'%':'—'),'xTd',1)]);
  row(22,[xc('二、难度系数','xSec',5)]);
  row(28,[xc('采用值','xTh'),xc('系统建议','xTh'),xc('触发加点规则','xTh',3)]);
  row(20,[xn(+w.difficulty||0,'xNum'),xn(ds.k,'xNum'),xc(diffTxt,'xTdL',3)]);
  row(22,[xc('三、考核进尺（米）','xSec',5)]);
  row(28,[xc('实际进尺','xTh'),xc('其它工序折算','xTh'),xc('认可侧钻进尺','xTh'),xc('折算周期合计','xTh'),xc('考核进尺合计','xTh')]);
  row(20,[xn(+w.footage||0,'xNum0'),xn(c.convFoot,'xNum'),xn(+w.sidetrack||0,'xNum0'),xn(c.convDays,'xNum'),xn(c.footEval,'xNum')]);
  row(22,[xc('四、周期情况（天）','xSec',5)]);
  row(28,[xc('钻完井周期','xTh'),xc('折合钻机月（台月）','xTh'),xc('策划周期','xTh'),xc('差值','xTh'),xc('提速判定','xTh')]);
  row(20,[xn(c.actDays,'xNum'),xn(c.actDays/30,'xNum'),xn(c.planDays||'','xNum'),xn(c.planDays>0?c.actDays-c.planDays:'','xNum'),xc(c.planDays>0?(c.speedMet?'完成策划目标':'未完成'):'未填策划周期','xTd')]);
  row(22,[xc('五、三定额情况（兑现·元）','xSec',5)]);
  row(28,[xc('考核项目','xTh'),xc('定额基准','xTh'),xc('实际','xTh'),xc('差异','xTh'),xc('兑现（元）','xTh')]);
  row(20,[xc('① 工序定额','xTdL'),xt('','xTd'),xt('','xTd'),xt('','xTd'),xm(c.procSum)]);
  c.procRows.forEach(p=>row(20,[xc('　'+p.name,'xTdL'),xn(p.base,'xNum'),xt(p.qty+' '+p.unit.replace('元/',''),'xTd'),xt('','xTd'),xm(p.amt)]));
  row(20,[xc('② 米费定额','xTdL'),xn(c.mifei||0,'xNum'),xn(c.footEval,'xNum'),xt((+w.crewStd||0)+'人 × '+c.K+' × '+c.dayK,'xTd'),xm(c.mifeiAmt)]);
  row(20,[xc('③ 成本定额','xTdL'),xn(c.stdSum,'xNum'),xn(c.actSum,'xNum'),xn(c.saving,'xNum'),xm(c.costAmt)]);
  COST_KEYS.forEach(k=>row(20,[xc('　'+COST_LABEL[k],'xTdL'),xn(c.std[k],'xNum'),xn(c.act[k],'xNum'),xn(c.std[k]-c.act[k],'xNum'),xm((c.std[k]-c.act[k])*0.8)]));
  if((c.waitComp||0)>0) row(20,[xc('　等停能耗补偿','xTdL'),xt((c.dieselPrice*0.2)+' 元/吨·天','xTd'),xt((+w.waitDays||0)+' 天','xTd'),xn(c.waitComp,'xNum'),xm(c.waitComp)]);
  if(c.costAdjust) row(20,[xc('　实际消耗调整（±）','xTdL'),xt('','xTd'),xn(c.costAdjust,'xNum'),xn(-c.costAdjust,'xNum'),xm(-c.costAdjust*0.8)]);
  row(20,[xc('三定额小计','xSum'),xt('','xSum'),xt('','xSum'),xt('','xSum'),xm(c.quotaSum,0,'xSumNum')]);
  row(22,[xc('六、三专项情况（兑现·元）','xSec',5)]);
  row(28,[xc('专项项目','xTh'),xc('考核标准','xTh'),xc('实际','xTh'),xc('判定','xTh'),xc('兑现（元）','xTh')]);
  row(20,[xc('④ 事故复杂专项','xTdL'),xt(w.hasAccident?'-10000 元/台月':'+20000 元/台月','xTd'),xt(w.hasAccident?('发生（备查费用 '+fmt(+w.accidentCost||0)+' 元）'):'无','xTd'),xc(c.accNote,'xTdL'),xm(c.accAmt)]);
  row(20,[xc('⑤ 钻井提速专项','xTdL'),xt(c.spdRate+' 元/台月','xTd'),xt(c.actDays+' / '+(c.planDays||'—')+' 天','xTd'),xc(c.speedMet?'完成策划目标':'未完成，减半核减','xTd'),xm(c.spdAmt)]);
  row(20,[xc('⑥ 单井毛益专项','xTdL'),xt(gmStd,'xTd'),xt(gmAct,'xTd'),xc(c.gmNote,'xTdL'),xm(c.gmAmt)]);
  row(20,[xc('三专项小计','xSum'),xt('','xSum'),xt('','xSum'),xt('','xSum'),xm(c.specSum,0,'xSumNum')]);
  row(22,[xc('七、本井兑现合计（元）','xSec',5)]);
  row(20,[xc('三定额小计','xTdL',1),xm(c.quotaSum,3)]);
  row(20,[xc('三专项小计','xTdL',1),xm(c.specSum,3)]);
  row(20,[xc('井筒质量扣款','xTdL',1),xm(c.qDed?-c.qDed:0,3)]);
  row(20,[xc('工具损毁赔偿','xTdL',1),xm((+w.damageDeduct||0)?-(+w.damageDeduct):0,3)]);
  row(24,[xc('本井兑现合计','xTot',1),xm(c.total,3,'xTotNum')]);
  row(20,[xc('其中：干部（含司钻）占 35%','xTdL',1),xm(c.total*0.35,3)]);
  row(20,[xc('其中：职工占 65%','xTdL',1),xm(c.total*0.65,3)]);
  row(22,[xc('八、预兑现与终考核（元）','xSec',5)]);
  row(20,[xc('本井已预兑现','xTdL',1),xm(P.paid,3)]);
  row(24,[xc('本井终考核应发','xTot',1),xm(P.rest,3,P.rest<0?'xTotNeg':'xTotNum')]);
  if(P.rest<0) row(20,[xc('说明：预兑现已超出完井考核额，差额转入本队挂账（附件2 七（四））','xTdL',5)]);
  row(18,[xc('月度预兑现月份明细见附表《预兑现明细》。','xNote',5)]);
  row(18,[xt('','xTd',5)]);
  row(30,[xc('本表为单井经营考核结果公示材料，公示期满无异议后按《大港油区单井经营考核办法（试行）》兑现；如有异议，请及时向公司企划财务部反映。','xNote',5)]);
  row(24,[xc('渤海钻探第三钻井公司 企划财务部　　'+dateStr,'xFoot',5)]);

  const S2=[], row2=(h,cells)=>S2.push({h:h||20,cells:cells});
  row2(36,[xc('单井经营考核表 · 预兑现明细（元）','xTitle',6)]);
  row2(18,[xc('井号：'+(w.wellNo||'')+'　钻井队：'+w.team+'　导出时间：'+nowStr,'xSub',6)]);
  row2(22,[xc('月度预兑现登记明细','xSec',6)]);
  row2(28,[xc('兑现月份','xTh'),xc('承担队号','xTh'),xc('当月进尺（米）','xTh'),xc('米费绩效','xTh'),xc('当月工序绩效','xTh'),xc('成本预兑现','xTh'),xc('本月预兑现','xTh')]);
  if(P.rows.length){
    P.rows.forEach(e=>row2(20,[xc(e.m,'xTd'),xc(e.team,'xTd'),xn(+e.row.foot||0,'xNum0'),xm(e.mifei),xm(+e.row.proc||0),xm(+e.row.cost||0),xm(e.paid)]));
    const mf=P.rows.reduce((s,e)=>s+e.mifei,0), pf=P.rows.reduce((s,e)=>s+(+e.row.proc||0),0), cf=P.rows.reduce((s,e)=>s+(+e.row.cost||0),0);
    row2(20,[xc('合计 '+P.rows.length+' 个月','xSum'),xt('','xSum'),xm(P.footSum,0,'xSumNum'),xm(mf,0,'xSumNum'),xm(pf,0,'xSumNum'),xm(cf,0,'xSumNum'),xm(P.paid,0,'xSumNum')]);
    row2(20,[xc('本井已预兑现','xTdL'),xt('','xTd'),xt('','xTd'),xt('','xTd'),xt('','xTd'),xt('','xTd'),xm(P.paid)]);
    row2(24,[xc('本井终考核应发','xTot'),xt('','xTot'),xt('','xTot'),xt('','xTot'),xt('','xTot'),xt('','xTot'),xm(P.rest,0,P.rest<0?'xTotNeg':'xTotNum')]);
    if(P.rest<0) row2(20,[xc('说明：预兑现已超出完井考核额，差额转入本队挂账（附件2 七（四））','xTdL',6)]);
  }else{
    row2(20,[xc('（无预兑现记录）','xTd',6)]);
  }
  row2(18,[xt('','xTd',6)]);
  row2(24,[xc('渤海钻探第三钻井公司 企划财务部　　'+dateStr,'xFoot',6)]);

  return '<?xml version="1.0" encoding="UTF-8"?>\n<?mso-application progid="Excel.Sheet"?>\n'+
    '<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet" xmlns:html="http://www.w3.org/TR/REC-html40">'+
    XLS_STYLES+
    xlsSheet('单井经营考核表',[24,18,18,24,30,14],S1)+
    xlsSheet('预兑现明细',[14,12,16,20,20,20,22],S2)+
    '</Workbook>';
}

function exportMsg(html,cls){
  const e=$('#exportMsg'); if(!e) return;
  e.innerHTML=html||''; e.className='sub '+(cls==='err'?'neg':(cls==='ok'?'pos':''));
  if(html) setTimeout(()=>{ if(e.innerHTML===html) e.innerHTML=''; },6000);
}

async function exportWell(){
  const xml=buildExportXls();
  const name='单井经营考核表_'+(String(S.w.wellNo||'未命名').replace(/[\\/:*?"<>|]/g,''))+'_'+ymd()+'.xls';
  const btn=$('#exportXls'); if(btn) btn.disabled=true;
  try{
    const dl=(typeof claude!=='undefined'&&claude.use)?await claude.use('downloads'):null;
    if(dl){
      await dl.save({filename:name,data:xml});
      exportMsg('已导出 '+name,'ok');
    }else{
      const blob=new Blob(['\ufeff'+xml],{type:'application/vnd.ms-excel;charset=utf-8'});
      const url=URL.createObjectURL(blob), a=document.createElement('a');
      a.href=url; a.download=name; document.body.appendChild(a); a.click(); a.remove();
      setTimeout(()=>URL.revokeObjectURL(url),3000);
      exportMsg('已导出 '+name,'ok');
    }
  }catch(e){
    const code=e&&e.code;
    if(code==='declined') exportMsg('已取消导出');
    else if(code==='rate_limited') exportMsg('导出请求过于频繁，请稍候再试','err');
    else exportMsg('导出未完成：'+((e&&e.message)||'未知错误'),'err');
  }finally{ if(btn) btn.disabled=false; }
}


/* ============================ 单井考核井库 ============================ */
const WKEY='kh-wells-2026';
let WELLS=(function(){ try{ const r=localStorage.getItem(WKEY); if(r){ const p=JSON.parse(r); if(Array.isArray(p)) return p; } }catch(e){} return null; })();
let EDIT_ID=null, PEND_DEL=null, DEL_TIMER=null;
const esc = v=>String(v==null?'':v).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const kb = n=> n<1024 ? n+' B' : n<1048576 ? (n/1024).toFixed(0)+' KB' : (n/1048576).toFixed(1)+' MB';
const W_ST=[['submitted','待审核','man'],['approved','已审核','ai']];
function saveWells(){ try{ localStorage.setItem(WKEY,JSON.stringify(WELLS)); }catch(e){}
  if(BACKEND_MODE) apiFetch('/api/wells',{method:'PUT',body:JSON.stringify(WELLS)}).catch(()=>{}); }
function newId(){ return 'W'+Date.now().toString(36).toUpperCase()+Math.floor(Math.random()*90+10); }
function clone(o){ return JSON.parse(JSON.stringify(o)); }
function fieldCount(){ return F.flatMap(g=>g.rows.flat()).length; }
function provStat(prov){
  const v=Object.values(prov||{});
  const sys=v.filter(p=>p.src==='sys').length, ai=v.filter(p=>p.src==='ai').length;
  return {sys,ai,man:Math.max(fieldCount()-sys-ai,0)};
}
function trustOf(p){ const t=p.sys+p.ai+p.man; return t? (p.sys+p.ai*0.85)/t : 0; }
function stamp(ts){ const d=new Date(ts);
  return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')+
    ' '+String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0'); }

function mkRecord(status,note){
  const c=calc(S.w);
  return {id:newId(), at:Date.now(), status:status||'submitted', note:note||'',
    w:clone(S.w), prov:clone(S.prov),
    snap:{total:c.total, footEval:c.footEval, quotaSum:c.quotaSum, specSum:c.specSum}};
}
function validateWell(){
  const e=[];
  if(!String(S.w.wellNo||'').trim()) e.push('井号不能为空');
  if(!(+S.w.footage>0)) e.push('实际进尺必须大于 0');
  if(!(+S.w.cycleDays>0)) e.push('钻完井周期必须大于 0');
  if(S.w.oneWellOnePolicy){
    if(!((S.w.custom||{}).mifei>0)) e.push('一井一策井须至少填写自定义米费定额');
  } else {
    const B=findBlock(S.w.wellType,S.w.block,S.w.phase);
    if(!B.mifei) e.push('「'+S.w.wellType+' · '+S.w.block+' · '+S.w.phase+'开」无米费定额，须先在定额库按相邻区块补位，或勾选「一井一策」自定义定额');
  }
  const dup=WELLS.find(r=>r.id!==EDIT_ID && String(r.w.wellNo).trim()===String(S.w.wellNo).trim());
  if(dup) e.push('井号「'+S.w.wellNo+'」已入库（'+stamp(dup.at)+'），请改用编辑或更换井号');
  return e;
}
function wellMsg(html,cls){ const m=$('#wellMsg'); if(!m) return;
  m.innerHTML = html ? '<div class="note '+(cls||'')+'">'+html+'</div>' : '';
  m.style.marginTop = html ? '10px' : '0'; }

function submitWell(){
  const errs=validateWell();
  if(errs.length){ wellMsg('<b>无法入库：</b>'+errs.join('；'),'err'); return; }
  if(EDIT_ID){
    const i=WELLS.findIndex(r=>r.id===EDIT_ID);
    if(i>=0){ const c=calc(S.w), old=WELLS[i];
      WELLS[i]=Object.assign({},old,{w:clone(S.w),prov:clone(S.prov),at:Date.now(),status:'submitted',
        snap:{total:c.total,footEval:c.footEval,quotaSum:c.quotaSum,specSum:c.specSum}});
      wellMsg('已更新 <b>'+S.w.wellNo+'</b>，兑现 '+fmt(c.total)+' 元，状态回到待审核。','ok');
    }
    EDIT_ID=null;
  } else {
    WELLS.unshift(mkRecord());
    wellMsg('已入库 <b>'+S.w.wellNo+'</b>，兑现 '+fmt(calc(S.w).total)+' 元。','ok');
  }
  saveWells(); renderWellActions(); renderWellStore(); renderTeamSettle(); renderDash();
}
function loadWell(id,edit){
  const r=WELLS.find(x=>x.id===id); if(!r) return;
  S.w=clone(r.w); S.prov=clone(r.prov);
  EDIT_ID = edit ? id : null;
  wellMsg(edit ? '正在编辑 <b>'+r.w.wellNo+'</b>（'+r.id+'）。修改后点「更新入库」覆盖原记录，或点「取消编辑」放弃。'
                : '已调取 <b>'+r.w.wellNo+'</b> 到表单。当前为新建模式，提交将作为新记录入库。', edit?'':'ok');
  render(); renderPre(); renderWellActions(); renderWellStore();
  const el2=$('#wellForm'); if(el2) el2.scrollIntoView({block:'start',behavior:'smooth'});
}
function delWell(id){
  if(PEND_DEL!==id){ PEND_DEL=id; clearTimeout(DEL_TIMER);
    DEL_TIMER=setTimeout(()=>{ PEND_DEL=null; renderWellStore(); },4000);
    renderWellStore(); return; }
  const r=WELLS.find(x=>x.id===id);
  WELLS=WELLS.filter(x=>x.id!==id);
  if(EDIT_ID===id){ EDIT_ID=null; renderWellActions(); }
  PEND_DEL=null; clearTimeout(DEL_TIMER); saveWells();
  wellMsg('已删除 <b>'+(r?r.w.wellNo:id)+'</b>。','');
  renderWellStore(); renderTeamSettle(); renderDash(); renderRoll();
}
function toggleWellStatus(id){
  const r=WELLS.find(x=>x.id===id); if(!r) return;
  r.status = r.status==='approved' ? 'submitted' : 'approved';
  saveWells(); renderWellStore(); renderRoll();
}

function renderWellActions(){
  const a=$('#wellActions');
  a.innerHTML='<button class="btn" id="submitWell" type="button">'+(EDIT_ID?'更新入库':'提交入库')+'</button>'+
    (EDIT_ID?'<button class="btn ghost" id="cancelEdit" type="button">取消编辑</button>':'');
  $('#submitWell').onclick=submitWell;
  const ce=$('#cancelEdit');
  if(ce) ce.onclick=()=>{ EDIT_ID=null; wellMsg('已退出编辑，表单保留当前参数。',''); renderWellActions(); renderWellStore(); };
}

/* ============================ 单井预兑现（队号 × 井号 × 月份） ============================ */
function preRows(w){ const t=w||S.w; if(!Array.isArray(t.pre)) t.pre=[]; return t.pre; }
const FORM_KEY='__form';
let PRE_WELL='__form';
function preTarget(){
  const fk=formKey();
  if(PRE_WELL!=='__form'){
    const r=WELLS.find(x=>x.id===PRE_WELL);
    if(r) return r.id===fk ? {w:S.w,id:fk,stored:false,label:r.w.wellNo||'未命名'}
                           : {w:r.w,id:r.id,stored:true,label:r.w.wellNo||'未命名'};
  }
  return {w:S.w,id:fk,stored:false,label:(S.w.wellNo||'（当前录入井）')};
}
function preMsg(html,cls){ const m=$('#preMsg'); if(m) m.innerHTML = html ? '<div class="note '+(cls||'')+'" style="margin-bottom:14px">'+html+'</div>' : ''; }
function preWellOptions(){
  const sel=$('#preWellSel'); if(!sel) return;
  const fk=formKey(), cur=PRE_WELL;
  sel.innerHTML='<option value="__form">当前录入井 · '+(S.w.wellNo||'未命名')+'</option>'+
    WELLS.filter(r=>r.id!==fk).map(r=>'<option value="'+r.id+'">'+(r.w.wellNo||'未命名')+' · '+r.w.team+'</option>').join('');
  sel.value=[...sel.options].some(o=>o.value===cur)?cur:'__form';
  PRE_WELL=sel.value;
}

/* 表单井的账户键：编辑中用该记录 id；否则用同井号的入库记录 id；都没有则为未入库井 */
function formKey(){
  if(EDIT_ID) return EDIT_ID;
  const w=String(S.w.wellNo||'').trim();
  const m=w && WELLS.find(r=>String(r.w.wellNo||'').trim()===w);
  return m ? m.id : FORM_KEY;
}
/* 全量条目：每条 = 一个（队号，井号，月份）三元组 */
function preEntries(){
  const fk=formKey(), out=[];
  WELLS.forEach(r=>{
    if(r.id===fk) return;                            // 该井以表单为准，避免重复计入
    preRows(r.w).forEach((x,i)=>out.push({key:r.id, well:r.w.wellNo||'未命名', w:r.w, row:x, i,
      team:x.team||r.w.team, m:x.m}));
  });
  preRows(S.w).forEach((x,i)=>out.push({key:fk, well:S.w.wellNo||'（未入库）', w:S.w, row:x, i,
      team:x.team||S.w.team, m:x.m}));
  return out;
}

/* 计提：米费 + 工序 + 成本预兑现，按（队号，月份）汇总为当月应发 */
function preCompute(){
  const es=preEntries();
  es.forEach(e=>{
    const c=calc(e.w), B=findBlock(e.w.wellType,e.w.block,e.w.phase);
    e.crew=+e.w.crewStd||0;
    e.rate=(B.mifei||0)*e.crew*(Number(e.w.difficulty)||1)*c.dayK;
    e.mifei=(+e.row.foot||0)*e.rate;
    e.gross=e.mifei+(+e.row.proc||0);
    e.pre=e.gross+(+e.row.cost||0);
  });
  const g={};
  es.forEach(e=>{ const k=e.team+'|'+e.m; (g[k]=g[k]||{team:e.team,m:e.m,list:[]}).list.push(e); });
  const tm=Object.keys(g).map(k=>{
    const b=g[k];
    b.pre=b.list.reduce((s,e)=>s+e.pre,0);
    b.paid=b.pre;
    b.wells=b.list.map(e=>e.well).filter((v,i,a)=>a.indexOf(v)===i);
    b.list.forEach(e=>{ e.add=0; e.paid=e.pre; e.tmWells=b.wells.length; });
    return b;
  }).sort((a,b)=> a.m.localeCompare(b.m) || String(a.team).localeCompare(String(b.team)));
  return {entries:es, tm};
}

function preCalc(wIn,id){
  const w=wIn||S.w;
  const key=(id!==undefined&&id!==null)?id:formKey();
  const C=preCompute();
  const rows=C.entries.filter(e=>e.key===key).sort((a,b)=>a.m.localeCompare(b.m));
  const paid=rows.reduce((s,e)=>s+e.paid,0);
  const footSum=rows.reduce((s,e)=>s+(+e.row.foot||0),0);
  const c=calc(w);
  return {rows, paid, footSum, tm:C.tm, total:c.total, rest:c.total-paid,
          over:footSum-(+w.footage||0)};
}

function renderPre(){
  preWellOptions();
  const T=preTarget(), P=preCalc(T.w,T.id), w=T.w;
  if($('#preWellLabel')) $('#preWellLabel').textContent=T.label+' · '+w.team;
  const teams=Q.rigs.map(r=>r.team);
  if(!P.rows.length){
    $('#preTbl').innerHTML='<tbody><tr><td class="dim" style="font-family:var(--sans)">尚无预兑现记录。选择月份后点「登记本月预兑现」，按当月进尺与已签证工序计提，完井后统一清算。</td></tr></tbody>';
  } else {
    $('#preTbl').innerHTML='<thead><tr><th>兑现月份</th><th>承担队号</th><th>当月进尺（米）</th><th>米费绩效</th><th>当月工序绩效</th>'+
      '<th>成本预兑现</th><th>本月预兑现</th><th>操作</th></tr></thead><tbody>'+
      P.rows.map(e=>{ const i=e.i;
        return '<tr><td>'+e.m+'</td>'+
        '<td><select data-pi="'+i+'" data-pf="team">'+teams.map(t=>'<option value="'+t+'"'+(t===e.team?' selected':'')+'>'+t+'</option>').join('')+'</select></td>'+
        '<td><input type="number" step="10" data-pi="'+i+'" data-pf="foot" value="'+(e.row.foot||0)+'"></td>'+
        '<td>'+fmt(e.mifei)+'</td>'+
        '<td><input type="number" step="100" data-pi="'+i+'" data-pf="proc" value="'+(e.row.proc||0)+'"></td>'+
        '<td><input type="number" step="100" data-pi="'+i+'" data-pf="cost" value="'+(e.row.cost||0)+'"></td>'+
        '<td><strong>'+fmt(e.paid)+'</strong></td>'+
        '<td style="text-align:left"><button class="btn ghost mini" data-pdel="'+i+'">删除</button></td></tr>'; }).join('')+
      '<tr class="total"><td>合计 '+P.rows.length+' 个月</td><td></td><td>'+fmt(P.footSum)+
        (P.over>0?'<div class="sub neg">超实际进尺 '+fmt(P.over)+'</div>':'')+'</td>'+
        '<td>'+fmt(P.rows.reduce((s,e)=>s+e.mifei,0))+'</td><td>'+fmt(P.rows.reduce((s,e)=>s+(+e.row.proc||0),0))+'</td>'+
        '<td>'+fmt(P.rows.reduce((s,e)=>s+(+e.row.cost||0),0))+'</td><td><strong>'+fmt(P.paid)+'</strong></td><td></td></tr></tbody>';
    const bind=el2=>el2.addEventListener(el2.tagName==='SELECT'?'change':'input',ev=>{
      const i=+ev.target.dataset.pi, f=ev.target.dataset.pf, tt=preTarget();
      preRows(tt.w)[i][f]= f==='team' ? ev.target.value : (parseFloat(ev.target.value)||0);
      if(tt.stored) saveWells();
      if(f==='team'){ renderPre(); } else { refreshPreLive(); }
      renderPrePanels(); renderWellStore(); renderDash();
    });
    $('#preTbl').querySelectorAll('input,select').forEach(bind);
    $('#preTbl').querySelectorAll('[data-pdel]').forEach(b=>{
      b.onclick=()=>{ const tt=preTarget(); preRows(tt.w).splice(+b.dataset.pdel,1); if(tt.stored) saveWells();
        renderPre(); renderPrePanels(); renderWellStore(); renderDash(); };
    });
  }
  renderTeamMonth(P);
  renderPreSettle(P);
  renderTeamSettle();
}

/* 输入数字时就地更新，避免重建表格丢焦点 */
function refreshPreLive(){
  const tt=preTarget(), M=preCalc(tt.w,tt.id), T=$('#preTbl');
  M.rows.forEach((e,ri)=>{
    const row=T.rows[ri+1]; if(!row) return;
    row.cells[3].textContent=fmt(e.mifei);
    row.cells[6].innerHTML='<strong>'+fmt(e.paid)+'</strong>';
  });
  const tr=T.rows[T.rows.length-1];
  if(tr){
    tr.cells[2].innerHTML=fmt(M.footSum)+(M.over>0?'<div class="sub neg">超实际进尺 '+fmt(M.over)+'</div>':'');
    tr.cells[3].textContent=fmt(M.rows.reduce((s,e)=>s+e.mifei,0));
    tr.cells[4].textContent=fmt(M.rows.reduce((s,e)=>s+(+e.row.proc||0),0));
    tr.cells[5].textContent=fmt(M.rows.reduce((s,e)=>s+(+e.row.cost||0),0));
    tr.cells[6].innerHTML='<strong>'+fmt(M.paid)+'</strong>';
  }
  renderTeamMonth(M); renderPreSettle(M); renderTeamSettle();
}

/* 按（队号 × 月份）汇总——这是实际发放口径 */
function renderTeamMonth(P){
  const T=$('#teamMonthTbl'); if(!T) return;
  const rows=P.tm;
  if(!rows.length){ T.innerHTML='<tbody><tr><td class="dim" style="font-family:var(--sans)">暂无数据。</td></tr></tbody>'; return; }
  const S4=f=>rows.reduce((a,r)=>a+r[f],0);
  T.innerHTML='<thead><tr><th>兑现月份</th><th>队号</th><th>在钻井号</th><th>井数</th><th>当月应发</th></tr></thead><tbody>'+
    rows.map(r=>'<tr><td>'+r.m+'</td><td>'+r.team+'</td>'+
      '<td style="text-align:left">'+r.wells.join('、')+'</td>'+
      '<td class="dim">'+r.wells.length+'</td>'+
      '<td><strong>'+fmt(r.paid)+'</strong></td></tr>').join('')+
    '<tr class="total"><td>合计 '+rows.length+' 个队·月</td><td colspan="3"></td>'+
    '<td><strong>'+fmt(S4('paid'))+'</strong></td></tr></tbody>';
}

function renderPreSettle(P){
  const neg=P.rest<0;
  $('#preSettle').innerHTML=
    '<div class="kpis" style="margin-top:14px">'+
    [['完井考核兑现总额', fmt(P.total)+' 元', '三定额 + 三专项，扣减后合计'],
     ['本井已预兑现', fmt(P.paid)+' 元', P.rows.length+' 个月 · 米费 + 工序 + 成本预兑现'],
     [neg?'完井后挂账':'完井终考核应发', fmt(Math.abs(P.rest))+' 元',
      neg?'预兑现已超出完井考核额，转入本队挂账':'完井考核兑现总额 − 本井已预兑现'],
     ['月均预兑现', fmt(P.rows.length?P.paid/P.rows.length:0)+' 元', P.rows.length+' 个登记月份']
    ].map(x=>'<div class="kpi"><div class="k">'+x[0]+'</div><div class="v'+(x[0]==='完井后挂账'?' neg':'')+'">'+x[1]+'</div><div class="d">'+x[2]+'</div></div>').join('')+
    '</div>';
}

function preAddMonth(){
  const m=$('#preMonth').value, T=preTarget(), rows=preRows(T.w);
  if(rows.some(r=>r.m===m)){ preMsg('<b>'+m+'</b> 已登记过预兑现，请直接在表内修改。','err'); return; }
  const P=preCalc(T.w,T.id);
  const rest=Math.max(0,(+T.w.footage||0)-P.footSum);
  rows.push({m, team:T.w.team, foot:rest, proc:0, cost:0});
  rows.sort((a,b)=>a.m.localeCompare(b.m));
  if(T.stored) saveWells();
  preMsg('已为 <b>'+T.label+'</b> 登记 '+m+' 预兑现（承担队号 '+T.w.team+'），默认按剩余未登记进尺 '+fmt(rest)+' 米计提，可在表内调整。','ok');
  renderPre(); renderPrePanels(); renderWellStore(); renderDash();
}

function teamSettle(){
  const map={};
  WELLS.forEach(r=>{
    const t=r.w.team, c=calc(r.w), p=preCalc(r.w,r.id);
    const m=map[t]||(map[t]={team:t,n:0,total:0,pre:0});
    m.n++; m.total+=c.total; m.pre+=p.paid;
  });
  return Object.keys(map).map(k=>{ const m=map[k]; m.net=m.total-m.pre; return m; })
    .sort((a,b)=>a.net-b.net);
}
function renderTeamSettle(){
  const T=$('#teamSettleTbl'); if(!T) return;
  const rows=teamSettle();
  if(!rows.length){ T.innerHTML='<tbody><tr><td class="dim" style="font-family:var(--sans)">井库为空，暂无队伍结转数据。</td></tr></tbody>'; return; }
  const S3=f=>rows.reduce((a,r)=>a+r[f],0);
  T.innerHTML='<thead><tr><th>队号</th><th>入库井数</th><th>完井兑现合计</th><th>已预兑现合计</th><th>净应发 / 挂账</th><th>结转处理</th></tr></thead><tbody>'+
    rows.map(r=>'<tr><td>'+r.team+'</td><td>'+r.n+'</td><td>'+fmt(r.total)+'</td><td>'+fmt(r.pre)+'</td>'+
      '<td class="'+(r.net<0?'neg':'pos')+'"><strong>'+fmt(r.net)+'</strong></td>'+
      '<td style="text-align:left" class="sub">'+(r.net<0
        ? '<span class="pill bad">挂账 '+fmt(-r.net)+'</span> 从本队后续井终考核应发中优先抵扣，原则上当年完成'
        : '可发，无挂账')+'</td></tr>').join('')+
    '<tr class="total"><td>合计 '+rows.length+' 支队伍</td><td>'+S3('n')+'</td><td>'+fmt(S3('total'))+'</td><td>'+fmt(S3('pre'))+'</td>'+
    '<td class="'+(S3('net')<0?'neg':'pos')+'">'+fmt(S3('net'))+'</td>'+
    '<td style="text-align:left" class="sub">挂账队伍 '+rows.filter(r=>r.net<0).length+' 支</td></tr></tbody>';
}

function renderWellStore(){
  const T=$('#wellStoreTbl');
  $('#storeCount').textContent = WELLS.length+' 口井 · 已审核 '+WELLS.filter(r=>r.status==='approved').length;
  if(!WELLS.length){
    T.innerHTML='<tbody><tr><td class="dim" style="font-family:var(--sans)">井库为空。左侧录入参数后点「提交入库」，入库井将进入驾驶舱的单井考核台账并参与切块封顶测算。</td></tr></tbody>';
    return;
  }
  let sum=0, sumNow=0, sumPre=0, sumRest=0;
  const body=WELLS.map(r=>{
    const now=calc(r.w), p=provStat(r.prov), tr=trustOf(p), pre=preCalc(r.w,r.id);
    sumPre+=pre.paid; sumRest+=pre.rest;
    const drift=now.total-r.snap.total;
    sum+=r.snap.total; sumNow+=now.total;
    const sd=W_ST.find(x=>x[0]===r.status)||W_ST[0];
    const del= PEND_DEL===r.id
      ? '<button class="btn mini" data-del="'+r.id+'" style="background:var(--neg);border-color:var(--neg);color:#fff">确认删除</button>'
      : '<button class="btn ghost mini" data-del="'+r.id+'">删除</button>';
    return '<tr'+(EDIT_ID===r.id?' style="background:var(--signal-soft)"':'')+'>'+
      '<td>'+(r.w.wellNo||'—')+'<div class="sub">'+r.id+' · '+stamp(r.at)+'</div></td>'+
      '<td>'+r.w.team+'</td><td>'+r.w.wellType+' · '+r.w.block+' '+r.w.phase+'开</td>'+
      '<td>'+fmt(now.footEval)+'</td>'+
      '<td>'+fmt(r.snap.total)+'</td>'+
      '<td>'+fmt(now.total)+(Math.abs(drift)>1?'<div class="sub '+(drift>0?'pos':'neg')+'">'+(drift>0?'+':'')+fmt(drift)+'</div>':'')+'</td>'+
      '<td>'+fmt(pre.paid)+(pre.rows.length?'<div class="sub">'+pre.rows.length+' 个月</div>':'')+'</td>'+
      '<td class="'+(pre.rest<0?'neg':'')+'">'+fmt(pre.rest)+(pre.rest<0?'<div class="sub neg">挂账</div>':'')+'</td>'+
      '<td><span class="conf '+(tr<0.75?'low':'')+'"><i style="width:'+(tr*100).toFixed(0)+'%"></i></span>'+pct(tr,0)+'</td>'+
      '<td><button class="pill '+sd[2]+'" data-st="'+r.id+'" style="cursor:pointer;border:0">'+sd[1]+'</button></td>'+
      '<td style="text-align:left"><span style="display:inline-flex;gap:4px;flex-wrap:wrap">'+
        '<button class="btn ghost mini" data-load="'+r.id+'">调取</button>'+
        '<button class="btn ghost mini" data-edit="'+r.id+'">修改</button>'+del+'</span></td></tr>';
  }).join('');
  T.innerHTML='<thead><tr><th>井号 / 入库单号</th><th>队号</th><th>井型 · 区块 · 开次</th><th>考核进尺</th>'+
    '<th>入库时兑现</th><th>现行定额兑现</th><th>已预兑现</th><th>终考核应发</th><th>可信度</th><th>状态</th><th>操作</th></tr></thead><tbody>'+body+
    '<tr class="total"><td>合计 '+WELLS.length+' 口</td><td colspan="3"></td><td>'+fmt(sum)+'</td><td>'+fmt(sumNow)+
    (Math.abs(sumNow-sum)>1?'<div class="sub '+(sumNow>sum?'pos':'neg')+'">'+(sumNow>sum?'+':'')+fmt(sumNow-sum)+'</div>':'')+
    '</td><td>'+fmt(sumPre)+'</td><td class="'+(sumRest<0?'neg':'')+'">'+fmt(sumRest)+'</td><td colspan="3"></td></tr></tbody>';

  T.querySelectorAll('[data-load]').forEach(b=>b.onclick=()=>loadWell(b.dataset.load,false));
  T.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>loadWell(b.dataset.edit,true));
  T.querySelectorAll('[data-del]').forEach(b=>b.onclick=()=>delWell(b.dataset.del));
  T.querySelectorAll('[data-st]').forEach(b=>b.onclick=()=>toggleWellStatus(b.dataset.st));
}

/* ============================ 驾驶舱 ============================ */

/* ---------- 数据模型：填报驱动，汇总全部由填报数据派生 ---------- */
const YEAR=2026;
const UNITS=[{k:'dg',n:'大港油区',note:'含新项目、国际',color:'var(--c1)'},
             {k:'xb',n:'西北',note:'外部项目 · 南疆／北疆',color:'var(--c2)'},
             {k:'cq',n:'长庆',note:'外部项目 · 陕、甘、蒙',color:'var(--c3)'}];
const IW=[0.30,0.40,0.30];
const I_KEY=['foot','rev','gm'];
const I_NAME={foot:'进尺',rev:'市场创收',gm:'贡献毛益额'};
const I_DEC={foot:0,rev:2,gm:2};
const MONTH_LBL=['1月','2月','3月','4月','5月','6月','7月','8月','9月','10月','11月','12月'];
const SEED={"dg":{"m":{"1":{"foot":19778.0,"rev":4404.0,"gm":600.0,"quota":70714.0,"accident":165100.0,"safeTeam":0.0,"safeHq":0.0,"payBaseTeam":1256473.0,"payBaseHq":0.0,"paySafeTeam":0.0,"paySafeHq":0.0},"2":{"foot":22340.0,"rev":11568.0,"gm":1652.0,"quota":30199.0,"payBaseTeam":1164205.3487,"payBaseHq":0.0,"paySafeTeam":0.0,"paySafeHq":0.0},"3":{"foot":26393.0,"rev":6520.0,"gm":819.0,"quota":55604.0,"accident":183500.0,"payBaseTeam":1047096.3061,"payBaseHq":0.0,"paySafeTeam":0.0,"paySafeHq":0.0},"4":{"foot":20029.0,"rev":6617.0,"gm":1493.2,"quota":108577.0,"payBaseTeam":1147409.0,"payBaseHq":0.0,"paySafeTeam":0.0,"paySafeHq":0.0},"5":{"foot":23214.0,"rev":10145.0,"gm":1590.11,"quota":73875.44,"payBaseTeam":1455870.8787,"payBaseHq":0.0,"paySafeTeam":0.0,"paySafeHq":0.0},"6":{"foot":7665.0,"rev":6017.0,"gm":335.0,"quota":93373.0,"accident":207500.0,"payBaseTeam":1205730.0,"payBaseHq":0.0,"paySafeTeam":0.0,"paySafeHq":0.0},"7":{"foot":10569.0,"rev":6181.0,"gm":1757.0,"quota":287687.0,"payBaseTeam":2062105.0,"payBaseHq":0.0,"paySafeTeam":0.0,"paySafeHq":0.0},"8":{"foot":11681.0,"rev":9672.0,"gm":650.0,"quota":140511.0,"multiRig":279108.0,"hqIncent":0.0,"payBaseTeam":909623.0,"payBaseHq":0.0,"paySafeTeam":0.0,"paySafeHq":0.0},"9":{"quota":0.0,"accident":0.0,"payBaseTeam":0.0,"payBaseHq":0.0,"paySafeTeam":0.0,"paySafeHq":0.0},"10":{"quota":0.0,"payBaseTeam":0.0,"payBaseHq":0.0,"paySafeTeam":0.0,"paySafeHq":0.0},"11":{"quota":0.0,"payBaseTeam":0.0,"payBaseHq":0.0,"paySafeTeam":0.0,"paySafeHq":0.0},"12":{"quota":0.0,"payBaseTeam":0.0,"payBaseHq":0.0,"paySafeTeam":0.0,"paySafeHq":0.0}},"y":{"tg_foot":180000.0,"tg_rev":75000.0,"tg_gm":8955.0,"baseTeam":12235223.0,"baseHq":0.0,"carryTeam":1994033.9234,"carryHq":0.0,"carryMgmt":0.0,"util":90.0,"utilAvg":85.0}},"xb":{"m":{"1":{"foot":6203.0,"rev":6928.0,"gm":1667.0,"quota":272133.0,"accident":24300.0,"safeTeam":372000.0,"safeHq":47250.0,"payBaseTeam":1440354.0,"payBaseHq":158369.0,"paySafeTeam":448990.0,"paySafeHq":50056.0},"