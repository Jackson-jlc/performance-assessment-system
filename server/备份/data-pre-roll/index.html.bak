/* ---------- 左侧菜单栏：手动隐藏／显示 ---------- */
const ICON_PANEL='<svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">'+
  '<rect x="2.6" y="3.6" width="14.8" height="12.8" rx="1.6"/><path d="M7.6 3.6v12.8"/></svg>';
const ICON_MENU='<svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">'+
  '<path d="M3.2 5.6h13.6M3.2 10h13.6M3.2 14.4h13.6"/></svg>';
function setNav(hidden){
  const app=$('#app'), b=$('#navBtn');
  app.classList.toggle('nav-hidden', hidden);
  b.innerHTML = hidden ? ICON_MENU : ICON_PANEL;
  const lbl = hidden ? '显示菜单栏' : '隐藏菜单栏';
  b.setAttribute('aria-label',lbl); b.title=lbl;
  b.setAttribute('aria-expanded', !hidden);
  try{ localStorage.setItem('kh-nav', hidden?'hidden':'shown'); }catch(e){}
}
(function(){
  let saved=null; try{ saved=localStorage.getItem('kh-nav'); }catch(e){}
  setNav(saved==='hidden');
  $('#navBtn').onclick=()=>setNav(!$('#app').classList.contains('nav-hidden'));
})();

/* ---------- 显示主题：两态图标切换，右上角 ---------- */
const ICON_SUN='<svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">'+
  '<circle cx="10" cy="10" r="3.4"/><path d="M10 2.2v1.9M10 15.9v1.9M17.8 10h-1.9M4.1 10H2.2M15.5 4.5l-1.3 1.3M5.8 14.2l-1.3 1.3M15.5 15.5l-1.3-1.3M5.8 5.8L4.5 4.5"/></svg>';
const ICON_MOON='<svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">'+
  '<path d="M16.3 12.4A6.9 6.9 0 0 1 7.6 3.7a6.9 6.9 0 1 0 8.7 8.7z"/></svg>';
function effTheme(){
  const st=document.documentElement.getAttribute('data-theme');
  if(st==='dark'||st==='light') return st;
  try{ return matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'; }catch(e){ return 'light'; }
}
function paintTheme(){
  const cur=effTheme(), next=cur==='dark'?'light':'dark', b=$('#themeBtn');
  b.innerHTML = next==='dark' ? ICON_MOON : ICON_SUN;
  const lbl='切换到'+(next==='dark'?'暗色':'亮色')+'主题';
  b.setAttribute('aria-label',lbl); b.title=lbl; b.setAttribute('aria-pressed', cur==='dark');
}
function setTheme(t){
  document.documentElement.setAttribute('data-theme',t);
  try{ localStorage.setItem('kh-theme',t); }catch(e){}
  paintTheme();
}
(function(){
  let saved=null; try{ saved=localStorage.getItem('kh-theme'); }catch(e){}
  if(saved==='light'||saved==='dark') document.documentElement.setAttribute('data-theme',saved);
  else { try{ localStorage.removeItem('kh-theme'); }catch(e){} }
  paintTheme();
  $('#themeBtn').onclick=()=>setTheme(effTheme()==='dark'?'light':'dark');
  try{ matchMedia('(prefers-color-scheme: dark)').addEventListener('change',()=>{
    if(!document.documentElement.getAttribute('data-theme')) paintTheme(); }); }catch(e){}
})();

const msel=$('#rollMonth');
MONTHS.slice().reverse().forEach(m=>{ const o=el('option',null,m); o.value=m; msel.appendChild(o); });
msel.value=ROLL_MONTH;
msel.addEventListener('change',e=>{ ROLL_MONTH=e.target.value; renderRoll(); });
renderRollCfg(); renderRollRules();

// 示例数据初始化已移入 boot()，在后端模式确认后按需执行（见下方）
(function(){
  const ms=$('#preMonth');
  for(let i=1;i<=12;i++){ const v='2026-'+String(i).padStart(2,'0'); const o=el('option',null,v); o.value=v; ms.appendChild(o); }
  ms.value='2026-06';
  $('#preAdd').onclick=preAddMonth;
  $('#exportXls').onclick=exportWell;
  (function(){
    const card=$('#formCard'), btn=$('#formFold'), act=$('#formFoldAct');
    function paint(){ const open=!card.classList.contains('closed');
      act.textContent=open?'收起填报':'展开填报'; btn.setAttribute('aria-expanded',open); }
    let sv=null; try{ sv=localStorage.getItem('kh-dashform'); }catch(e){}
    if(sv==='1') card.classList.remove('closed');
    paint();
    btn.onclick=()=>{ card.classList.toggle('closed');
      try{ localStorage.setItem('kh-dashform', card.classList.contains('closed')?'0':'1'); }catch(e){}
      paint(); if(!card.classList.contains('closed')) renderReport(agg()); };
  })();
  (function(){
    const sp=document.querySelector('.wellsplit'), fb=$('#formToggle'), vb=$('#viewToggle');
    // which='form' 折左栏（参数录入），which='view' 折右栏（考核表）；两栏互斥，只允许折一侧
    function applyFold(which,hidden){
      const left=which==='form', c=sp.children[left?0:1];
      if(hidden){ const cur=c.getBoundingClientRect().width;
        const w=cur>1?cur:Math.min(392,Math.max(320,sp.clientWidth*0.32));
        c.style.width=w+'px'; c.style.transform='translateX('+(left?'-':'')+(w+20)+'px)'; }
      else { c.style.width=''; c.style.transform=''; }
      sp.classList.toggle(left?'hide-form':'hide-view',hidden);
    }
    addEventListener('resize',()=>{
      if(sp.classList.contains('hide-form')) applyFold('form',true);
      if(sp.classList.contains('hide-view')) applyFold('view',true); });
    const SVG='<svg viewBox="0 0 20 20" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2.6" y="3.6" width="14.8" height="12.8" rx="1.9"/><path d="';
    const ICO_L=SVG+'M7.6 3.6v12.8"/></svg>';
    const ICO_R=SVG+'M7.6 3.6v12.8M11 8l2 2-2 2"/></svg>';
    const ICO_VL=SVG+'M12.4 3.6v12.8"/></svg>';
    const ICO_VR=SVG+'M12.4 3.6v12.8M9 8l-2 2 2 2"/></svg>';
    function paintBars(){
      const hf=sp.classList.contains('hide-form'), hv=sp.classList.contains('hide-view');
      fb.innerHTML=(hf?ICO_R:ICO_L)+(hf?'显示参数栏':'隐藏参数栏');
      fb.setAttribute('aria-expanded',!hf); fb.title=hf?'显示参数录入栏':'隐藏参数录入栏，右栏占满宽度';
      vb.innerHTML=(hv?ICO_VR:ICO_VL)+(hv?'显示考核表':'隐藏考核表');
      vb.setAttribute('aria-expanded',!hv); vb.title=hv?'显示单井经营考核表':'隐藏单井经营考核表，参数录入栏占满宽度'; }
    function saveFold(){ try{
      localStorage.setItem('kh-form-fold', sp.classList.contains('hide-form')?'1':'0');
      localStorage.setItem('kh-view-fold', sp.classList.contains('hide-view')?'1':'0'); }catch(e){} }
    window.showWellForm=()=>{ applyFold('form',false); saveFold(); paintBars(); };
    let sv=null, sv2=null;
    try{ sv=localStorage.getItem('kh-form-fold'); sv2=localStorage.getItem('kh-view-fold'); }catch(e){}
    if(sv==='1') applyFold('form',true); else if(sv2==='1') applyFold('view',true);
    paintBars();
    function toggle(which){ const hidden=!sp.classList.contains(which==='form'?'hide-form':'hide-view');
      if(hidden) applyFold(which==='form'?'view':'form',false);
      applyFold(which,hidden); saveFold(); paintBars(); }
    fb.onclick=()=>toggle('form');
    vb.onclick=()=>toggle('view');
  })();
  (function(){
    const foot=document.querySelector('.wellfoot'), btn=$('#storeToggle');
    const CHEV='<svg viewBox="0 0 20 20" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M5.5 8l4.5 4.5L14.5 8"/></svg>';
    function paint(){ const on=!foot.classList.contains('fold');
      btn.innerHTML=CHEV+(on?'收起':'展开'); btn.setAttribute('aria-expanded',on); }
    let saved=null; try{ saved=localStorage.getItem('kh-store-fold'); }catch(e){}
    if(saved!=='0') foot.classList.add('fold');
    paint();
    btn.onclick=()=>{ foot.classList.toggle('fold');
      try{ localStorage.setItem('kh-store-fold', foot.classList.contains('fold')?'1':'0'); }catch(e){}
      paint(); };
  })();
  $('#preWellSel').addEventListener('change',e=>{ PRE_WELL=e.target.value; preMsg(''); renderPre(); });
  $('#toPreMod').onclick=()=>{ PRE_WELL='__form'; go('pre'); };
})();
/* ============================ 后端联通（可选） ============================ */
// 部署为 server/public/index.html 由 Node 后端托管时，这些 fetch 会命中同源的
// /api/*，井库/定额库/填报数据改成读写服务器；作为 claude.ai artifact 或本地
// 文件直接打开时，/api/health 探测不到后端，自动回退成原来的 localStorage 单机模式，
// 同一份文件两种场景都能跑。
function apiFetch(path,opts){
  return fetch(path, Object.assign({credentials:'include',headers:{'content-type':'application/json'}}, opts||{}));
}
async function backendPing(){
  try{ const r=await apiFetch('/api/health'); return r.ok; }catch(e){ return false; }
}
async function backendWhoAmI(){
  try{ const r=await apiFetch('/api/auth/me'); return r.ok ? await r.json() : null; }catch(e){ return null; }
}
function showLoginGate(){
  return new Promise(resolve=>{
    const ov=el('div'); ov.id='loginGate';
    ov.style.cssText='position:fixed;inset:0;z-index:200;display:flex;align-items:center;justify-content:center;background:var(--ground)';
    ov.innerHTML='<div class="card" style="width:320px;max-width:88vw"><div class="body">'+
      '<h3 style="font-size:17px">登录</h3><p class="sub" style="margin:4px 0 16px">钻井经营考核系统 · 数据存于服务器</p>'+
      '<div class="fld"><label>用户名</label><input id="loginUser" type="text" autocomplete="username"></div>'+
      '<div class="fld"><label>密码</label><input id="loginPass" type="password" autocomplete="current-password"></div>'+
      '<div id="loginErr" class="sub" style="color:var(--neg);min-height:15px;margin:2px 0 12px"></div>'+
      '<button class="btn" id="loginSubmit" type="button" style="width:100%">登录</button></div></div>';
    document.body.appendChild(ov);
    const u=ov.querySelector('#loginUser'), pw=ov.querySelector('#loginPass'),
          err=ov.querySelector('#loginErr'), btn=ov.querySelector('#loginSubmit');
    async function submit(){
      err.textContent=''; btn.disabled=true;
      try{
        const r=await apiFetch('/api/auth/login',{method:'POST',body:JSON.stringify({username:u.value.trim(),password:pw.value})});
        if(!r.ok){ const j=await r.json().catch(()=>({})); err.textContent = j.error==='invalid_credentials' ? '用户名或密码错误' : '登录失败'; btn.disabled=false; return; }
        ov.remove(); resolve(true);
      }catch(e){ err.textContent='网络错误，请重试'; btn.disabled=false; }
    }
    btn.onclick=submit;
    pw.addEventListener('keydown',e=>{ if(e.key==='Enter') submit(); });
    u.focus();
  });
}
async function ensureBackendAuth(){
  const alive=await backendPing();
  if(!alive) return false; // 无后端：保持原有 localStorage 单机模式
  const me=await backendWhoAmI();
  if(me){ BACKEND_MODE=true; return true; }
  await showLoginGate();
  BACKEND_MODE=true; return true;
}
async function hydrateFromBackend(){
  const ok=await ensureBackendAuth();
  if(!ok) return;
  try{
    const [wr,qr,fr]=await Promise.all([apiFetch('/api/wells'),apiFetch('/api/quota'),apiFetch('/api/filings/'+YEAR)]);
    if(wr.ok){ const w=await wr.json(); if(Array.isArray(w)) WELLS=w; } // 服务器是权威源，哪怕返回空数组也如实采用（覆盖启动时可能本地写入的示例井）
    if(qr.ok){ const q=await qr.json(); if(q && Array.isArray(q.blocks)) Object.assign(Q,q); }
    if(fr.ok){ const f=await fr.json(); if(f && f.u && f.status) DS=f; }
  }catch(e){ console.warn('[后端] 拉取初始数据失败，使用本地缓存：', e); }
}
function saveQuota(){ if(BACKEND_MODE) apiFetch('/api/quota',{method:'PUT',body:JSON.stringify(Q)}).catch(()=>{}); }

(async function boot(){
  await hydrateFromBackend();
  // 单机模式（无后端）且首次使用时才填示例数据帮助上手；后端模式服务器已是权威，不预填示例
  if(!BACKEND_MODE && !WELLS){ WELLS=[mkRecord('approved','示例：人工录入演示数据')]; saveWells(); applyDemo(); }
  if(!WELLS) WELLS=[];   // 兜底：后端模式下若 /api/wells 拉取失败，保证 WELLS 不为 null，避免后续渲染崩溃
  ensureQuotaVersion();
  renderWellActions(); render(); renderPre(); renderWellStore(); renderTeam(); go('dash');
})();
</script>


</body>
</html>