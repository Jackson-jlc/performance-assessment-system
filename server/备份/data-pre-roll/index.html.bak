202,"carryHq":133769.2437,"carryMgmt":0.0,"util":80.0,"utilAvg":85.0}},"cq":{"m":{"1":{"foot":0.0,"rev":0.0,"gm":0.0,"quota":142963.0,"accident":280600.0,"safeTeam":190103.2258,"safeHq":31200.0,"payBaseTeam":-15000.0,"payBaseHq":0.0,"paySafeTeam":0.0,"paySafeHq":0.0},"2":{"foot":4364.0,"rev":468.0,"gm":0.0,"quota":0.0,"safeTeam":30077.4194,"safeHq":31800.0,"payBaseTeam":-2500.0,"payBaseHq":0.0,"paySafeTeam":0.0,"paySafeHq":0.0},"3":{"foot":74164.0,"rev":9435.0,"gm":0.0,"quota":0.0,"accident":0.0,"safeTeam":106700.0,"safeHq":31500.0,"payBaseTeam":968790.0,"payBaseHq":113086.0,"paySafeTeam":102970.0,"paySafeHq":38350.0},"4":{"foot":100885.0,"rev":10978.8065,"gm":1050.98,"quota":93198.0,"safeTeam":301458.0645,"safeHq":30900.0,"payBaseTeam":1985084.0,"payBaseHq":110718.0,"paySafeTeam":258169.0,"paySafeHq":39250.0},"5":{"foot":104111.0,"rev":10614.0,"gm":2911.31,"quota":272271.7526,"safeTeam":368466.6667,"safeHq":31500.0,"payBaseTeam":2440396.0,"payBaseHq":240035.0,"paySafeTeam":328984.0,"paySafeHq":39000.0},"6":{"foot":96511.0,"rev":10567.0,"gm":2660.0,"quota":318970.6444,"accident":396900.0,"safeTeam":383432.2581,"safeHq":31500.0,"payBaseTeam":2770204.0,"payBaseHq":113516.0,"paySafeTeam":368795.0,"paySafeHq":39000.0},"7":{"foot":87582.0,"rev":8867.0,"gm":1668.0,"quota":169497.0,"safeTeam":354640.0,"safeHq":31500.0,"payBaseTeam":2703165.0,"payBaseHq":205443.0,"paySafeTeam":355088.0,"paySafeHq":39250.0},"8":{"foot":91679.0,"rev":9606.0,"gm":2040.0,"quota":372833.0,"multiRig":0.0,"hqIncent":320000.0,"safeTeam":369277.4194,"safeHq":31500.0,"payBaseTeam":3396734.0,"payBaseHq":122550.0,"paySafeTeam":352907.0,"paySafeHq":39250.0},"9":{"quota":0.0,"accident":0.0,"safeTeam":0.0,"safeHq":0.0,"payBaseTeam":0.0,"payBaseHq":0.0,"paySafeTeam":0.0,"paySafeHq":0.0},"10":{"quota":0.0,"safeTeam":0.0,"safeHq":0.0,"payBaseTeam":0.0,"payBaseHq":0.0,"paySafeTeam":0.0,"paySafeHq":0.0},"11":{"quota":0.0,"safeTeam":0.0,"safeHq":0.0,"payBaseTeam":0.0,"payBaseHq":0.0,"paySafeTeam":0.0,"paySafeHq":0.0},"12":{"quota":0.0,"safeTeam":0.0,"safeHq":0.0,"payBaseTeam":0.0,"payBaseHq":0.0,"paySafeTeam":0.0,"paySafeHq":0.0}},"y":{"tg_foot":700000.0,"tg_rev":72000.0,"tg_gm":11203.0,"baseTeam":21939775.0,"baseHq":1345890.0,"carryTeam":1079078.5248,"carryHq":38784.2975,"carryMgmt":0.0,"util":88.0,"utilAvg":85.0}}};

/* 填报表定义 */
const TABS=[
  {k:'ind',   n:'经营指标', fields:[['foot','进尺（米）',0],['rev','市场创收（万元）',2],['gm','贡献毛益额（万元）',2]]},
  {k:'accrue',n:'奖金计提', fields:[['safeTeam','安效奖·钻井队',0],['safeHq','安效奖·机关',0],['quota','定员与调剂考核',0],
                                    ['accident','事故复杂专项',0],['multiRig','一队多机／跨区域',0],['hqIncent','机关过程激励',0]]},
  {k:'pay',   n:'奖金实发', fields:[['payBaseTeam','基础月奖·钻井队',0],['payBaseHq','基础月奖·机关',0],
                                    ['paySafeTeam','安效奖·钻井队',0],['paySafeHq','安效奖·机关',0]]},
  {k:'year',  n:'年度参数', fields:[['tg_foot','年度进尺指标（米）',0],['tg_rev','年度创收指标（万元）',2],['tg_gm','年度毛益额指标（万元）',2],
                                    ['baseTeam','切块基数·钻井队（元）',0],['baseHq','切块基数·机关（元）',0],
                                    ['carryTeam','上年政策1月切块·队（元）',0],['carryHq','上年政策1月切块·机关（元）',0],
                                    ['carryMgmt','上年度管理指标考核（元）',0],
                                    ['util','钻机利用率（%）',2],['utilAvg','渤海钻探平均利用率（%）',2]]}
];
const ST=[['draft','草稿','man'],['submitted','已提交','sys'],['approved','已审核','ai']];

/* ---------- 存储 ---------- */
const LSKEY='kh-report-'+YEAR;
function blankDS(){
  const d={u:{},status:{}};
  UNITS.forEach(u=>{
    const src=SEED[u.k];
    d.u[u.k]={y:Object.assign({},src.y),m:{}};
    for(let i=1;i<=12;i++) d.u[u.k].m[i]=Object.assign({},src.m[i]||{});
  });
  for(let i=1;i<=12;i++){ d.status[i]={}; UNITS.forEach(u=>{ d.status[i][u.k]= i<=8?'approved':'draft'; }); }
  return d;
}
let DS=(function(){ try{ const raw=localStorage.getItem(LSKEY); if(raw){ const p=JSON.parse(raw); if(p&&p.u&&p.status) return p; } }catch(e){} return blankDS(); })();
function saveDS(){ try{ localStorage.setItem(LSKEY,JSON.stringify(DS)); }catch(e){}
  if(BACKEND_MODE) apiFetch('/api/filings/'+YEAR,{method:'PUT',body:JSON.stringify(DS)}).catch(()=>{}); }
const gv=(k,m,f)=>+(DS.u[k].m[m][f]||0);
const gy=(k,f)=>+(DS.u[k].y[f]||0);
function filledMonths(k){ let n=0; for(let i=1;i<=12;i++) if(DS.status[i][k]!=='draft'||I_KEY.some(f=>gv(k,i,f))) n++; return n; }

/* ---------- 汇总 ---------- */
function agg(){
  const rows=UNITS.map(u=>{
    const sum=f=>{ let s=0; for(let i=1;i<=12;i++) s+=gv(u.k,i,f); return s; };
    const ac=I_KEY.map(sum), tg=I_KEY.map(f=>gy(u.k,'tg_'+f));
    const r=tg.map((t,i)=> t ? ac[i]/t : 0);
    const rate=r.reduce((s,v,i)=>s+v*IW[i],0);
    const base=gy(u.k,'baseTeam'), hqBase=gy(u.k,'baseHq');
    const rateCap=Math.min(rate,1.2);                           // 第八条：完成率超100%按同比例核增，最大不超过120%
    const allocTeam=base*rateCap, allocHq=hqBase*rateCap;
    const baseAcc=gy(u.k,'carryTeam')+allocTeam+gy(u.k,'carryHq')+allocHq;
    const other=['safeTeam','safeHq','quota','accident','multiRig','hqIncent'].reduce((s,f)=>s+sum(f),0);
    const accrued=baseAcc+other+gy(u.k,'carryMgmt');
    const pay={baseTeam:sum('payBaseTeam'),baseHq:sum('payBaseHq'),safeTeam:sum('paySafeTeam'),safeHq:sum('paySafeHq')};
    const paid=pay.baseTeam+pay.baseHq+pay.safeTeam+pay.safeHq;
    // 第八条 50% 保底：发放率<50% 且该单位钻机利用率 > 渤海钻探平均利用率时，按 50% 进度发放
    const util=gy(u.k,'util'), utilAvg=gy(u.k,'utilAvg');
    let guardAmt=0, guardNote='';
    if(accrued>0 && paid/accrued<0.5 && util>0 && utilAvg>0 && util>utilAvg){
      guardAmt=accrued*0.5;
      guardNote='发放率'+pct(paid/accrued,1)+'<50%，钻机利用率 '+pct(util,1)+' > 渤海钻探平均 '+pct(utilAvg,1)+'，按 50% 进度保底';
    }
    const mm={}; I_KEY.forEach(f=>{ mm[f]=[]; for(let i=1;i<=12;i++) mm[f].push(gv(u.k,i,f)); });
    const fm=filledMonths(u.k);
    return Object.assign({},u,{tg,ac,r,rate,base,hqBase,allocTeam,allocHq,alloc:allocTeam+allocHq,
      baseAcc,other,accrued,pay,paid,left:accrued-paid,m:mm,fm,util,utilAvg,guardAmt,guardNote,
      pr:tg.map((t,i)=> t*fm/12 ? ac[i]/(t*fm/12) : 0)});
  });
  const S2=f=>rows.reduce((s,x)=>s+f(x),0);
  const tg=[0,1,2].map(i=>S2(x=>x.tg[i])), ac=[0,1,2].map(i=>S2(x=>x.ac[i]));
  const r=tg.map((t,i)=> t ? ac[i]/t : 0);
  const fm=Math.max.apply(null,rows.map(x=>x.fm));
  const co={k:'co',n:'公司合计',note:'四口径汇总',tg,ac,r,fm,
    rate:r.reduce((s,v,i)=>s+v*IW[i],0),
    pr:tg.map((t,i)=> t*fm/12 ? ac[i]/(t*fm/12) : 0),
    base:S2(x=>x.base), hqBase:S2(x=>x.hqBase),
    allocTeam:S2(x=>x.allocTeam), allocHq:S2(x=>x.allocHq), alloc:S2(x=>x.alloc),
    baseAcc:S2(x=>x.baseAcc), other:S2(x=>x.other),
    accrued:S2(x=>x.accrued), paid:S2(x=>x.paid), left:S2(x=>x.left),
    pay:{baseTeam:S2(x=>x.pay.baseTeam),baseHq:S2(x=>x.pay.baseHq),
         safeTeam:S2(x=>x.pay.safeTeam),safeHq:S2(x=>x.pay.safeHq)}};
  co.progRate=co.pr.reduce((s,v,i)=>s+v*IW[i],0);
  rows.forEach(o=>{ o.progRate=o.pr.reduce((s,v,i)=>s+v*IW[i],0); });
  const sorted=[...rows].sort((x,y)=>y.rate-x.rate);
  return {rows,co,hi:sorted[0],lo:sorted[sorted.length-1]};
}
function refreshAll(){ const M=agg(); renderDashKpi(M); renderMarket(M); renderSurplus(M); renderTrend(M); renderReport(M); }

/* ---------- 填报 ---------- */
let formTab='ind', formMonth=8;
function renderReport(M){
  const fs=$('#formFoldSub');
  if(fs) fs.textContent='当前 '+YEAR+'-'+String(formMonth).padStart(2,'0')+
    ' · 已填报 '+M.co.fm+' / 12 月 · '+TABS.find(t=>t.k===formTab).n;
  const tab=TABS.find(t=>t.k===formTab), isYear=formTab==='year';
  $('#formMonthWrap').hidden=isYear;
  const dec=f=>tab.fields.find(x=>x[0]===f)[2];
  const val=(k,f)=> isYear ? gy(k,f) : gv(k,formMonth,f);
  const rowTotal=k=>tab.fields.reduce((s,f)=>s+val(k,f[0]),0);

  let h='<thead><tr><th>主体单位</th>'+tab.fields.map(f=>'<th>'+f[1]+'</th>').join('')+
        (isYear?'':'<th>本月合计</th><th>填报状态</th>')+'</tr></thead><tbody>';
  UNITS.forEach(u=>{
    h+='<tr><td>'+u.n+'<div class="sub">'+u.note+'</div></td>'+
      tab.fields.map(f=>'<td><input type="number" step="'+(f[2]?0.01:1)+'" data-u="'+u.k+'" data-f="'+f[0]+'" value="'+val(u.k,f[0])+'"></td>').join('');
    if(!isYear){
      const st=DS.status[formMonth][u.k], sd=ST.find(x=>x[0]===st);
      h+='<td data-sum="'+u.k+'">'+fmt(rowTotal(u.k),0)+'</td><td><button class="pill '+sd[2]+'" data-st="'+u.k+'" style="cursor:pointer;border:0">'+sd[1]+'</button></td>';
    }
    h+='</tr>';
  });
  if(!isYear){
    h+='<tr class="total"><td>本月合计</td>'+
      tab.fields.map(f=>'<td data-col="'+f[0]+'">'+fmt(UNITS.reduce((s,u)=>s+val(u.k,f[0]),0),f[2])+'</td>').join('')+
      '<td data-sum="all">'+fmt(UNITS.reduce((s,u)=>s+rowTotal(u.k),0),0)+'</td><td></td></tr>';
  }
  $('#formTbl').innerHTML=h+'</tbody>';

  $('#formTbl').querySelectorAll('input').forEach(inp=>{
    inp.addEventListener('input',e=>{
      const k=e.target.dataset.u, f=e.target.dataset.f, v=parseFloat(e.target.value)||0;
      if(isYear) DS.u[k].y[f]=v; else DS.u[k].m[formMonth][f]=v;
      saveDS();
      const M2=agg();
      renderDashKpi(M2); renderMarket(M2); renderSurplus(M2); renderTrend(M2); renderProgress(M2);
      if(!isYear){
        const T=$('#formTbl');
        UNITS.forEach(u=>{ const c=T.querySelector('[data-sum="'+u.k+'"]'); if(c) c.textContent=fmt(rowTotal(u.k),0); });
        tab.fields.forEach(fd=>{ const c=T.querySelector('[data-col="'+fd[0]+'"]');
          if(c) c.textContent=fmt(UNITS.reduce((s,u)=>s+val(u.k,fd[0]),0),fd[2]); });
        const cAll=T.querySelector('[data-sum="all"]');
        if(cAll) cAll.textContent=fmt(UNITS.reduce((s,u)=>s+rowTotal(u.k),0),0);
      }
    });
  });
  $('#formTbl').querySelectorAll('button[data-st]').forEach(b=>{
    b.onclick=()=>{ const k=b.dataset.st, i=ST.findIndex(x=>x[0]===DS.status[formMonth][k]);
      DS.status[formMonth][k]=ST[(i+1)%ST.length][0]; saveDS(); refreshAll(); };
  });

  renderProgress(M);
}

function renderProgress(M){
  let g='<table><thead><tr><th>填报进度</th>'+MONTH_LBL.map(l=>'<th>'+l.replace('月','')+'</th>').join('')+'<th>已填报</th></tr></thead><tbody>';
  UNITS.forEach(u=>{
    g+='<tr><td>'+u.n+'</td>';
    for(let i=1;i<=12;i++){
      const st=DS.status[i][u.k], has=I_KEY.some(f=>gv(u.k,i,f));
      const cls= st==='approved'?'ai':(st==='submitted'?'sys':(has?'man':''));
      g+='<td><button class="pill '+cls+'" data-go-m="'+i+'" title="'+u.n+' '+i+'月 · '+ST.find(x=>x[0]===st)[1]+
         '" style="cursor:pointer;border:'+(cls?'0':'1px solid var(--line)')+';min-width:20px;justify-content:center">'+
         (cls==='ai'?'✓':(cls==='sys'?'○':(cls==='man'?'·':' ')))+'</button></td>';
    }
    g+='<td>'+M.rows.find(x=>x.k===u.k).fm+' / 12</td></tr>';
  });
  $('#formProgress').innerHTML=g+'</tbody></table>';
  $('#formProgress').querySelectorAll('button[data-go-m]').forEach(b=>{
    b.onclick=()=>{ formMonth=+b.dataset.goM; $('#formMonth').value=formMonth; if(formTab==='year') formTab='ind'; renderTabs(); refreshAll(); };
  });
}

/* ---------- 月度完成趋势 ---------- */
let trendMetric='foot', trendTable=false;
const SCALE={foot:{d:10000,u:'万米'},rev:{d:1,u:'万元'},gm:{d:1,u:'万元'}};
function niceMax(v){ if(v<=0) return 1; const p=Math.pow(10,Math.floor(Math.log10(v)));
  for(const x of [1,1.25,1.5,2,2.5,3,4,5,6,8,10]) if(p*x>=v) return p*x; return p*10; }
function rtr(x,y,w,h,r){ r=Math.min(r,w/2,Math.max(h,0));
  return 'M'+x+','+(y+h)+' L'+x+','+(y+r)+' Q'+x+','+y+' '+(x+r)+','+y+
         ' L'+(x+w-r)+','+y+' Q'+(x+w)+','+y+' '+(x+w)+','+(y+r)+' L'+(x+w)+','+(y+h)+' Z'; }

function renderTrend(M){
  const host=$('#trendWrap'), sc=SCALE[trendMetric], dec=trendMetric==='foot'?1:0;
  const N=Math.max(M.co.fm,1);
  const lbl=MONTH_LBL.slice(0,N);
  const vals=M.rows.map(o=>o.m[trendMetric].slice(0,N).map(v=>v/sc.d));
  const tot=lbl.map((_,i)=>vals.reduce((s,v)=>s+v[i],0));

  $('#trendLegend').innerHTML=M.rows.map(o=>'<span><i style="background:'+o.color+'"></i>'+o.n+'</span>').join('')+
    '<span style="margin-left:auto;color:var(--muted)">单位：'+sc.u+'</span>';

  if(trendTable){
    host.innerHTML='<div class="scroll"><table><thead><tr><th>主体单位</th>'+
      lbl.map(l=>'<th>'+l+'</th>').join('')+'<th>年累</th></tr></thead><tbody>'+
      M.rows.map((o,si)=>'<tr><td>'+o.n+'</td>'+vals[si].map(v=>'<td>'+fmt(v,dec)+'</td>').join('')+
        '<td><strong>'+fmt(vals[si].reduce((a,b)=>a+b,0),dec)+'</strong></td></tr>').join('')+
      '<tr class="total"><td>公司合计</td>'+tot.map(v=>'<td>'+fmt(v,dec)+'</td>').join('')+
      '<td>'+fmt(tot.reduce((a,b)=>a+b,0),dec)+'</td></tr></tbody></table></div>';
    return;
  }

  const W=680,H=248,L=54,R=10,T=16,B=32;
  const pw=W-L-R, ph=H-T-B, step=pw/N, bw=Math.min(step*0.6,54), max=niceMax(Math.max.apply(null,tot)*1.12);
  const y=v=>T+ph*(1-v/max);
  let g='';
  for(let i=0;i<=4;i++){ const v=max*i/4, yy=y(v);
    g+='<line x1="'+L+'" y1="'+yy+'" x2="'+(W-R)+'" y2="'+yy+'" stroke="var(--line)" stroke-width="1"'+(i?' stroke-dasharray="2 3"':'')+'/>'+
       '<text x="'+(L-8)+'" y="'+(yy+3.5)+'" text-anchor="end" font-size="10" fill="var(--muted)">'+fmt(v,dec)+'</text>'; }
  let bars='';
  lbl.forEach((t,i)=>{
    const bx=L+step*i+(step-bw)/2;
    let acc=0;
    M.rows.forEach((o,si)=>{
      const v=vals[si][i]; if(v<=0) return;
      const y0=y(acc+v), y1=y(acc), h=Math.max(y1-y0-2,1);
      const top=vals.slice(si+1).every(x=>x[i]<=0);
      bars+= top
        ? '<path class="seg" data-i="'+i+'" data-s="'+si+'" d="'+rtr(bx,y0,bw,h,4)+'" fill="'+o.color+'"/>'
        : '<rect class="seg" data-i="'+i+'" data-s="'+si+'" x="'+bx+'" y="'+y0+'" width="'+bw+'" height="'+h+'" fill="'+o.color+'"/>';
      acc+=v;
    });
    bars+='<text x="'+(bx+bw/2)+'" y="'+(y(acc)-6)+'" text-anchor="middle" font-size="10" fill="var(--ink-2)">'+fmt(acc,dec)+'</text>';
    bars+='<text x="'+(bx+bw/2)+'" y="'+(H-B+16)+'" text-anchor="middle" font-size="10.5" fill="var(--muted)">'+t+'</text>';
  });
  host.innerHTML='<svg viewBox="0 0 '+W+' '+H+'" role="img" aria-label="'+I_NAME[trendMetric]+'月度完成趋势，按主体单位堆叠">'+
    g+bars+'<line x1="'+L+'" y1="'+(T+ph)+'" x2="'+(W-R)+'" y2="'+(T+ph)+'" stroke="var(--line)" stroke-width="1.5"/></svg>'+
    '<div class="tip" id="tip" hidden></div>';

  const tip=$('#tip');
  host.querySelectorAll('.seg').forEach(node=>{
    node.addEventListener('mouseenter',ev=>{
      const i=+ev.target.dataset.i, si=+ev.target.dataset.s, v=vals[si][i];
      tip.innerHTML='<div style="font-weight:600;margin-bottom:4px">'+lbl[i]+' · '+I_NAME[trendMetric]+'</div>'+
        M.rows.map((o,kk)=>'<div class="row" style="'+(kk===si?'':'opacity:.5')+'"><span><i style="display:inline-block;width:8px;height:8px;border-radius:2px;background:'+o.color+';margin-right:5px"></i>'+o.n+'</span><b>'+fmt(vals[kk][i],dec)+'</b></div>').join('')+
        '<div class="row" style="border-top:1px solid var(--line-2);margin-top:4px;padding-top:4px"><span>公司合计</span><b>'+fmt(tot[i],dec)+' '+sc.u+'</b></div>'+
        '<div class="row"><span>本段占比</span><b>'+pct(tot[i]?v/tot[i]:0,1)+'</b></div>';
      tip.hidden=false;
      const r=ev.target.getBoundingClientRect(), hr=host.getBoundingClientRect();
      tip.style.left=Math.min(Math.max(r.left-hr.left+r.width/2-72,0),Math.max(hr.width-152,0))+'px';
      tip.style.top=Math.max(r.top-hr.top-tip.offsetHeight-8,0)+'px';
    });
    node.addEventListener('mouseleave',()=>{ tip.hidden=true; });
  });
}

/* ---------- 主体单位汇总表（只读，全部由填报派生） ---------- */
let mktScope='year', mktMonth=8;
function renderMarket(M){
  const isYear=mktScope==='year', isMonth=mktScope==='month';
  const mv=(o,i)=> o.m ? (o.m[I_KEY[i]][mktMonth-1]||0)
                       : M.rows.reduce((t,x)=>t+(x.m[I_KEY[i]][mktMonth-1]||0),0);
  const mRatio=o=>I_KEY.map((f,i)=>{ const t=o.tg[i]/12; return t? mv(o,i)/t : 0; });
  const segBar=r=>'<span class="bar" style="width:70px;display:inline-flex;vertical-align:middle;margin-right:7px">'+
    r.map((v,i)=>'<i style="width:'+Math.max(0,Math.min(v*IW[i]/1.2*100,100))+'%;background:'+['var(--c1)','var(--c2)','var(--c3)'][i]+'"></i>').join('')+'</span>';
  const line=(o,strong)=>{
    const mr=isMonth?mRatio(o):null;
    const rate=isMonth ? mr.reduce((t,v,i)=>t+v*IW[i],0) : (isYear?o.rate:o.progRate);
    const bars=isMonth?mr:(isYear?o.r:o.pr);
    const cells=I_KEY.map((f,i)=>{
      const t=isMonth?o.tg[i]/12:(isYear?o.tg[i]:o.tg[i]*o.fm/12);
      const ac=isMonth?mv(o,i):o.ac[i];
      const ratio=isMonth?mr[i]:(isYear?o.r[i]:o.pr[i]);
      const cls=ratio>=1?'pos':(ratio<0.6?'neg':'');
      return '<td>'+fmt(t,I_DEC[f])+'</td><td>'+fmt(ac,I_DEC[f])+'</td><td class="'+cls+'">'+pct(ratio,2)+'</td>';
    }).join('');
    const alloc=isMonth ? (o.base+o.hqBase)/12*rate : o.alloc;
    return '<tr class="'+(strong?'total':'')+'"><td>'+o.n+(o.note?'<div class="sub">'+o.note+'</div>':'')+'</td>'+cells+
      '<td>'+segBar(bars)+'<strong>'+pct(rate,2)+'</strong></td>'+
      '<td>'+fmt(o.base,0)+'</td><td>'+(o.hqBase?fmt(o.hqBase,0):'<span class="dim">—</span>')+'</td>'+
      '<td><strong>'+fmt(alloc,0)+'</strong></td><td>'+fmt(o.baseAcc,0)+'</td></tr>';
  };
  const hd=isMonth?'月度指标':(isYear?'年度指标':'进度指标');
  const ac=isMonth?'本月完成':'年累';
  const rt=isMonth?'月度完成率':(isYear?'过程指标完成率':'进度完成率');
  const al=isMonth?'本月切块额（元）':'年累切块额（元）';
  $('#mktTbl').innerHTML=
    '<thead><tr><th rowspan="2">主体单位</th>'+
      '<th colspan="3">进尺（米）· 30%</th><th colspan="3">市场创收（万元）· 40%</th><th colspan="3">贡献毛益额（万元）· 30%</th>'+
      '<th rowspan="2">'+rt+'</th>'+
      '<th colspan="2">切块基数（元）</th><th rowspan="2">'+al+'</th><th rowspan="2">基础月奖计提累计（元）</th></tr>'+
    '<tr><th>'+hd+'</th><th>'+ac+'</th><th>比例</th><th>'+hd+'</th><th>'+ac+'</th><th>比例</th><th>'+hd+'</th><th>'+ac+'</th><th>比例</th>'+
      '<th>钻井队</th><th>机关</th></tr></thead><tbody>'+
    M.rows.map(o=>line(o,false)).join('')+line(M.co,true)+'</tbody>';

  const ms=$('#mktMonth'); if(ms) ms.hidden=!isMonth;
  const avg=M.rows.reduce((t,o)=>t+o.rate,0)/3;
  $('#mktNote').innerHTML = isMonth
    ? '月度指标 = 年度指标 ÷ 12；基础月奖计提累计仍为年累数，按第八条执行。'
    : (isYear
      ? '年累切块额 = 切块基数 × 完成率；公司合计按<strong>汇总口径</strong> '+pct(M.co.rate,2)+'（三市场平均为 '+pct(avg,2)+'）。'
      : '进度指标 = 年度指标 × 已填报月数 ÷ 12（当前 '+M.co.fm+' 个月）。');
}

/* ---------- 切块使用与节余 / 实发构成 ---------- */
function renderSurplus(M){
  const bar=v=>'<span class="bar" style="width:54px;display:inline-flex;vertical-align:middle;margin-right:6px"><i style="width:'+
    Math.max(0,Math.min(v*100,100)).toFixed(1)+'%;background:var(--accent)"></i></span>';
  const row=(o,strong)=>'<tr class="'+(strong?'total':'')+'"><td>'+o.n+'</td><td>'+fmt(o.accrued,0)+'</td><td>'+fmt(o.paid,0)+'</td>'+
    '<td class="'+(o.left>0?'neg':'pos')+'">'+fmt(o.left,0)+'</td>'+
    '<td>'+bar(o.accrued?o.paid/o.accrued:0)+pct(o.accrued?o.paid/o.accrued:0,1)+'</td></tr>';
  $('#surplusTbl').innerHTML='<thead><tr><th>主体单位</th><th>过程完成累计</th><th>实发累计</th><th>节余</th><th>兑现率</th></tr></thead><tbody>'+
    M.rows.map(o=>row(o,false)).join('')+row(M.co,true)+'</tbody>';

  const guards=M.rows.filter(o=>o.guardAmt>0);
  $('#surplusNote').innerHTML = guards.length
    ? guards.map(o=>'<div><strong>'+o.n+'</strong>：'+o.guardNote+'，保底应发 ≥ '+fmt(o.guardAmt,0)+' 元（请核对实发是否达此额度）</div>').join('')
    : '<span class="dim">基础月奖保底规则：发放率不足 50% 时，若该主体单位钻机利用率高于渤海钻探平均利用率，按 50% 进度发放（钻机利用率在「数据填报 › 年度参数」中录入）。当前各单位均未触发。</span>';

  const pr=(o,strong)=>'<tr class="'+(strong?'total':'')+'"><td>'+o.n+'</td><td>'+fmt(o.baseAcc,0)+'</td><td>'+fmt(o.other,0)+'</td>'+
    '<td>'+fmt(o.pay.baseTeam+o.pay.baseHq,0)+'</td><td>'+fmt(o.pay.safeTeam+o.pay.safeHq,0)+'</td>'+
    '<td><strong>'+fmt(o.paid,0)+'</strong></td></tr>';
  $('#payTbl').innerHTML='<thead><tr><th>主体单位</th><th>计提·基础月奖</th><th>计提·安效与专项</th><th>实发·基础月奖</th><th>实发·安效奖</th><th>实发合计</th></tr></thead><tbody>'+
    M.rows.map(o=>pr(o,false)).join('')+pr(M.co,true)+'</tbody>';
}

const KPI_UNIT='<span style="font-size:.5em;font-weight:500;color:var(--muted);margin-left:.2em;letter-spacing:0">万元</span>';
function renderDashKpi(M){
  $('#dashKpi').innerHTML=[
    ['公司过程指标完成率', pct(M.co.rate,2), '大港 '+pct(M.rows[0].rate,2)+' · 长庆 '+pct(M.rows[2].rate,2)+' · 西北 '+pct(M.rows[1].rate,2)],
    ['基础月奖年累切块额', fmt(M.co.alloc/10000,1)+KPI_UNIT, '切块基数 '+fmt((M.co.base+M.co.hqBase)/10000,0)+' 万元 · 计提率 '+pct((M.co.base+M.co.hqBase)?M.co.alloc/(M.co.base+M.co.hqBase):0,1)],
    ['奖金实发年累', fmt(M.co.paid/10000,1)+KPI_UNIT, '全口径应计提 '+fmt(M.co.accrued/10000,1)+' 万元 · 兑现率 '+pct(M.co.accrued?M.co.paid/M.co.accrued:0,1)],
    ['切块节余', fmt(M.co.left/10000,1)+KPI_UNIT, '已填报 '+M.co.fm+' / 12 月 · 第十二条纳入公司管理']
  ].map(x=>'<div class="kpi"><div class="k">'+x[0]+'</div><div class="v">'+x[1]+'</div><div class="d">'+x[2]+'</div></div>').join('');
}

function renderDash(){ refreshAll(); }

/* ============================ 定额库 ============================ */
/* ============================ 定额库版本管理 ============================ */
/* 版本号 V x.y；初始 V1.0。每次「保存版本」或滚动定额应用自动递增存档，
   历史版本可随时恢复（覆盖当前 blocks，恢复前有确认）。 */
function ensureQuotaVersion(){
  if(!Array.isArray(Q.versions)) Q.versions=[];
  if(!Q.version){
    Q.version='V1.0';
    Q.versions.unshift({ver:'V1.0', at:Date.now(), note:'初始版本：附件1 2026年8月定额基线', blocks:JSON.parse(JSON.stringify(Q.blocks))});
    saveQuota();
  }else if(!/^V\d+\.\d+$/.test(Q.version)){
    const legacy=Q.version; Q.version='V1.0';
    Q.versions.unshift({ver:'V1.0', at:Date.now(), note:'初始版本（原版本号「'+legacy+'」并入）', blocks:JSON.parse(JSON.stringify(Q.blocks))});
    saveQuota();
  }else if(!Q.versions.length){
    Q.versions.push({ver:Q.version, at:Date.now(), note:'初始版本', blocks:JSON.parse(JSON.stringify(Q.blocks))});
    saveQuota();
  }
}
function nextQuotaVersion(){
  const m=String(Q.version||'V1.0').match(/^V(\d+)\.(\d+)$/);
  if(!m) return 'V1.1';
  return m[2]==='9' ? 'V'+(+m[1]+1)+'.0' : 'V'+m[1]+'.'+(+m[2]+1);
}
function saveQuotaVersion(){
  ensureQuotaVersion();
  const nv=nextQuotaVersion();
  const note=(window.prompt('保存为新版本 '+nv+'，填写版本备注（可留空）：','')||'').trim();
  Q.versions.push({ver:nv, at:Date.now(), note:note||'手动保存', blocks:JSON.parse(JSON.stringify(Q.blocks))});
  Q.version=nv;
  saveQuota(); renderQuota(); renderResults();
}
function loadQuotaVersion(ver){
  const v=Q.versions.find(x=>x.ver===ver); if(!v) return;
  if(!window.confirm('将当前定额库（'+Q.version+'）替换为历史版本「'+ver+'」的内容（'+v.note+'）？当前未保存的手动修改会丢失。')) return;
  Q.blocks=JSON.parse(JSON.stringify(v.blocks));
  Q.version=ver;
  saveQuota(); renderQuota(); renderResults();
}
function renderQuotaVer(){
  const e=$('#quotaVer'); if(!e) return;
  const n=Q.blocks.length;
  e.textContent='版本 '+Q.version+' · '+n+' 条定额';
  const sel=$('#quotaVerSel'), ld=$('#quotaLoadVer');
  if(sel){
    const cur=sel.value;
    sel.innerHTML='<option value="">历史版本…</option>'+
      Q.versions.slice().reverse().map(x=>'<option value="'+x.ver+'">'+x.ver+' · '+stamp(x.at).slice(0,10)+(x.note?' · '+x.note:'')+'</option>').join('');
    sel.value=(cur && [...sel.options].some(o=>o.value===cur)) ? cur : '';
    if(ld) ld.disabled=!sel.value;
  }
}
let qTab='米费';
function renderQuota(){
  ensureQuotaVersion();
  const qv=$('#quotaVer');
  if(qv && !qv.dataset.done){
    qv.dataset.done='1';
    const sb=$('#quotaSaveVer'), ld=$('#quotaLoadVer'), sel=$('#quotaVerSel');
    if(sb) sb.onclick=saveQuotaVersion;
    if(ld) ld.onclick=()=>{ const v=sel&&sel.value; if(v) loadQuotaVersion(v); };
    if(sel) sel.onchange=e=>{ if(ld) ld.disabled=!e.target.value; };
  }
  renderQuotaVer();
  const kw=($('#qSearch').value||'').trim();
  const seg=$('#qSeg');
  if(!seg.dataset.done){
    seg.dataset.done='1';
    ['米费','材料','能耗','润滑油/项修','水费','毛益率','工序','钻机系数'].forEach(t=>{
      const b=el('button',null,t); b.onclick=()=>{qTab=t;renderQuota();}; seg.appendChild(b);
    });
  }
  [...seg.children].forEach(b=>b.setAttribute('aria-pressed', b.textContent===qTab));

  // 定额缺口
  const gaps=Q.blocks.filter(b=>!b.mifei||!b.energy||!b.dayfoot);
  $('#gapTbl').innerHTML=`<thead><tr><th>井型 · 区块 · 开次</th><th>米费</th><th>能耗</th><th>日进尺</th><th>毛益率</th></tr></thead><tbody>`+
    gaps.slice(0,10).map(b=>`<tr><td>${b.wellType} · ${b.block} · ${b.phase}开</td>
      <td>${b.mifei?'<span class="pos">✓</span>':'<span class="neg">缺</span>'}</td>
      <td>${b.energy?'<span class="pos">✓</span>':'<span class="neg">缺</span>'}</td>
      <td>${b.dayfoot?'<span class="pos">✓</span>':'<span class="neg">缺</span>'}</td>
      <td>${b.gm_avg!=null?'<span class="pos">✓</span>':'<span class="neg">缺</span>'}</td></tr>`).join('')+
    `<tr class="total"><td>缺口组合</td><td colspan="4">${gaps.length} / ${Q.blocks.length}</td></tr></tbody>`;

  renderOneWellOnePolicy();

  const T=$('#quotaTbl');
  if(qTab==='工序'){
    T.innerHTML=`<thead><tr><th>工序</th><th>单位</th><th>定额</th><th>备注</th></tr></thead><tbody>`+
      Q.process.map(p=>`<tr><td>${p.name}</td><td class="dim">${p.unit}</td><td>${fmt(p.rate,2)}</td><td class="sub" style="text-align:left">${p.note||'—'}</td></tr>`).join('')+
      Q.geomembrane.map(g=>`<tr><td>土工膜 · ${g.proc}</td><td class="dim">元/口井</td><td>${fmt(g.rate,2)}</td><td class="sub" style="text-align:left">${g.rig}</td></tr>`).join('')+'</tbody>';
    return;
  }
  if(qTab==='钻机系数'){
    T.innerHTML=`<thead><tr><th>队号</th><th>钻机类型</th><th>机型系数</th><th>维修系数</th><th>影响</th></tr></thead><tbody>`+
      Q.rigs.map(r=>`<tr><td>${r.team}</td><td class="dim">${r.rigType}</td><td>${r.kType.toFixed(6)}</td><td>${r.kRepair.toFixed(2)}</td><td class="sub" style="text-align:left">润滑油定额 × 机型系数；项修定额 × 维修系数</td></tr>`).join('')+'</tbody>';
    return;
  }
  const cols = {
    '米费':[['米定额（元/米·人）','mifei',6]],
    '材料':[['50型（元/米）','mat50',2],['70型（元/米）','mat70',2]],
    '能耗':[['网电米定额（元/米）','energy',2]],
    '润滑油/项修':[['润滑油（元/米）','lube',4],['项修（元/米）','repair',4]],
    '水费':[['生产水（元/米）','prodwater',4],['生活污水（元/米）','sewage',4]],
    '毛益率':[['平均指标','gm_avg',4],['110% 指标','gm_110',4],['120% 指标','gm_120',4]]
  }[qTab];
  const rows=Q.blocks.filter(b=>!kw || (b.block+b.wellType).includes(kw));
  T.innerHTML=`<thead><tr><th>井型</th><th>区块</th><th>开次</th>`+cols.map(c=>`<th>${c[0]}</th>`).join('')+`<th>平均日进尺</th></tr></thead><tbody>`+
    rows.map(b=>{
      const cell=c=>{
        if(b[c[1]]==null) return '<td><span class="neg">缺</span></td>';
        const v = c[1].startsWith('gm') ? pct(b[c[1]],2) : b[c[1]].toFixed(c[2]);
        const d = b._d && b._d[c[1]];
        return `<td>${v}${d!=null?` <span class="sub ${d<0?'neg':'pos'}">${d>0?'▲':'▼'}${Math.abs(d*100).toFixed(1)}%</span>`:''}</td>`;
      };
      return `<tr><td>${b.wellType}</td><td>${b.block}</td><td>${b.phase}</td>`+cols.map(cell).join('')+
        `<td class="dim">${b.dayfoot?b.dayfoot.toFixed(1):'—'}</td></tr>`;
    }).join('')+
    `<tr class="total"><td colspan="${3+cols.length+1}" style="text-align:left">共 ${rows.length} 条 · 定额版本 <strong>${Q.version||'V1.0'}</strong> · 缺失项须按「条件相近、相邻区块」临时套用并经考核办公室确认</td></tr></tbody>`;
}

/* ============================ 班子绩效 ============================ */
const TEAMS=[
  {t:'70318',rev:9860,foot:31200,cost:186,gm:1720,acc:0,kick:0,gmRank:1,party:14.2,util:0.93},
  {t:'70520',rev:8420,foot:27600,cost:142,gm:1385,acc:0,kick:1,gmRank:3,party:13.5,util:0.88},
  {t:'70111',rev:7180,foot:29400,cost:98, gm:1104,acc:1,kick:0,gmRank:2,party:14.8,util:0.91},
  {t:'70152',rev:6640,foot:24800,cost:121,gm:962, acc:0,kick:0,gmRank:5,party:12.9,util:0.84},
  {t:'50639',rev:5920,foot:22100,cost:88, gm:806, acc:0,kick:1,gmRank:6,party:13.1,util:0.79},
  {t:'70315',rev:5210,foot:19500,cost:64, gm:642, acc:1,kick:0,gmRank:8,party:12.4,util:0.72}
];
function renderTeam(){
  const mx=k=>Math.max(...TEAMS.map(t=>t[k]));
  const rankBonus={1:10,2:6,3:3};
  const scored=TEAMS.map(t=>{
    const s1=t.rev/mx('rev')*25, s2=t.foot/mx('foot')*15, s3=t.cost/mx('cost')*15, s4=t.gm/mx('gm')*30;
    const ded=t.acc*6+t.kick*3;
    const bonus=rankBonus[t.gmRank]||0;
    const biz=Math.max(0,s1+s2+s3+s4-ded+bonus);
    const total=biz*0.85/85*85 + t.party; // 经营类85分 + 党建15分
    return {...t,s1,s2,s3,s4,ded,bonus,biz,total:Math.min(biz,85)*1+t.party};
  }).sort((a,b)=>b.total-a.total);
  const base=+$('#teamBase').value||0;
  const n=scored.length;
  scored.forEach((t,i)=>{ t.ratio = n>1 ? 1 - 0.5*(i/(n-1)) : 1; t.pay = base*t.ratio*t.util; });

  $('#teamTbl').innerHTML=`<thead><tr><th>名次</th><th>队号</th><th>市场创收 25</th><th>进尺 15</th><th>成本 15</th><th>毛益额 30</th><th>安全/井控</th><th>毛益排名</th><th>党建 15</th><th>总分</th><th>差额系数</th><th>有效利用率</th><th>队长兑现</th></tr></thead><tbody>`+
    scored.map((t,i)=>`<tr><td style="font-family:var(--mono)">${i+1}</td><td>${t.t}</td>
      <td>${t.s1.toFixed(1)}</td><td>${t.s2.toFixed(1)}</td><td>${t.s3.toFixed(1)}</td><td>${t.s4.toFixed(1)}</td>
      <td class="${t.ded?'neg':'dim'}">${t.ded?'-'+t.ded:'0'}</td><td class="${t.bonus?'pos':'dim'}">${t.bonus?'+'+t.bonus:'0'}</td>
      <td>${t.party.toFixed(1)}</td><td><strong>${t.total.toFixed(1)}</strong></td>
      <td>${pct(t.ratio,0)}</td><td class="dim">${pct(t.util,0)}</td><td><strong>${fmt(t.pay)}</strong></td></tr>`).join('')+
    `<tr class="total"><td colspan="12" style="text-align:left">合计兑现</td><td>${fmt(scored.reduce((s,t)=>s+t.pay,0))}</td></tr></tbody>`;

  const top=scored[0];
  const posts=[['队长',1],['党支部书记',.8],['第一技术员',.8],['第二技术员',.6],['副队长',.5],['其他技术员',.3],['新聘任技术员（不满一年）',.2],['大班 / 电气师（15~30%）',.3]];
  $('#postTbl').innerHTML=`<thead><tr><th>岗位</th><th>系数</th><th>兑现金额（元）</th></tr></thead><tbody>`+
    posts.map(p=>`<tr><td>${p[0]}</td><td>${pct(p[1],0)}</td><td>${fmt(top.pay*p[1])}</td></tr>`).join('')+'</tbody>';
}

/* ============================ 机制优化 ============================ */
const ROAD=[
  {n:'01',t:'难度系数从"下达"改为"算出来"',now:'附件2 规定由考核办公室根据施工井实际情况逐井下达难度系数，标准未量化，同类井可能拿到不同系数。',
   plan:'把水平段、位移、水垂比、技套下深、重点探井五个条件写成加点规则，由井身结构数据自动算出建议系数；人工只能在建议值基础上做例外调整，且必须填写理由并留痕。',
   val:'消除单井考核里权重最大的一个主观变量——它同时乘在米费绩效和材料、能耗定额上。'},
  {n:'02',t:'字段级数据溯源与可信度评分',now:'进尺、周期、材料消耗、事故费用主要靠各队填报，考核办公室难以逐项复核。',
   plan:'每个字段固定两种来源之一：系统直采、人工录入。人工录入项在界面上标黄，并计入单井"可信度评分"，评分低于阈值的井不得进入兑现流程。',
   val:'把审核对象从"申报数字"换成"可追溯来源"，关键字段须附原始材料依据，争议可回溯到具体文件的具体一句话。'},
  {n:'03',t:'成本量价分离全覆盖',now:'仅机油、柴油、电、生活污水四项做了量价分离，其余按金额申报，价格波动与用量节超混在一起。',
   plan:'一般材料、生产水、项修同样拆成"量 × 系统价"，价格由物资/财务系统统一维护，钻井队只对"量"负责。',
   val:'钻井队考核的是自己能控制的消耗量，价格波动不再吃掉或虚增成本绩效。'},
  {n:'04',t:'预考核与归真考核双轨账',now:'单井毛益专项已明确"预考核 + 数据归真后二次考核"，但其余项目只有一次性兑现，后期数据变化无处调整。',
   plan:'所有考核项都建预考核账与归真账两套记录，归真差额自动生成下月调整单，年度封账时汇总清算。',
   val:'月度兑现不必等财务归集，同时保留纠错通道，避免"发了就改不了"。'},
  {n:'05',t:'切块封顶实时可见',now:'办法规定单井兑现总额超过切块总额时按比例下浮，但下浮系数要到期末才知道，各队在过程中无预期。',
   plan:'切块池实时结算：每锁定一口井即刷新已用额度与预测下浮系数，队伍在完井时就能看到自己的兑现区间。',
   val:'把"事后打折"变成"事中可见"，减少兑现阶段的反复解释。'},
  {n:'06',t:'滚动定额与棘轮效应缓释',now:'定额依据 2024-2025 历史水平一次性测定，全年不动。提速降本越快，定额与实际水平脱节越大；到了换版年份又要一次性大幅收紧，队伍收入出现断崖。',
   plan:'每月完成井剔除异常样本后自动入库，按滚动窗口重算区块定额与专项指标。三道缓释阀防止负向激励：单期变动上限、平滑系数 α（新数据不全额生效）、提速让利系数 β（日进尺提升带来的米费收益按比例留给队伍）。先进性系数作为主动加压项单列，由考核委员会显性决策，不藏在算法里。',
   val:'定额始终贴住最近的真实施工水平，同时把"干得越好定额越紧"这件事从暗规则变成三个可谈判的参数。'},
  {n:'07',t:'定额空白自动补位与留痕',now:'附件1 中有相当比例的「井型—区块—开次」组合定额为空，新区块只能事后协商套用。',
   plan:'系统按井深结构、地层与相邻区块相似度自动推荐可套用的定额来源并给出差异说明，套用记录进入考核档案，年末统一回补正式定额。',
   val:'新区块开钻当天就有考核标准，避免"先干后议"造成的口径分歧。'}
];
$('#roadGrid').innerHTML=ROAD.map(r=>`<div class="card"><div class="body opt">
  <h4><span class="n">${r.n}</span>${r.t}</h4>
